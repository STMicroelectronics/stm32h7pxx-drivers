{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:SD",
  "grammarVersion": "3.8",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/sd_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Use labels to create easy-to-read function aliases, such as '<label>_init', '<label>_deinit', and '<label>_gethandle', for use in your application code.",
              "items": {
                "type": "string",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ],
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Software layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_SD_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            },
            "function_type": {
              "type": "string",
              "title": "Function used by the component",
              "description": "Indicates how this SD component instance is used in the project.",
              "readOnly": true,
              "default": "SD"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "clock_config": {
              "type": "object",
              "description": "",
              "title": "Clock",
              "properties": {
                "clk_edge": {
                  "title": "Edge",
                  "type": "boolean",
                  "description": "Specifies the clock signal edge on which an event or action is triggered.",
                  "default": false,
                  "oneOf": [
                    {
                      "title": "Falling",
                      "const": false
                    },
                    {
                      "title": "Rising",
                      "const": true
                    }
                  ]
                },
                "clk_power_save": {
                  "title": "Power save",
                  "type": "boolean",
                  "description": "If the box is checked, the SD Clock Power Save will be enabled.",
                  "default": false
                },
                "auto_detection_frequency": {
                  "title": "SD card transfer frequency",
                  "type": "object",
                  "properties": {
                    "input_clock_source": {
                      "type": "integer",
                      "unit": "Hz",
                      "title": "Input clock source",
                      "actions": [
                        {
                          "type": "disable",
                          "message": "This value is automatically taken from the SDMMC kernel clock and cannot be edited.",
                          "condition": "true"
                        },
                        {
                          "type": "set",
                          "condition": "true",
                          "computed": {
                            "const": "$get('clock.frequency', $resource.id)"
                          }
                        }
                      ],
                      "default": 0
                    },
                    "detection_frequency": {
                      "title": "Auto detect",
                      "description": "When enabled, the target frequency is computed automatically and the target frequency field is read-only.",
                      "type": "boolean",
                      "synchronize": true,
                      "synchronizeOn": {
                        "path": "detection_frequency",
                        "component": "HAL-SD"
                      },
                      "variables": [
                        {
                          "on": "update-value",
                          "name": "SD_AUTO_DETECTION_FREQUENCY",
                          "semaphore": true,
                          "condition": "$basic.clock_config.auto_detection_frequency.detection_frequency === true"
                        }
                      ],
                      "default": true
                    },
                    "clock_frequency": {
                      "title": "Target frequency",
                      "description": "Maximum clock frequency is: \n- For UHS-I SD Card: 100 MHz. \n- For HS SD Card: 50 MHz. \n- For Normal speed SD Card: 25 MHz.",
                      "unit": "Hz",
                      "type": "integer",
                      "default": 400000,
                      "min": 400000,
                      "actions": [
                        {
                          "type": "disable",
                          "message": "This field is disabled when auto detect is enabled.",
                          "condition": "$basic.clock_config.auto_detection_frequency.detection_frequency"
                        }
                      ]
                    },
                    "expected_output_clock_frequency": {
                      "title": "Achievable frequency",
                      "unit": "Hz",
                      "type": "integer",
                      "description": "This parameter defines the output clock frequency (in Hz) derived from the input clock source (sdmmc_ker_ck).",
                      "default": 0,
                      "actions": [
                        {
                          "type": "disable",
                          "message": "This achievable frequency is computed automatically and cannot be edited.",
                          "condition": "true"
                        },
                        {
                          "type": "set",
                          "condition": "true",
                          "computed": {
                            "const": "$common.helper_sd_compute_frequency($basic.clock_config.auto_detection_frequency.input_clock_source, $basic.clock_config.auto_detection_frequency.clock_frequency)"
                          }
                        }
                      ]
                    },
                    "ratio": {
                      "title": "Error between target and achievable frequency",
                      "type": "string",
                      "default": "",
                      "actions": [
                        {
                          "type": "disable",
                          "message": "This error ratio is computed automatically and cannot be edited.",
                          "condition": "true"
                        },
                        {
                          "type": "set",
                          "condition": "true",
                          "computed": {
                            "const": "($basic.clock_config.auto_detection_frequency.clock_frequency === $basic.clock_config.auto_detection_frequency.expected_output_clock_frequency) ? '0 %' : (((($basic.clock_config.auto_detection_frequency.clock_frequency - $basic.clock_config.auto_detection_frequency.expected_output_clock_frequency) / $basic.clock_config.auto_detection_frequency.clock_frequency) * 100).toFixed(2) + ' %')"
                          }
                        },
                        {
                          "type": "exclude",
                          "condition": "$basic.clock_config.auto_detection_frequency.detection_frequency"
                        }
                      ]
                    }
                  }
                }
              }
            },
            "bus_wide": {
              "type": "integer",
              "title": "Bus width",
              "description": "Defines the width of the bus in bits.",
              "default": 1,
              "oneOf": [
                {
                  "title": "1-bit",
                  "const": 1
                },
                {
                  "title": "4-bit",
                  "const": 0
                }
              ]
            },
            "hw_flow_ctrl": {
              "title": "Hardware flow control",
              "type": "boolean",
              "default": false
            },
            "transceiver": {
              "title": "Transceiver",
              "type": "boolean",
              "default": false
            },
            "default_timeout": {
              "title": "Default timeout values",
              "description": "When enabling the default timeout value,  the system will use the default timeout values according to the SD card specification. This ensures compatibility and optimal performance with standard SD card operations.",
              "type": "boolean",
              "default": true
            },
            "timeout_config": {
              "title": "Timeout",
              "type": "object",
              "actions": [
                {
                  "type": "disable",
                  "message": "Timeout configuration is disabled when default timeout values are enabled.",
                  "condition": "$basic.default_timeout"
                }
              ],
              "properties": {
                "data_timeout_cycle": {
                  "title": "Data timeout cycle",
                  "type": "integer",
                  "minimum": 0,
                  "default": 4294967295
                },
                "stop_xfer_timeout_ms": {
                  "title": "Stop transfer timeout",
                  "type": "integer",
                  "minimum": 0,
                  "unit": "ms",
                  "default": 500
                },
                "erase_timeout_ms": {
                  "title": "Erase timeout",
                  "type": "integer",
                  "minimum": 0,
                  "unit": "ms",
                  "default": 63000
                }
              }
            }
          }
        },
        "additional": {
          "type": "object",
          "title": "Advanced features",
          "properties": {
            "use_delay_block": {
              "title": "Use delay block",
              "type": "boolean",
              "default": false
            },
            "delay_block": {
              "title": "Delay block",
              "type": "object",
              "actions": [
                {
                  "type": "enable",
                  "message": "Delay block settings are enabled when delay block usage is selected.",
                  "condition": "$additional.use_delay_block"
                }
              ],
              "properties": {
                "calculate_max_output_clock_phase": {
                  "title": "Auto-calculate clock phase",
                  "type": "boolean",
                  "default": true,
                  "description": "Automatically calculate the clock phase for the delay block.",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$resource.peripheralVersionNum >= 3.0"
                    }
                  ]
                },
                "clock_phase": {
                  "title": "Clock phase value",
                  "type": "integer",
                  "default": 0,
                  "actions": [
                    {
                      "type": "enable",
                      "message": "Clock phase value can be edited when automatic clock phase calculation is disabled.",
                      "condition": "($additional.delay_block.calculate_max_output_clock_phase === undefined) || ($additional.delay_block.calculate_max_output_clock_phase === false)"
                    }
                  ]
                }
              }
            },
            "threshold": {
              "type": "integer",
              "title": "FIFO threshold size",
              "default": 0,
              "oneOf": [
                {
                  "title": "None",
                  "const": 0
                },
                {
                  "title": "1",
                  "const": 1
                },
                {
                  "title": "2",
                  "const": 2
                },
                {
                  "title": "4",
                  "const": 4
                },
                {
                  "title": "8",
                  "const": 8
                },
                {
                  "title": "16",
                  "const": 16
                },
                {
                  "title": "32",
                  "const": 32
                },
                {
                  "title": "64",
                  "const": 64
                },
                {
                  "title": "128",
                  "const": 128
                },
                {
                  "title": "256",
                  "const": 256
                },
                {
                  "title": "512",
                  "const": 512
                },
                {
                  "title": "1024",
                  "const": 1024
                },
                {
                  "title": "2048",
                  "const": 2048
                },
                {
                  "title": "4096",
                  "const": 4096
                },
                {
                  "title": "8192",
                  "const": 8192
                },
                {
                  "title": "16384",
                  "const": 16384
                }
              ],
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$resource.peripheralVersionNum < 3.0"
                }
              ]
            }
          }
        },
        "security_privilege": {
          "title": "Security and privilege",
          "#comment": "Use for instance for SD",
          "description": "Manage security and privileged access levels attributes.",
          "type": "object",
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.getCurrentEngine') === null) || ($get('swproject.getCurrentEngine').secure === 'TZ-disabled')"
            },
            {
              "type": "set",
              "condition": "$get('swproject.getCurrentEngine').secure === 'Non-secure'",
              "attributes": {
                "title": "Privileged",
                "description": "Manage privileged access levels attributes."
              }
            }
          ],
          "properties": {
            "configuration_access_level": {
              "title": "Access level",
              "description": "Manage security and privileged access levels attributes.",
              "type": "object",
              "properties": {
                "security": {
                  "type": "string",
                  "title": "Security attribute",
                  "description": "Set the security attribute of the securable peripheral.",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                    },
                    {
                      "type": "set",
                      "attributes": {
                        "const": "SEC"
                      },
                      "condition": "$get('peripheral.isBound', $resource.id)"
                    },
                    {
                      "type": "set",
                      "attributes": {
                        "const": "NSEC"
                      },
                      "condition": "!$get('peripheral.isBound', $resource.id)"
                    },
                    {
                      "type": "disable",
                      "condition": "$get('peripheral.isBound', $resource.id)",
                      "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                    }
                  ],
                  "synchronize": true,
                  "synchronizeOn": {
                    "component": "ST-HAL",
                    "path": "rif-risc-peripheral-sec-attr",
                    "custom": "$resource.id"
                  },
                  "oneOf": [
                    {
                      "title": "Secure",
                      "const": "SEC"
                    },
                    {
                      "title": "Non-secure",
                      "const": "NSEC"
                    }
                  ],
                  "default": "NSEC"
                },
                "privilege": {
                  "type": "string",
                  "title": "Privileged attribute",
                  "description": "Set the privileged attribute of a securable RISC peripheral.",
                  "synchronize": true,
                  "synchronizeOn": {
                    "component": "ST-HAL",
                    "path": "rif-risc-peripheral-priv-attr",
                    "custom": "$resource.id"
                  },
                  "oneOf": [
                    {
                      "title": "Privileged",
                      "const": "PRIV"
                    },
                    {
                      "title": "Unprivileged",
                      "const": "NPRIV"
                    }
                  ],
                  "default": "PRIV"
                },
                "lock": {
                  "type": "boolean",
                  "title": "Lock",
                  "description": "Optional. Lock security and privilege attributes to prevent changes.",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                    }
                  ],
                  "synchronize": true,
                  "synchronizeOn": {
                    "component": "ST-HAL",
                    "path": "rif-risc-peripheral-lock-attr",
                    "custom": "$resource.id"
                  },
                  "default": false
                }
              }
            },
            "transaction_access_level": {
              "title": "Transaction access level",
              "description": "Manage security and privileged transaction access levels attributes.",
              "type": "object",
              "properties": {
                "security": {
                  "type": "string",
                  "title": "Security attribute",
                  "description": "Set the security attribute of the securable peripheral.",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                    },
                    {
                      "type": "set",
                      "attributes": {
                        "const": "SEC"
                      },
                      "condition": "$get('peripheral.isBound', $resource.id)"
                    },
                    {
                      "type": "set",
                      "attributes": {
                        "const": "NSEC"
                      },
                      "condition": "!$get('peripheral.isBound', $resource.id)"
                    },
                    {
                      "type": "disable",
                      "condition": "$get('peripheral.isBound', $resource.id)",
                      "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                    }
                  ],
                  "synchronize": true,
                  "synchronizeOn": {
                    "component": "ST-HAL",
                    "path": "rif-rimc-peripheral-sec-attr",
                    "custom": "$resource.id"
                  },
                  "oneOf": [
                    {
                      "title": "Secure",
                      "const": "SEC"
                    },
                    {
                      "title": "Non-secure",
                      "const": "NSEC"
                    }
                  ],
                  "default": "NSEC"
                },
                "privilege": {
                  "type": "string",
                  "title": "Privileged attribute",
                  "description": "Set the privileged attribute of a securable RISC peripheral.",
                  "synchronize": true,
                  "synchronizeOn": {
                    "component": "ST-HAL",
                    "path": "rif-rimc-peripheral-priv-attr",
                    "custom": "$resource.id"
                  },
                  "oneOf": [
                    {
                      "title": "Privileged",
                      "const": "PRIV"
                    },
                    {
                      "title": "Unprivileged",
                      "const": "NPRIV"
                    }
                  ],
                  "default": "PRIV"
                }
              }
            },
            "illegal_access": {
              "type": "boolean",
              "title": "Illegal access interrupt",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure-only')",
                  "message": "Illegal access interrupt is disabled in Secure-only mode."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-iac-peripheral",
                "custom": "$resource.id"
              },
              "default": false
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "description": "Manage the SD pins and interrupt options used by this peripheral.",
          "properties": {
            "gpio": {
              "type": "object",
              "title": "GPIO",
              "properties": {
                "gpio_ck": {
                  "type": "object",
                  "title": "SD CK",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "actions": [
                    {
                      "type": "error",
                      "message": "SD CK cannot be mapped to any compatible pin on this device or current pinout.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'CK')"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "CK",
                      "constraints": {
                        "pull": {
                          "allow": [
                            "UP",
                            "NO"
                          ]
                        },
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                },
                "gpio_cmd": {
                  "type": "object",
                  "title": "SD CMD",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "actions": [
                    {
                      "type": "error",
                      "message": "SD CMD cannot be mapped to any compatible pin on this device or current pinout.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'CMD')"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "CMD",
                      "constraints": {
                        "pull": {
                          "allow": [
                            "UP",
                            "NO"
                          ]
                        },
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                },
                "gpio_d0": {
                  "type": "object",
                  "title": "SD D0",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "actions": [
                    {
                      "type": "error",
                      "message": "SD D0 cannot be mapped to any compatible pin on this device or current pinout.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'D0')"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "D0",
                      "constraints": {
                        "pull": {
                          "allow": [
                            "UP",
                            "NO"
                          ]
                        },
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                },
                "gpio_d1": {
                  "type": "object",
                  "title": "SD D1",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$basic.bus_wide == 1"
                    },
                    {
                      "type": "error",
                      "message": "SD D1 cannot be mapped to any compatible pin on this device or current pinout.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'D1')"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "D1",
                      "constraints": {
                        "pull": {
                          "allow": [
                            "UP",
                            "NO"
                          ]
                        },
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                },
                "gpio_d2": {
                  "type": "object",
                  "title": "SD D2",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$basic.bus_wide == 1"
                    },
                    {
                      "type": "error",
                      "message": "SD D2 cannot be mapped to any compatible pin on this device or current pinout.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'D2')"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "D2",
                      "constraints": {
                        "pull": {
                          "allow": [
                            "UP",
                            "NO"
                          ]
                        },
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                },
                "gpio_d3": {
                  "type": "object",
                  "title": "SD D3",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$basic.bus_wide == 1"
                    },
                    {
                      "type": "error",
                      "message": "SD D3 cannot be mapped to any compatible pin on this device or current pinout.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'D3')"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "D3",
                      "constraints": {
                        "pull": {
                          "allow": [
                            "UP",
                            "NO"
                          ]
                        },
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "nvic": {
              "type": "object",
              "title": "NVIC",
              "properties": {
                "enable_interruption": {
                  "title": "Interrupt",
                  "type": "boolean",
                  "default": false
                },
                "irq_handler_generation": {
                  "type": "boolean",
                  "title": "IRQ handler generation",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption && $info.layer === 'HAL'"
                    }
                  ]
                },
                "irq_config": {
                  "title": "IRQ line priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}