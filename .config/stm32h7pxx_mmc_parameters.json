{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:MMC",
  "grammarVersion": "3.8",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/mmc_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Use labels to create easy-to-read function aliases, such as '<label>_init', '<label>_deinit', and '<label>_gethandle', for use in your application code.",
              "items": {
                "type": "string",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ],
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Software layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_MMC_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            },
            "function_type": {
              "type": "string",
              "title": "Function used by the component",
              "description": "Indicates how this MMC component instance is used in the project.",
              "readOnly": true,
              "default": "MMC"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "clock_config": {
              "type": "object",
              "title": "Clock",
              "properties": {
                "clk_edge": {
                  "title": "Edge",
                  "type": "boolean",
                  "description": "Determines the clock signal edge that triggers the event.",
                  "default": false,
                  "oneOf": [
                    {
                      "title": "Falling",
                      "const": false
                    },
                    {
                      "title": "Rising",
                      "const": true
                    }
                  ]
                },
                "clk_power_save": {
                  "title": "Power save",
                  "type": "boolean",
                  "description": "If the box is checked, the mmc clock power save will be enabled.",
                  "default": false
                },
                "auto_detection_frequency": {
                  "title": "MMC card transfer frequency",
                  "type": "object",
                  "properties": {
                    "input_clock_source": {
                      "type": "integer",
                      "title": "Input clock source",
                      "unit": "Hz",
                      "actions": [
                        {
                          "type": "disable",
                          "condition": "true",
                          "message": "This value is computed automatically."
                        },
                        {
                          "type": "set",
                          "condition": "true",
                          "computed": {
                            "const": "$get('clock.frequency', $resource.id)"
                          }
                        }
                      ],
                      "default": 0
                    },
                    "detection_frequency": {
                      "title": "Auto-detect",
                      "description": "When enabled, the target frequency is computed automatically and the target frequency field is read-only.",
                      "type": "boolean",
                      "synchronize": true,
                      "synchronizeOn": {
                        "path": "detection_frequency",
                        "component": "HAL-MMC"
                      },
                      "variables": [
                        {
                          "on": "update-value",
                          "name": "MMC_AUTO_DETECTION_FREQUENCY",
                          "semaphore": true,
                          "condition": "$basic.clock_config.auto_detection_frequency.detection_frequency === true"
                        }
                      ],
                      "default": true
                    },
                    "clock_frequency": {
                      "title": "Target frequency",
                      "description": "Maximum clock frequency is: \n- For UHS-I MMC Card: 100 MHz. \n- For HS MMC Card: 50 MHz. \n- For Normal speed MMC Card: 25 MHz.",
                      "unit": "Hz",
                      "type": "integer",
                      "default": 400000,
                      "actions": [
                        {
                          "type": "disable",
                          "condition": "$basic.clock_config.auto_detection_frequency.detection_frequency",
                          "message": "This value is disabled when auto-detect is enabled."
                        }
                      ]
                    },
                    "expected_output_clock_frequency": {
                      "title": "Achievable frequency",
                      "type": "integer",
                      "unit": "Hz",
                      "description": "This parameter defines the output clock frequency (in Hz) derived from the input clock source (sdmmc_ker_ck).",
                      "default": 0,
                      "actions": [
                        {
                          "type": "disable",
                          "condition": "true",
                          "message": "This value is computed automatically."
                        },
                        {
                          "type": "set",
                          "condition": "true",
                          "computed": {
                            "const": "$common.helper_mmc_compute_frequency($basic.clock_config.auto_detection_frequency.input_clock_source, $basic.clock_config.auto_detection_frequency.clock_frequency)"
                          }
                        }
                      ]
                    },
                    "ratio": {
                      "title": "Error between target and achievable frequency",
                      "type": "string",
                      "default": "",
                      "actions": [
                        {
                          "type": "disable",
                          "condition": "true",
                          "message": "This value is computed automatically."
                        },
                        {
                          "type": "set",
                          "condition": "true",
                          "computed": {
                            "const": "($basic.clock_config.auto_detection_frequency.clock_frequency === $basic.clock_config.auto_detection_frequency.expected_output_clock_frequency) ? '0 %' : (((($basic.clock_config.auto_detection_frequency.clock_frequency - $basic.clock_config.auto_detection_frequency.expected_output_clock_frequency) / $basic.clock_config.auto_detection_frequency.clock_frequency) * 100).toFixed(2) + ' %')"
                          }
                        },
                        {
                          "type": "exclude",
                          "condition": "$basic.clock_config.auto_detection_frequency.detection_frequency"
                        }
                      ]
                    }
                  }
                }
              }
            },
            "bus_wide": {
              "type": "integer",
              "title": "Bus width",
              "default": 0,
              "oneOf": [
                {
                  "title": "1-bit",
                  "const": 0
                },
                {
                  "title": "4-bit",
                  "const": 1
                },
                {
                  "title": "8-bit",
                  "const": 2
                }
              ]
            },
            "hw_flow_ctrl": {
              "title": "Hardware flow control",
              "type": "boolean",
              "default": false
            },
            "default_timeout": {
              "title": "Default timeout values",
              "description": "When enabling the default timeout value,  the system will use the default timeout values according to the mmc card specification. This ensures compatibility and optimal performance with standard mmc card operations.",
              "type": "boolean",
              "default": true
            },
            "timeout_config": {
              "title": "Timeout",
              "type": "object",
              "actions": [
                {
                  "type": "disable",
                  "condition": "$basic.default_timeout",
                  "message": "This group is disabled when default timeout values are enabled."
                }
              ],
              "properties": {
                "data_timeout_cycle": {
                  "title": "Data timeout cycle",
                  "type": "integer",
                  "minimum": 0,
                  "default": 4294967295
                },
                "stop_xfer_timeout_ms": {
                  "title": "Stop transfer timeout",
                  "type": "integer",
                  "minimum": 0,
                  "unit": "ms",
                  "default": 500
                },
                "erase_timeout_ms": {
                  "title": "Erase timeout",
                  "type": "integer",
                  "minimum": 0,
                  "unit": "ms",
                  "default": 63000
                }
              }
            }
          }
        },
        "additional": {
          "type": "object",
          "title": "Advanced features",
          "properties": {
            "use_delay_block": {
              "title": "Use delay block",
              "type": "boolean",
              "default": false
            },
            "delay_block": {
              "title": "Delay block",
              "type": "object",
              "actions": [
                {
                  "type": "enable",
                  "condition": "$additional.use_delay_block",
                  "message": "'Use delay block' must be enabled"
                }
              ],
              "properties": {
                "calculate_max_output_clock_phase": {
                  "title": "Auto calculate clock phase",
                  "type": "boolean",
                  "default": true,
                  "description": "When enabling the auto calculate clock phase, we will use a HAL function HAL_MMC_CalculateDlybMaxClockPhase to calculate automatically the clock phase.",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$resource.peripheralVersionNum >= 3.0"
                    }
                  ]
                },
                "clock_phase": {
                  "title": "Clock phase value",
                  "type": "integer",
                  "default": 0,
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "($additional.delay_block.calculate_max_output_clock_phase === undefined) || ($additional.delay_block.calculate_max_output_clock_phase === false)",
                      "message": "Clock phase can be edited only when auto calculation is disabled."
                    }
                  ]
                }
              }
            },
            "threshold": {
              "type": "integer",
              "title": "Fifo threshold size",
              "default": 0,
              "oneOf": [
                {
                  "title": "None",
                  "const": 0
                },
                {
                  "title": "1",
                  "const": 1
                },
                {
                  "title": "2",
                  "const": 2
                },
                {
                  "title": "4",
                  "const": 4
                },
                {
                  "title": "8",
                  "const": 8
                },
                {
                  "title": "16",
                  "const": 16
                },
                {
                  "title": "32",
                  "const": 32
                },
                {
                  "title": "64",
                  "const": 64
                },
                {
                  "title": "128",
                  "const": 128
                },
                {
                  "title": "256",
                  "const": 256
                },
                {
                  "title": "512",
                  "const": 512
                },
                {
                  "title": "1024",
                  "const": 1024
                },
                {
                  "title": "2048",
                  "const": 2048
                },
                {
                  "title": "4096",
                  "const": 4096
                },
                {
                  "title": "8192",
                  "const": 8192
                },
                {
                  "title": "16384",
                  "const": 16384
                }
              ],
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$resource.peripheralVersionNum < 3.0"
                }
              ]
            }
          }
        },
        "security_privilege": {
          "title": "Security and privilege",
          "#comment": "Use for instance for MMC",
          "description": "Manage security and privileged access levels attributes.",
          "type": "object",
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.getCurrentEngine') === null) || ($get('swproject.getCurrentEngine').secure === 'TZ-disabled')"
            },
            {
              "type": "set",
              "condition": "$get('swproject.getCurrentEngine').secure === 'Non-secure'",
              "attributes": {
                "title": "Privileged",
                "description": "Manage privileged access levels attributes."
              }
            }
          ],
          "properties": {
            "configuration_access_level": {
              "title": "Access level",
              "description": "Manage security and privileged access levels attributes.",
              "type": "object",
              "properties": {
                "security": {
                  "type": "string",
                  "title": "Security attribute",
                  "description": "Set the security attribute of the securable peripheral.",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                    },
                    {
                      "type": "set",
                      "attributes": {
                        "const": "SEC"
                      },
                      "condition": "$get('peripheral.isBound', $resource.id)"
                    },
                    {
                      "type": "set",
                      "attributes": {
                        "const": "NSEC"
                      },
                      "condition": "!$get('peripheral.isBound', $resource.id)"
                    },
                    {
                      "type": "disable",
                      "condition": "$get('peripheral.isBound', $resource.id)",
                      "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                    }
                  ],
                  "synchronize": true,
                  "synchronizeOn": {
                    "component": "ST-HAL",
                    "path": "rif-risc-peripheral-sec-attr",
                    "custom": "$resource.id"
                  },
                  "oneOf": [
                    {
                      "title": "Secure",
                      "const": "SEC"
                    },
                    {
                      "title": "Non-secure",
                      "const": "NSEC"
                    }
                  ],
                  "default": "NSEC"
                },
                "privilege": {
                  "type": "string",
                  "title": "Privileged attribute",
                  "description": "Set the privileged attribute of a securable RISC peripheral.",
                  "synchronize": true,
                  "synchronizeOn": {
                    "component": "ST-HAL",
                    "path": "rif-risc-peripheral-priv-attr",
                    "custom": "$resource.id"
                  },
                  "oneOf": [
                    {
                      "title": "Privileged",
                      "const": "PRIV"
                    },
                    {
                      "title": "Unprivileged",
                      "const": "NPRIV"
                    }
                  ],
                  "default": "PRIV"
                },
                "lock": {
                  "type": "boolean",
                  "title": "Lock",
                  "description": "Optional. Lock security and privilege attributes to prevent changes.",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                    }
                  ],
                  "synchronize": true,
                  "synchronizeOn": {
                    "component": "ST-HAL",
                    "path": "rif-risc-peripheral-lock-attr",
                    "custom": "$resource.id"
                  },
                  "default": false
                }
              }
            },
            "transaction_access_level": {
              "title": "Transaction access level",
              "description": "Manage security and privileged transaction access levels attributes.",
              "type": "object",
              "properties": {
                "security": {
                  "type": "string",
                  "title": "Security attribute",
                  "description": "Set the security attribute of the securable peripheral.",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                    },
                    {
                      "type": "set",
                      "attributes": {
                        "const": "SEC"
                      },
                      "condition": "$get('peripheral.isBound', $resource.id)"
                    },
                    {
                      "type": "set",
                      "attributes": {
                        "const": "NSEC"
                      },
                      "condition": "!$get('peripheral.isBound', $resource.id)"
                    },
                    {
                      "type": "disable",
                      "condition": "$get('peripheral.isBound', $resource.id)",
                      "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                    }
                  ],
                  "synchronize": true,
                  "synchronizeOn": {
                    "component": "ST-HAL",
                    "path": "rif-rimc-peripheral-sec-attr",
                    "custom": "$resource.id"
                  },
                  "oneOf": [
                    {
                      "title": "Secure",
                      "const": "SEC"
                    },
                    {
                      "title": "Non-secure",
                      "const": "NSEC"
                    }
                  ],
                  "default": "NSEC"
                },
                "privilege": {
                  "type": "string",
                  "title": "Privileged attribute",
                  "description": "Set the privileged attribute of a securable RISC peripheral.",
                  "synchronize": true,
                  "synchronizeOn": {
                    "component": "ST-HAL",
                    "path": "rif-rimc-peripheral-priv-attr",
                    "custom": "$resource.id"
                  },
                  "oneOf": [
                    {
                      "title": "Privileged",
                      "const": "PRIV"
                    },
                    {
                      "title": "Unprivileged",
                      "const": "NPRIV"
                    }
                  ],
                  "default": "PRIV"
                }
              }
            },
            "illegal_access": {
              "type": "boolean",
              "title": "Illegal access interrupt",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure-only')",
                  "message": "Illegal access interrupt is disabled in Secure-only mode."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-iac-peripheral",
                "custom": "$resource.id"
              },
              "default": false
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "properties": {
            "gpio": {
              "type": "object",
              "title": "GPIO",
              "properties": {
                "gpio_ck": {
                  "type": "object",
                  "title": "MMC CK",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "actions": [
                    {
                      "type": "error",
                      "message": "MMC CK cannot be mapped to any compatible pin on this device or current pinout.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'CK')"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "CK",
                      "constraints": {
                        "pull": {
                          "allow": [
                            "UP",
                            "NO"
                          ]
                        },
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                },
                "gpio_cmd": {
                  "type": "object",
                  "title": "MMC CMD",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "actions": [
                    {
                      "type": "error",
                      "message": "MMC CMD cannot be mapped to any compatible pin on this device or current pinout.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'CMD')"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "CMD",
                      "constraints": {
                        "pull": {
                          "allow": [
                            "UP",
                            "NO"
                          ]
                        },
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                },
                "gpio_d0": {
                  "type": "object",
                  "title": "MMC D0",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "actions": [
                    {
                      "type": "error",
                      "message": "MMC D0 cannot be mapped to any compatible pin on this device or current pinout.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'D0')"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "D0",
                      "constraints": {
                        "pull": {
                          "allow": [
                            "UP",
                            "NO"
                          ]
                        },
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                },
                "gpio_d1": {
                  "type": "object",
                  "title": "MMC D1",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$basic.bus_wide == 0"
                    },
                    {
                      "type": "error",
                      "message": "MMC D1 cannot be mapped to any compatible pin on this device or current pinout.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'D1')"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "D1",
                      "constraints": {
                        "pull": {
                          "allow": [
                            "UP",
                            "NO"
                          ]
                        },
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                },
                "gpio_d2": {
                  "type": "object",
                  "title": "MMC D2",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$basic.bus_wide == 0"
                    },
                    {
                      "type": "error",
                      "message": "MMC D2 cannot be mapped to any compatible pin on this device or current pinout.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'D2')"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "D2",
                      "constraints": {
                        "pull": {
                          "allow": [
                            "UP",
                            "NO"
                          ]
                        },
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                },
                "gpio_d3": {
                  "type": "object",
                  "title": "MMC D3",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "$basic.bus_wide == 0"
                    },
                    {
                      "type": "error",
                      "message": "MMC D3 cannot be mapped to any compatible pin on this device or current pinout.",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'D3')"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "D3",
                      "constraints": {
                        "pull": {
                          "allow": [
                            "UP",
                            "NO"
                          ]
                        },
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ]
                },
                "gpio_d4": {
                  "type": "object",
                  "title": "MMC D4",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
