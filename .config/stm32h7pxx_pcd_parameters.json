{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:PCD",
  "grammarVersion": "3.8",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/usb_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ],
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Software layer",
              "default": "HAL",
              "actions": [
                {
                  "type": "disable",
                  "message": "Only HAL layer is supported for this component",
                  "condition": "true"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_PCD_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            },
            "usb_mode": {
              "type": "string",
              "title": "Mode used by the component",
              "description": "This component is a standard component which can be used HW instance available on another component. The notion of function is used to distinguish the usage of each HW instance.",
              "actions": [
                {
                  "type": "disable",
                  "message": "Only Device mode is supported for this component",
                  "condition": "true"
                }
              ],
              "default": "PCD"
            },
            "pins": {
              "type": "string",
              "title": "Notification about D+/ D- pins",
              "description": "D+ and D− pins for this USB instance are neither alternate nor additional functions. These two signals are directly connected to the internal PHY and are not mapped to GPIOs, therefore they are not exposed for configuration.",
              "actions": [
                {
                  "type": "disable",
                  "message": "notification about D+/D- pins is only relevant for USB OTG HS peripheral",
                  "condition": "true"
                },
                {
                  "type": "exclude",
                  "condition": "($get('pinout.peripheralCanBeMapped', $resource.name, 'DM'))||($get('pinout.peripheralCanBeMapped', $resource.name, 'DP'))"
                }
              ],
              "default": "These pins will not be exposed in GPIOs section"
            }
          }
        },
        "basic": {
          "title": "Main features",
          "type": "object",
          "properties": {
            "core_speed": {
              "type": "string",
              "title": "Core speed",
              "oneOf": [
                {
                  "title": "Full speed",
                  "const": "SPEED_FS"
                },
                {
                  "title": "High speed",
                  "const": "SPEED_HS",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "($resource.name === 'OTG_FS') || ($resource.name === 'USB')"
                    }
                  ]
                },
                {
                  "title": "High speed in full speed",
                  "const": "SPEED_HS_IN_FS",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "($resource.name === 'OTG_FS')||($resource.name === 'USB')"
                    }
                  ]
                }
              ],
              "actions": [
                {
                  "type": "set",
                  "condition": "true",
                  "computed": {
                    "default": "$common.helper_usb_get_speed_by_ip($resource.name)"
                  }
                }
              ]
            },
            "sof_state": {
              "type": "boolean",
              "title": "USB SOF state",
              "default": false
            },
            "vbus_sense_state": {
              "type": "boolean",
              "title": "USB VBUS sensing",
              "default": false,
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$resource.name == 'USB'"
                }
              ]
            },
            "phy_interface": {
              "title": "PHY interface",
              "type": "string",
              "actions": [
                {
                  "type": "set",
                    "computed": {
                      "default": "$common.helper_usb_get_phy_interface_by_ip($resource.name)",
                      "title" : "$common.helper_usb_get_phy_interface_title_by_ip($resource.name)"
                    },
                  "condition": "true"
                },
                {
                  "type": "disable",
                  "message": "PHY interface is automatically set based on the selected IP and cannot be modified.",
                  "condition": "true"
                }
              ]
            },
            "dma_state": {
              "type": "boolean",
              "title": "DMA state",
              "default": false,
              "actions": [
                {
                  "type": "exclude",
                  "condition": "($resource.name == 'OTG_FS')||($resource.name == 'USB')"
                }
              ]
            },
            "usb_fifo_settings": {
              "type": "object",
              "title": "USB FIFO (all sizes will be conditioned by total FIFO size)",
              "properties": {
                "rx_fifo_size": {
                  "type": "integer",
                  "title": "Reception FIFO buffer size",
                  "description": "Reception FIFO buffer is common to all OUT endpoints.",
                  "display_format": [
                    "hex"
                  ],
                  "actions": [
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "default": "$common.helper_usb_get_rx_fifo_size_by_ip($resource.name)",
                        "maximum": "$common.helper_usb_get_rx_fifo_size_by_ip($resource.name)"
                      }
                    }
                  ],
                  "minimum": 1
                },
                "eps_settings": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "title": "Endpoint",
                  "itemTitle": "number",
                  "items": {
                    "type": "object",
                    "properties": {
                      "number": {
                        "type": "integer",
                        "title": "Endpoint number",
                        "maximum": 7,
                        "display_format": [
                          "hex"
                        ],
                        "minimum": 0,
                        "actions": [
                         {
                           "type": "set",
                           "condition": "true",
                           "computed":
                           {
                             "default": "$common.helper_usb_get_fifo_ep_index($basic.usb_fifo_settings.eps_settings, $item)"
                           }
                         }
                        ]
                      },
                      "direction": {
                        "type": "string",
                        "title": "Endpoint direction",
                        "oneOf": [
                          {
                            "title": "IN (from device to host)",
                            "const": "IN"
                          }
                        ],
                        "actions": [
                          {
                            "type": "disable",
                            "condition": "true",
                            "message": "Only IN endpoints are configurable in this section. OUT endpoints are not listed as they all use RX FIFO for data transmission."
                          }
                        ],
                        "default": "IN"
                      },
                      "ep_buffer_size": {
                        "type": "integer",
                        "title": "transmission buffer size (to be conditioned for IN endpoints only)",
                        "default": 1,
                        "maximum": 256,
                        "display_format": [
                          "hex"
                        ],
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            }
          }

        },
        "additional": {
          "type": "object",
          "title": "Advanced features",
          "properties": {
            "bcd_state": {
              "type": "boolean",
              "title": "USB battery charging device state",
              "default": false
            },
            "lpm_enable": {
              "type": "boolean",
              "title": "USB low power management state",
              "default": false
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "properties": {
            "gpio": {
              "type": "object",
              "title": "GPIO",
              "properties": {
                "dp": {
                  "type": "object",
                  "title": "USB D+ pin",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.name, 'DP')"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "DP"
                    }
                  ]
                },
                "dm": {
                  "type": "object",
                  "title": "USB D- pin",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.name, 'DM')"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "DM"
                    }
                  ]
                },
                "sof": {
                  "type": "object",
                  "title": "USB SOF signal",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "(!$get('pinout.peripheralCanBeMapped', $resource.name, 'SOF'))||($basic.sof_state==false)"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "SOF",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }                    }
                  ]
                },
                "vbus": {
                  "type": "object",
                  "title": "USB VBUS pin",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "(!$get('pinout.peripheralCanBeMapped', $resource.name, 'VBUS')) || ($resource.name === 'USB')||($basic.vbus_sense_state === false)"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "VBUS"
                    }
                  ]
                },
                "id_pin_needed": {
                  "type": "boolean",
                  "title": "USB ID pin needed",
                  "default": false,
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.name, 'ID')"
                    }
                  ]
                },
                "id": {
                  "type": "object",
                  "title": "USB ID pin",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "($system.gpio.id_pin_needed === false)||!$get('pinout.peripheralCanBeMapped', $resource.name, 'ID')"
                    }
                  ],
                  "needs": [
                    {
                      "selector": "ID"
                    }
                  ]
                }
              }
            },
            "nvic": {
              "type": "object",
              "title": "NVIC",
              "properties": {
                "enable_interruption": {
                  "type": "boolean",
                  "title": "Global interrupt",
                  "actions": [
                    {
                      "type": "warning",
                      "condition": "$value == false",
                      "message": "Disabling the interrupt will prevent the USB peripheral from functioning properly."
                    }
                  ],
                  "default": true
                },
                "irq_handler_generation": {
                  "type": "boolean",
                  "title": "IRQ handler generation",
                  "default": true,
                  "synchronize": true,
                  "synchronizeOn": {
                    "path": "irq_handler_generation",
                    "component": "HAL-USB"
                  },
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption && $info.layer === 'HAL'"
                    }
                  ]
                },
                "nvic_config": {
                  "type": "object",
                  "title": "Global",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption"
                    }
                  ],
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.name",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}