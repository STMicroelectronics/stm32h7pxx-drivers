                  "const": 10,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED1') == true"
                    }
                  ]
                },
                {
                  "title": "Serial-wire trace synchronous (4 bits)",
                  "description": "Serial-wire with four parallel trace pins.",
                  "const": 11,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED3') == true"
                    }
                  ]
                },
                {
                  "title": "Serial-wire trace synchronous (8 bits)",
                  "description": "Serial-wire with eight parallel trace pins.",
                  "const": 12,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED7') == true"
                    }
                  ]
                },
                {
