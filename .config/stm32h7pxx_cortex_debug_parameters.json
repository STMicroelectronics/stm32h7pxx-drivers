{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:CORTEX DEBUG",
  "grammarVersion": "3.8.0",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/debug_helpers.js",
      "accessor": "debug"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "title": "General information",
          "type": "object",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "layer": {
              "title": "Software layer",
              "type": "string",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "default": "HAL",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_CORTEX_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "title": "Resource initialization code generation",
              "type": "string",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_CORTEX_CORE_ENABLED",
                  "value": true
                }
              ],
              "default": "called"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "mode": {
              "title": "Mode",
              "type": "integer",
              "oneOf": [
                {
                  "title": "JTAG (4 pins)",
                  "description": "JTAG without the JTRST pin.",
                  "const": 0
                },
                {
                  "title": "JTAG (5 pins)",
                  "description": "JTAG with the JTRST pin.",
                  "const": 1
                },
                {
                  "title": "JTAG with trace synchronous (1 bit)",
                  "description": "JTAG with one parallel trace pin.",
                  "const": 2,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED0') == true"
                    }
                  ]
                },
                {
                  "title": "JTAG with trace synchronous (2 bits)",
                  "description": "JTAG with two parallel trace pins.",
                  "const": 3,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED1') == true"
                    }
                  ]
                },
                {
                  "title": "JTAG with trace synchronous (4 bits)",
                  "description": "JTAG with four parallel trace pins.",
                  "const": 4,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED3') == true"
                    }
                  ]
                },
                {
                  "title": "JTAG with trace synchronous (8 bits)",
                  "description": "JTAG with eight parallel trace pins.",
                  "const": 5,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED7') == true"
                    }
                  ]
                },
                {
                  "title": "JTAG with trace synchronous (16 bits)",
                  "description": "JTAG with sixteen parallel trace pins.",
                  "const": 6,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED15') == true"
                    }
                  ]
                },
                {
                  "title": "Single-wire trace asynchronous",
                  "description": "Serial-wire with serial trace pin.",
                  "const": 7
                },
                {
                  "title": "Serial-wire",
                  "description": "Serial-wire protocol.",
                  "const": 8
                },
                {
                  "title": "Serial-wire trace synchronous (1 bit)",
                  "description": "Serial-wire with one parallel trace pin.",
                  "const": 9,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.name, 'TRACED0') == true"
                    }
                  ]
                },
                {
                  "title": "Serial-wire trace synchronous (2 bits)",
