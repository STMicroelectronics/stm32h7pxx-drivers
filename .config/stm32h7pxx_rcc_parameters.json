{
  "$schema": "http://json-schema.org/draft-07/schema",
  "componentid": "::Device:STM32CubeMX2 Config:RCC",
  "grammarVersion": "3.9",
  "version": "1.0.0",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/rcc_helpers.js",
      "accessor": "rcc_helpers"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "title": "General information",
          "type": "object",
          "properties": {
            "labels": {
              "title": "Add a label",
              "type": "array",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "layer": {
              "title": "Software layer",
              "type": "string",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "default": "HAL",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_RCC_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "type": "string",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            }
          }
        },
        "basic": {
          "title": "Main features",
          "type": "object",
          "properties": {
            "periph_clocks_init": {
              "title": "Peripherals clock strategy",
              "description": "Choose where the initialization code for peripheral clock sources is generated and called.",
              "type": "integer",
              "oneOf": [
                {
                  "title": "Central",
                  "description": "One single function (mx_rcc_peripherals_clock_config) contains clock source configuration and activation for all peripherals. This function is automatically called at system global initialization (in mx_system_init).",
                  "const": 0
                },
                {
                  "title": "Controlled by peripherals",
                  "description": "One function per peripheral (mx_rcc_pppi_clock_config) contains the clock source configuration and activation for that peripheral. These functions are automatically called at peripheral initialization (in mx_pppi_init).",
                  "const": 1
                },
                {
                  "title": "Controlled by user",
                  "description": "One function per peripheral (mx_rcc_pppi_clock_config) is generated but not called. You must call this function before using the peripheral.",
                  "const": 2
                }
              ],
              "default": 0
            },
            "voltage_scaling": {
              "title": "Voltage scaling",
              "type": "string",
              "description": "Pick the voltage scaling range that matches your system clock frequency. The right range helps optimize power consumption.",
              "synchronize": true,
              "synchronizeOn": {
                "path": "voltage_scaling",
                "component": "HAL-PWR"
              },
              "oneOf": [
                {
                  "title": "VOS0",
                  "const": "VOLT_SCALE_0",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_vos_possible('VOLT_SCALE_0', $get('clock.frequency','AXI_Input_Clock'))",
                      "message": "Available only when the current axi clock frequency allows this voltage scaling value."
                    }
                  ]
                },
                {
                  "title": "VOS1",
                  "const": "VOLT_SCALE_1",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_vos_possible('VOLT_SCALE_1', $get('clock.frequency','AXI_Input_Clock'))",
                      "message": "Available only when the current axi clock frequency allows this voltage scaling value."
                    }
                  ]
                },
                {
                  "title": "VOS2",
                  "const": "VOLT_SCALE_2",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_vos_possible('VOLT_SCALE_2', $get('clock.frequency','AXI_Input_Clock'))",
                      "message": "Available only when the current axi clock frequency allows this voltage scaling value."
                    }
                  ]
                }
              ],
              "actions": [
                {
                  "type": "error",
                  "condition": "($value === undefined) || (!$rcc_helpers.helper_rcc_is_vos_possible($value, $get('clock.frequency','AXI_Input_Clock')))",
                  "message": "Select a voltage scaling range compatible with the current AXI clock frequency. Using an incompatible range causes system malfunction."
                }
              ],
              "default": "VOLT_SCALE_1"
            },
            "flash_latency": {
              "title": "Flash latency wait states",
              "description": "Select the number of wait states required for the chosen system clock frequency. This ensures reliable flash memory access at different speeds.",
              "type": "integer",
              "synchronize": true,
              "synchronizeOn": {
                "path": "flash_latency",
                "component": "HAL-FLASH"
              },
              "actions": [
                {
                  "type": "error",
                  "condition": "($value === undefined) || (($rcc_helpers.helper_rcc_get_optimal_latency($get('clock.frequency','AXI_Input_Clock'), $basic.voltage_scaling)) > $value)",
                  "message": "Increase value. The flash wait states must be at least the recommended value for the current system clock. Using a lower value can lead to system malfunction."
                },
                {
                  "type": "warning",
                  "condition": "(($rcc_helpers.helper_rcc_get_optimal_latency($get('clock.frequency','AXI_Input_Clock'), $basic.voltage_scaling)) < $value)",
                  "message": "Decrease the value. Using a non-optimal value can affect performance."
                }
              ],
              "default": 4,
              "oneOf": [
                {
                  "const": 0,
                  "title": "0",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','AXI_Input_Clock'), 0, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash wait state value."
                    }
                  ]
                },
                {
                  "const": 1,
                  "title": "1",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','AXI_Input_Clock'), 1, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash wait state value."
                    }
                  ]
                },
                {
                  "const": 2,
                  "title": "2",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','AXI_Input_Clock'), 2, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash wait state value."
                    }
                  ]
                },
                {
                  "const": 3,
                  "title": "3",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','AXI_Input_Clock'), 3, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash wait state value."
                    }
                  ]
                },
                {
                  "const": 4,
                  "title": "4",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','AXI_Input_Clock'), 4, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash wait state value."
                    }
                  ]
                },
                {
                  "const": 5,
                  "title": "5",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','AXI_Input_Clock'), 5, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash wait state value."
                    }
                  ]
                },
                {
                  "const": 6,
                  "title": "6",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','AXI_Input_Clock'), 6, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash wait state value."
                    }
                  ]
                },
                {
                  "const": 7,
                  "title": "7",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','AXI_Input_Clock'), 7, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash wait state value."
                    }
                  ]
                },
                {
                  "const": 8,
                  "title": "8",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','AXI_Input_Clock'), 8, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash wait state value."
                    }
                  ]
                },
                {
                  "const": 9,
                  "title": "9",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','AXI_Input_Clock'), 9, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash wait state value."
                    }
                  ]
                },
                {
                  "const": 10,
                  "title": "10",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','AXI_Input_Clock'), 10, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash wait state value."
                    }
                  ]
                },
                {
                  "const": 11,
                  "title": "11",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','AXI_Input_Clock'), 11, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash wait state value."
                    }
                  ]
                },
                {
                  "const": 12,
                  "title": "12",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','AXI_Input_Clock'), 12, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash wait state value."
                    }
                  ]
                },
                {
                  "const": 13,
                  "title": "13",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','AXI_Input_Clock'), 13, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash wait state value."
                    }
                  ]
                },
                {
                  "const": 14,
                  "title": "14",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','AXI_Input_Clock'), 14, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash wait state value."
                    }
                  ]
                },
                {
                  "const": 15,
                  "title": "15",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_latency_possible($get('clock.frequency','AXI_Input_Clock'), 15, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash wait state value."
                    }
                  ]
                }
              ]
            },
            "flash_programming_delay": {
              "title": "Flash programming delay",
              "description": "Select the flash programming delay value required for the chosen system clock frequency. This ensures reliable flash memory operations at different speeds.",
              "type": "integer",
              "synchronize": true,
              "synchronizeOn": {
                "path": "flash_programming_delay",
                "component": "HAL-FLASH"
              },
              "actions": [
                {
                  "type": "error",
                  "condition": "($value === undefined) || (($rcc_helpers.helper_rcc_get_optimal_programming_delay($get('clock.frequency','AXI_Input_Clock'), $basic.voltage_scaling)) > $value)",
                  "message": "Increase value. The flash programming delay must be at least the recommended value for the current system clock. Using a lower value can lead to system malfunction."
                },
                {
                  "type": "warning",
                  "condition": "($rcc_helpers.helper_rcc_get_optimal_programming_delay($get('clock.frequency','AXI_Input_Clock'), $basic.voltage_scaling) < $value)",
                  "message": "Decrease the value. Using a non-optimal value can affect performance."
                }
              ],
              "oneOf": [
                {
                  "const": 0,
                  "title": "0",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_programming_delay_possible($get('clock.frequency','AXI_Input_Clock'), 0, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash programming delay value."
                    }
                  ]
                },
                {
                  "const": 1,
                  "title": "1",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_programming_delay_possible($get('clock.frequency','AXI_Input_Clock'), 1, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash programming delay value."
                    }
                  ]
                },
                {
                  "const": 2,
                  "title": "2",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_programming_delay_possible($get('clock.frequency','AXI_Input_Clock'), 2, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash programming delay value."
                    }
                  ]
                },
                {
                  "const": 3,
                  "title": "3",
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$rcc_helpers.helper_rcc_is_flash_programming_delay_possible($get('clock.frequency','AXI_Input_Clock'), 3, $basic.voltage_scaling)",
                      "message": "Available only when the current axi clock frequency allows this flash programming delay value."
                    }
                  ]
                }
              ],
              "default": 2
            },
            "hse": {
              "title": "HSE",
              "description": "High Speed External clock.",
              "type": "object",
              "properties": {
                "state": {
                  "title": "Source",
                  "type": "string",
                  "oneOf": [
                    {
                      "title": "Disabled",
                      "const": "OFF"
                    },
                    {
                      "title": "Crystal/ceramic resonator",
                      "description": "External crystal or ceramic resonator between OSC_IN and OSC_OUT pins.",
                      "const": "ON",
                      "actions": [
                        {
                          "type": "include",
                          "condition": "($get('pinout.peripheralCanBeMapped', $resource.id, 'OSC_IN') === true) && ($get('pinout.peripheralCanBeMapped', $resource.id, 'OSC_OUT') === true)"
                        }
                      ]
                    },
                    {
                      "title": "Bypass",
                      "description": "External analog clock on OSC_IN pin.",
                      "const": "BYPASS",
                      "actions": [
                        {
                          "type": "include",
                          "condition": "($get('pinout.peripheralCanBeMapped', $resource.id, 'OSC_IN') === true)"
                        }
                      ]
                    },
                    {
                      "title": "Digital bypass",
                      "description": "External digital clock on OSC_IN pin.",
                      "const": "BYPASS_DIGITAL",
                      "actions": [
                        {
                          "type": "include",
                          "condition": "($get('pinout.peripheralCanBeMapped', $resource.id, 'OSC_IN') === true)"
                        }
                      ]
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "condition": "$value !== 'OFF'",
                      "name": "RCC_PROJECT_HSE",
                      "value": true
                    }
                  ],
                  "default": "OFF"
                },
                "startup_time": {
                  "title": "Startup timeout value",
                  "type": "integer",
                  "unit": "ms",
                  "minimum": 1,
                  "maximum": 10000,
                  "default": 100,
                  "variables": [
                    {
                      "on": "enable",
                      "name": "RCC_PROJECT_HSE_STARTUP_TIME",
                      "computed_value": "$value"
                    }
                  ],
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "($basic.hse.state==='OFF') || (($get('hwPlatform.hse_startup_time') !== undefined) && ($get('hwPlatform.hse_startup_time').value != 0))",
                      "message": "This value comes from your hardware profile and cannot be changed here."
                    },
                    {
                      "type": "set",
                      "condition": "($get('hwPlatform.hse_startup_time') !== undefined) && ($get('hwPlatform.hse_startup_time').value != 0)",
                      "attributes": {
                        "title": "Startup timeout value set by board profile"
                      },
                      "computed": {
                        "const": "$get('hwPlatform.hse_startup_time').value"
                      }
                    }
                  ]
                },
                "enable_css": {
                  "title": "Clock security system",
                  "description": "The clock security system detects HSE failures. If a failure occurs, the system automatically switches to the internal high-speed clock (HSI). You must handle any additional corrective actions.",
                  "type": "boolean",
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$basic.hse.state==='OFF'",
                      "message": "Available only when HSE is enabled."
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "condition": "($value === true)",
                      "name": "NMI_RCC_IRQ_HANDLER",
                      "value": true
                    }
                  ],
                  "default": false
                }
              },
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('pinout.peripheralCanBeMapped', $resource.id, 'OSC_IN') === true)"
                }
              ]
            },
            "lse": {
              "title": "LSE",
              "description": "Low Speed External clock.",
              "type": "object",
              "properties": {
                "state": {
                  "title": "Source",
                  "type": "string",
                  "oneOf": [
                    {
                      "title": "Disabled",
                      "const": "OFF"
                    },
                    {
                      "title": "Crystal/ceramic resonator",
                      "description": "External crystal or ceramic resonator between OSC32_IN and OSC32_OUT pins.",
                      "const": "ON",
                      "actions": [
                        {
                          "type": "include",
                          "condition": "($get('pinout.peripheralCanBeMapped', $resource.id, 'OSC32_IN') === true) && ($get('pinout.peripheralCanBeMapped', $resource.id, 'OSC32_OUT') === true)"
                        }
                      ]
                    },
                    {
                      "title": "Bypass",
                      "description": "External analog clock on OSC32_IN pin.",
                      "const": "BYPASS",
                      "actions": [
                        {
                          "type": "include",
                          "condition": "($get('pinout.peripheralCanBeMapped', $resource.id, 'OSC32_IN') === true)"
                        }
                      ]
                    },
                    {
                      "title": "Digital bypass",
                      "description": "External digital clock on OSC32_IN pin.",
                      "const": "BYPASS_DIGITAL",
                      "actions": [
                        {
                          "type": "include",
                          "condition": "($get('pinout.peripheralCanBeMapped', $resource.id, 'OSC32_IN') === true)"
                        }
                      ]
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "condition": "$value !== 'OFF'",
                      "name": "RCC_PROJECT_LSE",
                      "value": true
                    }
                  ],
                  "default": "OFF"
                },
                "startup_time": {
                  "title": "Startup timeout value",
                  "type": "integer",
                  "unit": "ms",
                  "minimum": 1,
                  "maximum": 50000,
                  "default": 5000,
                  "variables": [
                    {
                      "on": "enable",
                      "name": "RCC_PROJECT_LSE_STARTUP_TIME",
                      "computed_value": "$value"
                    }
                  ],
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "($basic.lse.state==='OFF') || (($get('hwPlatform.lse_startup_time') !== undefined) && ($get('hwPlatform.lse_startup_time').value != 0))",
                      "message": "This value comes from your hardware profile and cannot be changed here."
                    },
                    {
                      "type": "set",
                      "condition": "($get('hwPlatform.lse_startup_time') !== undefined) && ($get('hwPlatform.lse_startup_time').value != 0)",
                      "attributes": {
                        "title": "Startup timeout value (retrieved from board profile)"
                      },
                      "computed": {
                        "const": "$get('hwPlatform.lse_startup_time').value"
                      }
                    }
                  ]
                },
                "drive_capability": {
                  "title": "Drive capability",
                  "type": "string",
                  "description": "Adjust the amplifier driving capability to ensure a stable oscillation.",
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$basic.lse.state==='OFF'",
                      "message": "Available only when LSE is enabled."
                    }
                  ],
                  "oneOf": [
                    {
                      "title": "Low",
                      "const": "LOW"
                    },
                    {
                      "title": "Medium low",
                      "const": "MEDIUMLOW"
                    },
                    {
                      "title": "Medium high",
                      "const": "MEDIUMHIGH"
                    },
                    {
                      "title": "High",
                      "const": "HIGH"
                    }
                  ],
                  "default": "LOW"
                },
                "enable_css": {
                  "title": "Clock security system",
                  "description": "The clock security system detects LSE failures. If a failure occurs, the system does not take automatic action. You must handle corrective actions.",
                  "type": "boolean",
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "$basic.lse.state==='OFF'",
                      "message": "Available only when LSE is enabled."
                    }
                  ],
                  "default": false
                }
              },
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('pinout.peripheralCanBeMapped', $resource.id, 'OSC32_IN') === true)"
                }
              ]
            }
          }
        },
        "additional": {
          "title": "Advanced features",
          "type": "object",
          "properties": {
            "audio_clock": {
              "title": "External audio clock",
              "description": "External kernel clock input for I2S.",
              "type": "object",
              "properties": {
                "enable": {
                  "title": "Audio clock",
                  "type": "boolean",
                  "variables": [
                    {
                      "on": "update-value",
                      "condition": "$value === true",
                      "name": "RCC_PROJECT_AUDIO",
                      "value": true
                    }
                  ],
                  "default": false
                },
                "audio_clock_freq": {
                  "title": "Frequency",
                  "type": "number",
                  "unit": "Hz",
                  "default": 100,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.audio_clock.enable"
                    },
                    {
                      "type": "disable",
                      "condition": "true",
                      "message": "This value is computed from the selected audio clock source and cannot be changed here."
                    },
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "const": "$get('clock.frequency','AUDIOCLK')"
                      }
                    }
                  ]
                }
              },
              "actions": [
                {
                  "type": "include",
                  "condition": "$get('pinout.peripheralCanBeMapped', $resource.id, 'AUDIOCLK') === true"
                }
              ]
            },
            "clk_outputs": {
              "title": "Clock outputs",
              "type": "object",
              "properties": {
                "mco1": {
                  "title": "MCO1",
                  "description": "Microcontroller clock output 1.",
                  "type": "boolean",
                  "default": false,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.id, 'MCO1') === true"
                    }
                  ]
                },
                "mco2": {
                  "title": "MCO2",
                  "description": "Microcontroller clock output 2.",
                  "type": "boolean",
                  "default": false,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$get('pinout.peripheralCanBeMapped', $resource.id, 'MCO2') === true"
                    }
                  ]
                }
              }
            }
          }
        },
        "system": {
          "title": "System",
          "type": "object",
          "properties": {
            "gpio": {
              "title": "GPIO",
              "type": "object",
              "actions": [
                {
                  "type": "include",
                  "condition": "($basic.lse.state!=='OFF') || ($basic.hse.state!=='OFF') || ($additional.audio_clock.enable) || ($additional.clk_outputs.mco1) || ($additional.clk_outputs.mco2)"
                }
              ],
              "properties": {
                "hse_in": {
                  "title": "HSE In",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "OSC_IN",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "($basic.hse === undefined) || ($basic.hse.state==='OFF')"
                    }
                  ]
                },
                "hse_out": {
                  "title": "HSE Out",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "OSC_OUT",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.hse.state==='ON'"
                    }
                  ]
                },
                "lse_in": {
                  "title": "LSE In",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "OSC32_IN",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "($basic.lse === undefined) || ($basic.lse.state==='OFF')"
                    }
                  ]
                },
                "lse_out": {
                  "title": "LSE Out",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "OSC32_OUT",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($basic.lse.state==='ON')"
                    }
                  ]
                },
                "audio_clock": {
                  "title": "Audio clock",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "AUDIOCLK",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "pull": {
                          "const": "NO"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.audio_clock.enable"
                    }
                  ]
                },
                "mco1": {
                  "title": "MCO1",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "MCO1",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.clk_outputs.mco1"
                    }
                  ]
                },
                "mco2": {
                  "title": "MCO2",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "MCO2",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        },
                        "output_type": {
                          "const": "PUSHPULL"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.clk_outputs.mco2"
                    }
                  ]
                }
              }
            },
            "exti": {
              "title": "EXTI",
              "type": "object",
              "actions": [
                {
                  "type": "include",
                  "condition": "($basic.lse.state!=='OFF') && ($basic.lse.enable_css)"
                }
              ],
              "properties": {
                "lse_css_interruption": {
                  "title": "LSE CSS",
                  "type": "object",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.lse.enable_css"
                    }
                  ],
                  "objectType": "need.exti.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_EXTI_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ]
                }
              }
            },
            "nvic": {
              "title": "NVIC",
              "type": "object",
              "actions": [
                {
                  "type": "include",
                  "condition": "($basic.hse.state!=='OFF' && $basic.hse.enable_css) || ($basic.lse.state!=='OFF' && $basic.lse.enable_css)"
                }
              ],
              "properties": {
                "hse_css_irq_handler_generation": {
                  "title": "NMI IRQ handler generation",
                  "description": "HSE CSS failures are reported through NMI. Enabling this option generates the NMI IRQ handler in which you can manage the clock failure event.",
                  "type": "boolean",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.hse.enable_css && $info.layer === 'HAL'"
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "condition": "($value === true)",
                      "name": "NMI_RCC_IRQ_HANDLER",
                      "value": true
                    }
                  ]
                },
                "hse_css_interruption": {
                  "title": "NMI priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "system:NMI"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.hse.enable_css"
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ]
                },
                "lse_css_irq_handler_generation": {
                  "title": "LSE CSS IRQ handler generation",
                  "type": "boolean",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.lse.enable_css && $info.layer === 'HAL'"
                    }
                  ]
                },
                "lse_css_interruption": {
                  "title": "IRQ line priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "system:RCC"
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$basic.lse.enable_css"
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ]
                }
              }
            }
          }
        },
        "runtime": {
          "title": "Applicative services",
          "type": "object",
          "description": "Generate specific runtime functions.",
          "properties": {
            "crypto_reset": {
              "title": "Crypto IP reset ",
              "description": "Generate a function to reset the crypto IPs.",
              "type": "boolean",
              "default": false,
              "actions": [
                {
                  "type": "include",
                  "condition": "$get('peripheral.isPhysicallyAvailableInCurrentDevice', 'RNG') || $get('peripheral.isPhysicallyAvailableInCurrentDevice', 'SAES') || $get('peripheral.isPhysicallyAvailableInCurrentDevice', 'HASH') || $get('peripheral.isPhysicallyAvailableInCurrentDevice', 'PKA') || $get('peripheral.isPhysicallyAvailableInCurrentDevice', 'CCB')",
                  "message": "Only available when at least one crypto IP is physically available in the current device."
                },
                {
                  "type": "enable",
                  "condition": "$get('peripheral.isBound', 'RNG') || $get('peripheral.isBound', 'SAES') || $get('peripheral.isBound', 'HASH') || $get('peripheral.isBound', 'PKA') || $get('peripheral.isBound', 'CCB')",
                  "message": "At least one crypto IP must be bound."
                },
                {
                  "type": "set",
                  "condition": "(!$get('peripheral.isBound', 'RNG')) && (!$get('peripheral.isBound', 'SAES')) && (!$get('peripheral.isBound', 'HASH')) && (!$get('peripheral.isBound', 'PKA')) && (!$get('peripheral.isBound', 'CCB'))",
                  "message": "Reset to false when none of the crypto IPs are bound.",
                  "computed": {
                    "const": false
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
