{
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:UCPD",
  "grammarVersion": "3.9",
  "functions": [
    {
      "path": ".config/template/helpers/ucpd_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ],
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_UCPD_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "timing": {
              "type": "object",
              "title": "Timing",
              "properties": {
                "clock_source": {
                  "type": "string",
                  "title": "Clock source",
                  "description": "Clock source can be modified in clock tree.",
                  "readOnly": true,
                  "actions": [
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "const": "$get('clock.input', $resource.id)"
                      }
                    }
                  ],
                  "default": ""
                },
                "clock_source_frequency": {
                  "type": "string",
                  "title": "Clock source frequency",
                  "description": "Input clock frequency can be modified in clock tree.",
                  "readOnly": true,
                  "actions": [
                    {
                      "type": "set",
                      "condition": "($get('clock.frequency',$resource.id)) < 1000000",
                      "computed": {
                        "const": "$get('clock.frequency',$resource.id) / 1000 + ' kHz'"
                      }
                    },
                    {
                      "type": "set",
                      "condition": "($get('clock.frequency',$resource.id)) >= 1000000",
                      "computed": {
                        "const": "$get('clock.frequency',$resource.id) / 1000000 + ' MHz'"
                      }
                    }
                  ],
                  "default": ""
                },
                "optimum_performance": {
                  "type": "boolean",
                  "title": "Optimum performance",
                  "description": "Calculate and set for optimum performance.",
                  "default": true
                },
                "clock_prescaler": {
                  "type": "integer",
                  "title": "Clock prescaler",
                  "description": "Prescaler value used to divide the UCPD clock source.",
                  "oneOf": [
                    {
                      "title": "÷ 1",
                      "const": 1
                    },
                    {
                      "title": "÷ 2",
                      "const": 2
                    },
                    {
                      "title": "÷ 4",
                      "const": 4
                    },
                    {
                      "title": "÷ 8",
                      "const": 8
                    },
                    {
                      "title": "÷ 16",
                      "const": 16
                    }
                  ],
                  "actions": [
                    {
                      "type": "set",
                      "computed": {
                        "const": "$common.helper_ucpd_set_optimum_performance($get('clock.frequency',$resource.id),1)"
                      },
                      "condition": "$basic.timing.optimum_performance==true"
                    }
                  ],
                  "default": 1
                },
                "clock_core_frequency": {
                  "type": "string",
                  "title": "Clock core frequency",
                  "description": "Keep clock core frequency between 6 to 12 MHz.",
                  "readOnly": true,
                  "actions": [
                    {
                      "type": "set",
                      "condition": "$basic.timing.optimum_performance==true",
                      "computed": {
                        "const": "$common.helper_ucpd_set_optimum_performance($get('clock.frequency',$resource.id),2) / 1000000 + ' MHz'"
                      }
