        "additional": {
          "type": "object",
          "title": "Advanced features",
          "properties": {
            "dead_battery": {
              "title": "Dead battery",
              "type": "boolean",
              "default": false,
              "actions": [
                {
                  "type": "exclude",
                  "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'DBCC1') &&  !$get('pinout.peripheralCanBeMapped', $resource.id, 'DBCC2')"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "UCPD_DBDIS",
                  "value": true
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "path": "enable_dead_battery_mode",
                "component": "HAL-PWR"
              }
            },
            "fast_role_swap_tx": {
              "title": "Fast role swap tx",
              "type": "boolean",
              "default": false,
              "actions": [
                {
                  "type": "exclude",
                  "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'FRSTX1') && !$get('pinout.peripheralCanBeMapped', $resource.id, 'FRSTX2')"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "UCPD_CORE_USE_HAL_UCPD_POWER_DELIVERY",
                  "condition": "$value == true",
                  "semaphore": true
                }
              ]
            },
            "rx_analog_filter": {
              "title": "Rx Analog Filter",
              "type": "boolean",
              "default": false
            },
            "wake_up_stop_mode": {
              "title": "Wake up from stop mode",
              "type": "boolean",
              "default": false
            },
            "force_clock": {
              "title": "Force clock request",
              "type": "boolean",
              "default": false
            },
            "rx_prefilter": {
              "title": "Rx prefilter",
              "type": "boolean",
              "default": false,
              "variables": [
                {
                  "on": "update-value",
                  "name": "UCPD_CORE_USE_HAL_UCPD_POWER_DELIVERY",
                  "condition": "$value == true",
                  "semaphore": true
                }
              ]
            },
            "rx_prefilter_sampling": {
              "title": "Rx prefilter sampling",
              "type": "string",
              "oneOf": [
                {
                  "title": "2 samples",
                  "const": "2SAMPLES"
                },
                {
                  "title": "3 samples",
                  "const": "3SAMPLES"
                }
              ],
              "default": "3SAMPLES",
              "actions": [
                {
                  "type": "enable",
                  "condition": "$additional.rx_prefilter==true",
                  "message": " Enable Rx Prefilter before choosing the sampling method."
                }
              ]
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "properties": {
            "gpio": {
              "type": "object",
              "title": "GPIO",
              "properties": {
                "gpio_cc1": {
                  "title": "GPIO CC1",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "CC1",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'CC1')"
                    }
                  ]
                },
                "gpio_cc2": {
                  "title": "GPIO CC2",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "CC2",
                      "constraints": {
                        "mode": {
                          "const": "ANALOG"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "exclude",
                      "condition": "!$get('pinout.peripheralCanBeMapped', $resource.id, 'CC2')"
                    }
                  ]
                },
                "gpio_dbcc1": {
                  "title": "GPIO DBCC1",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "DBCC1",
                      "constraints": {
                        "Mode": {},
                        "Pull": {},
                        "Speed": {}
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.dead_battery==true"
                    }
                  ]
                },
                "gpio_dbcc2": {
                  "title": "GPIO DBCC2",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "DBCC2",
                      "constraints": {
                        "Mode": {},
                        "Pull": {},
                        "Speed": {}
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.dead_battery==true"
                    }
                  ]
                },
                "gpio_frstx1": {
                  "title": "GPIO FRSTX1",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "FRSTX1",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.fast_role_swap_tx==true"
                    }
                  ]
                },
                "gpio_frstx2": {
                  "title": "GPIO FRSTX2",
                  "type": "object",
                  "objectType": "need.pinout.signals",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_GPIO_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "FRSTX2",
                      "constraints": {
                        "mode": {
                          "const": "ALTERNATE"
                        }
                      }
                    }
                  ],
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$additional.fast_role_swap_tx==true"
                    }
                  ]
                }
              }
            },
            "dma": {
              "type": "object",
              "title": "DMA",
              "properties": {
                "enable_dma_tx": {
                  "title": "DMA Tx",
                  "type": "boolean",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "UCPD_CORE_USE_HAL_UCPD_POWER_DELIVERY",
                      "condition": "$value == true",
                      "semaphore": true
                    }
                  ],
                  "default": false
                },
                "dma_config_tx": {
                  "title": "DMA Tx",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.dma.enable_dma_tx"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "TX",
                      "constraints": {
                        "direction": {
                          "const": "MEMORY_TO_PERIPH"
                        },
                        "src_inc": {
                          "const": "INCREMENTED"
                        },
                        "dest_inc": {
                          "const": "FIXED"
                        },
                        "dest_data_width": {
                          "const": "BYTE"
                        }
                      }
                    }
                  ]
                },
                "enable_dma_rx": {
                  "title": "DMA Rx",
                  "type": "boolean",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "UCPD_CORE_USE_HAL_UCPD_POWER_DELIVERY",
                      "condition": "$value == true",
                      "semaphore": true
                    }
                  ],
                  "default": false
                },
                "dma_config_rx": {
                  "title": "DMA Rx",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.dma.enable_dma_rx"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "RX",
                      "constraints": {
                        "direction": {
                          "const": "PERIPH_TO_MEMORY"
                        },
                        "src_inc": {
                          "const": "FIXED"
                        },
                        "dest_inc": {
                          "const": "INCREMENTED"
                        },
                        "dest_data_width": {
                          "const": "BYTE"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "nvic": {
              "type": "object",
              "title": "NVIC",
              "properties": {
                "enable_interruption": {
                  "type": "boolean",
                  "title": "Global interrupt",
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "($system.dma.enable_dma_rx) || ($system.dma.enable_dma_tx)",
                      "message": "Interrupts are required when DMA is enabled."
                    },
                    {
                      "type": "set",
                      "condition": "($system.dma.enable_dma_rx) || ($system.dma.enable_dma_tx)",
                      "attributes": {
                        "const": true
                      }
                    }
                  ],
                  "default": false
                },
                "irq_handler_generation": {
                  "type": "boolean",
                  "title": "IRQ handler generation",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption && $info.layer === 'HAL'"
                    }
                  ]
                },
                "nvic_config": {
                  "title": "NVIC UCPD global",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}