                      "type": "set",
                      "condition": "$basic.timing.optimum_performance==false",
                      "computed": {
                        "const": "$common.helper_ucpd_get_half_bit_clock_frequency($get('clock.frequency',$resource.id),$basic.timing.clock_prescaler,$basic.timing.half_bit_clock) / 1000 + ' kHz'"
                      }
                    }
                  ],
                  "default": ""
                },
