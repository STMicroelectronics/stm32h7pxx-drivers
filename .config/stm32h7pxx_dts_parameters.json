{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:DTS",
  "grammarVersion": "3.8",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/dts_helpers.js",
      "accessor": "common"
    },
    {
      "path": ".config/template/helpers/rcc_helpers.js",
      "accessor": "rcc_common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "layer": {
              "type": "string",
              "title": "Software layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_DTS_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "reference_clock": {
              "title": "Reference clock",
              "type": "string",
              "oneOf": [
                {
                  "title": "High speed reference clock (PCLK)",
                  "const": "PCLK"
                },
                {
                  "title": "Low speed reference clock (LSE)",
                  "const": "LSE"
                }
              ],
              "actions": [
                {
                  "type": "warning",
                  "condition": "($value === 'LSE') && ($get('envVar.value', 'RCC_PROJECT_LSE') !== true)",
                  "message": "Make sure that LSE is enabled into RCC panel"
                }
              ],
              "default": "PCLK"
            },
            "reference_clock_frequency": {
              "title": "Reference clock frequency",
              "type": "string",
              "default": "",
              "actions": [
                {
                  "type": "disable",
                  "condition": "true",
                  "message": "This value is computed automatically."
                },
                {
                  "type": "set",
                  "condition": "($basic.reference_clock== 'PCLK') && (($get('clock.frequency', $rcc_common.helper_rcc_get_bus_clock_name($resource.id))) < 1000000)",
                  "computed": {
                    "const": "($get('clock.frequency', $rcc_common.helper_rcc_get_bus_clock_name($resource.id)) / 1000).toFixed(3) + ' KHz'"
                  }
                },
                {
                  "type": "set",
                  "condition": "($basic.reference_clock== 'PCLK') && (($get('clock.frequency', $rcc_common.helper_rcc_get_bus_clock_name($resource.id))) >= 1000000)",
                  "computed": {
                    "const": "($get('clock.frequency', $rcc_common.helper_rcc_get_bus_clock_name($resource.id)) / 1000000).toFixed(3) + ' MHz'"
                  }
                },
                {
                  "type": "set",
                  "condition": "$basic.reference_clock== 'LSE'",
                  "computed": {
                    "const": "($get('clock.frequency', 'LSE') / 1000).toFixed(3) + ' KHz'"
                  }
                }
              ]
            },
            "quick_measurement": {
              "title": "Quick measurement",
              "type": "boolean",
              "actions": [
                {
                  "type": "disable",
                  "condition": "$basic.reference_clock== 'PCLK'",
                  "message": "Quick measurement is only available when the LSE reference clock is selected."
                },
                {
                  "type": "exclude",
                  "condition": "$resource.peripheralVersionNum == 2.0"
                }
              ],
              "default": false
            },
            "high_speed_clock_division": {
              "title": "High speed clock division",
              "type": "integer",
              "actions": [
                {
                  "type": "disable",
                  "condition": "$basic.reference_clock== 'LSE'",
                  "message": "High speed clock division is only available when the PCLK reference clock is selected."
                },
                {
                  "type": "exclude",
                  "condition": "$resource.peripheralVersionNum == 2.0"
                }
              ],
              "default": 1,
              "minimum": 1,
              "maximum": 127,
              "display_format": [
                "dec"
              ]
            },
            "high_speed_clock_frequency": {
              "title": "High speed clock frequency",
              "type": "string",
              "description": "High speed clock frequency after the division.",
              "actions": [
                {
                  "type": "exclude",
                  "condition": "$resource.peripheralVersionNum == 2.0"
                },
                {
                  "type": "disable",
                  "condition": "true",
                  "message": "This value is computed automatically."
                },
                {
                  "type": "set",
                  "condition": "($basic.reference_clock== 'PCLK') && (($get('clock.frequency', $rcc_common.helper_rcc_get_bus_clock_name($resource.id))) < 1000000)",
                  "computed": {
                    "const": "(($get('clock.frequency', $rcc_common.helper_rcc_get_bus_clock_name($resource.id)) / ($basic.high_speed_clock_division * 1000)).toFixed(3)) + ' KHz'"
                  }
                },
                {
                  "type": "set",
                  "condition": "($basic.reference_clock== 'PCLK') && (($get('clock.frequency', $rcc_common.helper_rcc_get_bus_clock_name($resource.id))) >= 1000000)",
                  "computed": {
                    "const": "(($get('clock.frequency', $rcc_common.helper_rcc_get_bus_clock_name($resource.id)) / ($basic.high_speed_clock_division * 1000000)).toFixed(3)) + ' MHz'"
                  }
                },
                {
                  "type": "set",
                  "condition": "$basic.reference_clock== 'LSE'",
                  "attributes": {
                    "const": "Not available"
                  }
                }
              ],
              "default": "Not available"
            },
            "sensors": {
              "title": "Sensors",
              "rendering": "sensors-tabs",
              "type": "array",
              "source": "Array.from({ length : ($resource.features.TEMP_CFG + 1)}, (_, i) => ({ id: i, name: `Sensor ${i+1}` }))",
              "itemTitle": "name",
              "itemId": "id",
              "itemVar": "sensor",
              "items": {
                "type": "object",
                "properties": {
                  "configure": {
                    "title": "Configure sensor",
                    "type": "boolean",
                    "default": true
                  },
                  "trigger_source": {
                    "title": "Trigger source",
                    "type": "object",
                    "objectType": "query",
                    "query": {
                      "entity": "peripheral.interconnect.input trigger",
                      "parent": "$resource.id",
                      "title": "{{source.replace('Sw trigger', 'SOFTWARE').replace('EXT', 'EXTI').replace('_trgo_cktim', '_TRGO').replace('_oc', '_CH').replace('[', '').replace(']', '').replace('_IT', '').toUpperCase()}}",
                      "where": "($entity.source != '0b000000000000') && ($entity.source != '0b0000000000000000') && ($entity.source != '\"0b000000000000\"') && ($entity.source != '\"0b0000000000000000\"')"
                    },
                    "select": "first",
                    "actions": [
                      {
                        "type": "enable",
                        "condition": "$item.configure",
                        "message": "Enable sensor configuration to edit the trigger source."
                      },
                      {
                        "type": "info",
                        "condition": "$item.trigger_source.source !== 'Sw trigger'",
                        "message": "The selected interconnect must be configured manually"
                      }
                    ]
                  },
                  "sampling_time": {
                    "title": "Sampling time",
                    "description": "Sampling time for one measurement.",
                    "unit": "Clock cycles",
                    "type": "integer",
                    "oneOf": [
                      {
                        "title": "1",
                        "const": 1
                      },
                      {
                        "title": "2",
                        "const": 2
                      },
                      {
                        "title": "3",
                        "const": 3
                      },
                      {
                        "title": "4",
                        "const": 4
                      },
                      {
                        "title": "5",
                        "const": 5
                      },
                      {
                        "title": "6",
                        "const": 6
                      },
                      {
                        "title": "7",
                        "const": 7
                      },
                      {
                        "title": "8",
                        "const": 8
                      },
                      {
                        "title": "9",
                        "const": 9
                      },
                      {
                        "title": "10",
                        "const": 10
                      },
                      {
                        "title": "11",
                        "const": 11
                      },
                      {
                        "title": "12",
                        "const": 12
                      },
                      {
                        "title": "13",
                        "const": 13
                      },
                      {
                        "title": "14",
                        "const": 14
                      },
                      {
                        "title": "15",
                        "const": 15
                      }
                    ],
                    "actions": [
                      {
                        "type": "enable",
                        "condition": "$item.configure",
                        "message": "Enable sensor configuration to edit the sampling time."
                      }
                    ],
                    "default": 1
                  },
                  "sampling_time_value": {
                    "title": "Sampling time value",
                    "type": "string",
                    "unit": "ns",
                    "actions": [
                      {
                        "type": "disable",
                        "condition": "true",
                        "message": "This value is computed automatically."
                      },
                      {
                        "type": "set",
                        "condition": "$basic.reference_clock== 'LSE'",
                        "computed": {
                          "const": "($item.sampling_time * (1000000 / $get('clock.frequency', 'LSE'))).toFixed(3) + ' ns'"
                        }
                      },
                      {
                        "type": "info",
                        "message": "The value of the sampling time in ns is calculated as follows:\n sampling_time * (10000 / (Factory value of the frequency measured at T0 for temperature sensor))",
                        "condition": "true"
                      },
                      {
                        "type": "enable",
                        "condition": "$item.configure",
                        "message": "Enable sensor configuration to view the sampling time value."
                      }
                    ],
                    "default": "Not available"
                  },
                  "configure_sensor_thresholds": {
                    "title": "Sensor thresholds",
                    "type": "boolean",
                    "default": false,
                    "actions": [
                      {
                        "type": "warning",
                        "message": "Interrupt line must be enabled in order to benefit from this feature",
                        "condition": "$item.configure_sensor_thresholds && !$system.nvic.enable_interruption"
                      },
                      {
                        "type": "enable",
                        "condition": "$item.configure",
                        "message": "Enable sensor configuration to manage sensor thresholds."
                      }
                    ]
                  },
                  "sensor_high_threshold": {
                    "title": "Sensor high threshold",
                    "type": "integer",
                    "default": 0,
                    "minimum": -40,
                    "maximum": 140,
                    "display_format": [
                      "dec"
                    ],
                    "unit": "celsius degree",
                    "actions": [
                      {
                        "type": "enable",
                        "condition": "$item.configure_sensor_thresholds",
                        "message": "Enable sensor thresholds to edit the high threshold value."
                      }
                    ]
                  },
                  "sensor_low_threshold": {
                    "title": "Sensor low threshold",
                    "type": "integer",
                    "default": 0,
                    "minimum": -40,
                    "maximum": 140,
                    "display_format": [
                      "dec"
                    ],
                    "unit": "celsius degree",
                    "actions": [
                      {
                        "type": "enable",
                        "condition": "$item.configure_sensor_thresholds",
                        "message": "Enable sensor thresholds to edit the low threshold value."
                      }
                    ]
                  }
                }
              }
              },
              "wakeup_low_power": {
                "title": "Wake up system from low power mode",
                "description": "To wake up system from Stop mode (not needed from Sleep mode).",
                "type": "boolean",
                "default": false
              }
            }
        },
        "security_privilege": {
          "title": "Security and privilege",
          "description": "Manage security and privileged access levels attributes.",
          "type": "object",
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.getCurrentEngine') === null) || ($get('swproject.getCurrentEngine').secure === 'TZ-disabled')"
            },
            {
              "type": "set",
              "condition": "$get('swproject.getCurrentEngine').secure === 'Non-secure'",
              "attributes": {
                "title": "Privileged",
                "description": "Manage privileged access levels attributes."
              }
            }
          ],
          "properties": {
            "security": {
              "type": "string",
              "title": "Security attribute",
              "description": "Set the security attribute of the securable peripheral.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "SEC"
                  },
                  "condition": "$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "NSEC"
                  },
                  "condition": "!$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "disable",
                  "condition": "$get('peripheral.isBound', $resource.id)",
                  "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-sec-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Secure",
                  "const": "SEC"
                },
                {
                  "title": "Non-secure",
                  "const": "NSEC"
                }
              ],
              "default": "NSEC"
            },
            "privilege": {
              "type": "string",
              "title": "Privileged attribute",
              "description": "Manage the privileged attribute of a securable RISC peripheral.",
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-priv-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Privileged",
                  "const": "PRIV"
                },
                {
                  "title": "Unprivileged",
                  "const": "NPRIV"
                }
              ],
              "default": "PRIV"
            },
            "lock": {
              "type": "boolean",
              "title": "Lock",
              "description": "Optional. Lock security and privilege attributes to prevent changes.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-lock-attr",
                "custom": "$resource.id"
              },
              "default": false
            },
            "illegal_access": {
              "title": "Illegal access interrupt",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure-only')",
                  "message": "Secure-only mode: Illegal access interrupt is forced to disabled."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-iac-peripheral",
                "custom": "$resource.id"
              },
              "type": "boolean",
              "default": false
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "properties": {
            "exti": {
              "title": "EXTI line",
              "description": "DTS uses EXTI line to wake up system from low power mode.",
              "type": "object",
              "objectType": "need.exti.lines",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_EXTI_PROJECT_USE_HAL",
                  "condition": "$info.layer === 'HAL'",
                  "semaphore": true
                }
              ],
              "owner": "$resource.id",
              "needs": [
                {
                  "selector": "*",
                  "constraints": {
                    "trigger_detection": {
                      "default": "RISING_FALLING"
                    },
                    "enable_interruption": {
                      "const": false
                    }
                  }
                }
              ],
              "actions": [
                {
                  "type": "include",
                  "condition": "$basic.wakeup_low_power"
                }
              ]
            },
            "nvic": {
              "type": "object",
              "title": "NVIC",
              "properties": {
                "enable_interruption": {
                  "title": "Interrupt",
                  "type": "boolean",
                  "default": false
                },
                "irq_handler_generation": {
                  "type": "boolean",
                  "title": "IRQ handler generation",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($system.nvic.enable_interruption) && ($info.layer === 'HAL')"
                    }
                  ]
                },
                "nvic_config": {
                  "title": "NVIC",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
