{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:AXIM",
  "grammarVersion": "3.8",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/common_helpers.js",
      "accessor": "comm"
    },
    {
      "path": ".config/template/helpers/axim_helpers.js",
      "accessor": "axim"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "title": "General information",
          "type": "object",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ],
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "title": "Software layer",
              "type": "string",
              "oneOf": [
                {
                  "title":"HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "default": "HAL",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_AXIM_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "title": "Resource initialization code generation",
              "type": "string",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called",
              "actions": [
                {
                  "type": "enable",
                  "message": "Enable initialization code generation",
                  "condition": "$comm.helper_common_display_object($resource)"
                }
              ]
            }
          }
        },
        "additional": {
          "type": "object",
          "title": "Advanced features",
          "properties": {
            "initiators": {
              "title" : "Interconnect initiators",
              "rendering": "channel-tabs",
              "type": "array",
              "strictMaxItems": false,
              "source": "Array.from({ length: $resource.features.axi_ini_nb }, (_, i) => ({ id: $axim.helper_axim_get_element_name($resource.features.initiators, i), idtitle: $axim.helper_axim_get_cpu_name($axim.helper_axim_get_element_name($resource.features.initiators, i), $get('hwPlatform.device').cores[0].coreType) }))",
              "itemTitle": "idtitle",
              "itemId": "id",
              "itemVar":"initiator",
              "items": {
                "type": "object",
                "properties": {
                  "use_channel": {
                    "type": "boolean",
                    "title": "Modify initiator",
                    "actions": [
                      {
                        "type": "exclude",
                        "condition": "!$axim.helper_axim_is_non_ip_component($initiator?.id) && !$get('peripheral.isPhysicallyAvailableInCurrentDevice', $initiator?.id)"
                      }
                    ],
                    "default": false
                  },
                  "read_qos": {
                    "type": "integer",
                    "title": "Read quality of service",
                    "description": "Set the read quality of service for this Initiator.",
                    "minimum": 0,
                    "maximum": 15,
                    "actions": [
                      {
                        "type": "exclude",
                        "message": "Quality of service is not available for this initiator",
                        "condition": "!$axim.helper_axim_ini_is_qos_available($resource.features.initiators, $initiator?.id) || !$axim.helper_axim_is_non_ip_component($initiator?.id) && !$get('peripheral.isPhysicallyAvailableInCurrentDevice', $initiator?.id)"
                      },
                      {
                        "type": "set",
                        "condition": "$axim.helper_axim_is_non_ip_component($initiator?.id) || $get('peripheral.isPhysicallyAvailableInCurrentDevice', $initiator?.id) && $axim.helper_axim_ini_is_qos_available($resource.features.initiators, $initiator?.id)",
                        "computed": {
                          "default": "$axim.helper_axim_ini_get_default_qos($resource.features.initiators, $initiator?.id)"
                        }
                      },
                      {
                        "type": "enable",
                        "message": "Enable quality of service configuration when initiator is used",
                        "condition": "$item.use_channel"
                      }
                    ]
                  },
                  "write_qos": {
                    "type": "integer",
                    "title": "Write quality of service",
                    "description": "Set the write quality of service for this initiator.",
                    "minimum": 0,
                    "maximum": 15,
                    "actions": [
                      {
                        "type": "exclude",
                        "condition": "!$axim.helper_axim_ini_is_qos_available($resource.features.initiators, $initiator?.id) || !$axim.helper_axim_is_non_ip_component($initiator?.id) && !$get('peripheral.isPhysicallyAvailableInCurrentDevice', $initiator?.id)"
                      },
                      {
                        "type": "set",
                        "condition": "$axim.helper_axim_is_non_ip_component($initiator?.id) || $get('peripheral.isPhysicallyAvailableInCurrentDevice', $initiator?.id) && $axim.helper_axim_ini_is_qos_available($resource.features.initiators, $initiator?.id)",
                        "computed": {
                          "default": "$axim.helper_axim_ini_get_default_qos($resource.features.initiators, $initiator?.id)"
                        }
                      },
                      {
                        "type": "enable",
                        "message": "Enable quality of service configuration when initiator is used",
                        "condition": "$item.use_channel"
                      }
                    ]
                  },
                  "rw_iss": {
                    "title": "Override read/write issuing",
                    "type": "string",
                    "description": "When enabled, the read/write issuing capability for this initiator is overridden.",
                    "oneOf": [
                      {
                        "title": "None",
                        "const": "NORMAL"
                      },
                      {
                        "title": "Read",
                        "const": "OVERRIDE_READ"
                      },
                      {
                        "title": "Write",
                        "const": "OVERRIDE_WRITE"
                      },
                      {
                        "title": "Read and write",
                        "const": "OVERRIDE_BOTH"
                      }
                    ],
                    "actions": [
                      {
                        "type": "exclude",
                        "condition": "!$axim.helper_axim_is_non_ip_component($initiator?.id) && !$get('peripheral.isPhysicallyAvailableInCurrentDevice', $initiator?.id)"
                      },
                      {
                        "type": "enable",
                        "message": "Override read/write issuing when initiator is used",
                        "condition": "$item.use_channel"
                      }
                    ],
                    "default": "NORMAL"
                  },
                  "packing": {
                    "type": "boolean",
                    "title": "Packing",
                    "description": "Enable packing of beats to match the output data width.",
                    "actions": [
                      {
                        "type": "exclude",
                        "condition": "!$axim.helper_axim_ini_is_packing_available($resource.features.initiators, $initiator?.id)"
                      },
                      {
                        "type": "enable",
                        "message": "Enable packing when initiator is used",
                        "condition": "$item.use_channel"
                      }
                    ],
                    "default": true
                  },
                  "increment_override": {
                    "title": "Increment override",
                    "type": "string",
                    "description": "When enabled, the increment read/write for this initiator is overridden.",
                    "oneOf": [
                      {
                        "title": "None",
                        "const": "NORMAL"
                      },
                      {
                        "title": "Read",
                        "const": "OVERRIDE_READ"
                      },
                      {
                        "title": "Write",
                        "const": "OVERRIDE_WRITE"
                      },
                      {
                        "title": "Read and write",
                        "const": "OVERRIDE_BOTH"
                      }
                    ],
                    "actions": [
                      {
                        "type": "exclude",
                        "condition": "!$axim.helper_axim_ini_is_packing_available($resource.features.initiators, $initiator?.id)"
                      },
                      {
                        "type": "enable",
                        "message": "Increment override when initiator is used",
                        "condition": "$item.use_channel"
                      }
                    ],
                    "default": "NORMAL"
                  }
                }
              }
            },
            "targets": {
              "title" : "Interconnect targets",
              "rendering": "channel-tabs",
              "type": "array",
              "strictMaxItems": false,
              "source": "Array.from({ length: $resource.features.axi_targ_nb }, (_, i) => ({ id: i, name: $axim.helper_axim_get_element_name($resource.features.targets, i), idtitle: $axim.helper_axim_get_cpu_name($axim.helper_axim_get_element_name($resource.features.targets, i), $get('hwPlatform.device').cores[0].coreType) }))",
              "itemTitle": "idtitle",
              "itemId": "name",
              "itemVar":"target",
              "items": {
                "type": "object",
                "properties": {
                  "use_channel": {
                    "type": "boolean",
                    "title": "Modify target",
                    "actions": [
                      {
                        "type": "exclude",
                        "condition": "!$axim.helper_axim_is_non_ip_component($target.name) && !$get('peripheral.isPhysicallyAvailableInCurrentDevice', $target.name)"
                      }
                    ],
                    "default": false
                  },
                  "bm_rw_iss": {
                    "title": "Override bus matrix read/write issuing",
                    "type": "string",
                    "description": "When enabled, the bus matrix read/write issuing capability for this target is overridden.",
                    "oneOf": [
                      {
                        "title": "None",
                        "const": "NORMAL"
                      },
                      {
                        "title": "Read",
                        "const": "OVERRIDE_READ"
                      },
                      {
                        "title": "Write",
                        "const": "OVERRIDE_WRITE"
                      },
                      {
                        "title": "Read and write",
                        "const": "OVERRIDE_BOTH"
                      }
                    ],
                    "actions": [
                      {
                        "type": "exclude",
                        "condition": "!$axim.helper_axim_is_non_ip_component($target.name) && !$get('peripheral.isPhysicallyAvailableInCurrentDevice', $target.name)"
                      },
                      {
                        "type": "enable",
                        "message": "Override bus matrix read/write issuing when target is used",
                        "condition": "$item.use_channel"
                      }
                    ],
                    "default": "NORMAL"
                  },
                  "rw_iss": {
                    "title": "Override read/write issuing",
                    "type": "string",
                    "description": "When enabled, the read/write issuing capability for this target is overridden.",
                    "oneOf": [
                      {
                        "title": "None",
                        "const": "NORMAL"
                      },
                      {
                        "title": "Read",
                        "const": "OVERRIDE_READ"
                      },
                      {
                        "title": "Write",
                        "const": "OVERRIDE_WRITE"
                      },
                      {
                        "title": "Read and write",
                        "const": "OVERRIDE_BOTH"
                      }
                    ],
                    "actions": [
                      {
                        "type": "exclude",
                        "condition": "!$axim.helper_axim_is_non_ip_component($target.name) && !$get('peripheral.isPhysicallyAvailableInCurrentDevice', $target.name)"
                      },
                      {
                        "type": "enable",
                        "message": "Override read/write issuing when target is used",
                        "condition": "$item.use_channel"
                      }
                    ],
                    "default": "NORMAL"
                  },
                  "packing": {
                    "type": "boolean",
                    "title": "Packing",
                    "description": "Enable packing of beats to match the output data width.",
                    "actions": [
                      {
                        "type": "exclude",
                        "condition": "!$axim.helper_axim_targ_is_packing_available($resource.features.targets, $target?.name)"
                      },
                      {
                        "type": "enable",
                        "message": "Enable packing when target is used",
                        "condition": "$item.use_channel"
                      }
                    ],
                    "default": true
                  },
                  "long_burst": {
                    "type": "boolean",
                    "title": "Long burst",
                    "description": "Enable long bursts generation at the output of the target.",
                    "actions": [
                      {
                        "type": "exclude",
                        "condition": "!$axim.helper_axim_targ_is_packing_available($resource.features.targets, $target?.name)"
                      },
                      {
                        "type": "enable",
                        "message": "Enable long burst when target is used",
                        "condition": "$item.use_channel"
                      }
                    ],
                    "default": false
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}