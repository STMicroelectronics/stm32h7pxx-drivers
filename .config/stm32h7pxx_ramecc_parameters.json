{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:RAMECC",
  "grammarVersion": "3.8.0",
  "type": "object",
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "layer": {
              "type": "string",
              "title": "Software layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "default": "HAL",
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_RAMECC_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ]
            },
            "init_type": {
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "type": "string",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            },
            "note": {
              "title": "Note",
              "type": "string",
              "description": "Enable the ECC_ON_SRAM option bit to configure RAMECC.",
              "default": "Enable the ECC_ON_SRAM option bit to configure RAMECC.",
              "actions": [
                {
                  "type": "disable",
                  "condition": "true",
                  "message": "This note is informational and cannot be edited."
                }
              ]
            }
          }
        },
        "additional": {
          "title": "Advanced features",
          "type": "object",
          "properties": {
            "controller": {
              "title": "Controller",
              "type": "object",
              "properties": {
                "enable_ecc": {
                  "type": "boolean",
                  "title": "Error correction code",
                  "description": "Turn on ECC_ON_SRAM option bit to enable error correction code.",
                  "default": false
                },
                "enable_global_interrupt": {
                  "title": "Global interrupt",
                  "type": "boolean",
                  "description": "Enable all interrupts on all monitors.",
                  "default": false,
                  "actions": [
                    {
                      "type": "disable",
                      "condition": "!$additional.controller.enable_ecc",
                      "message": "This field is read-only because controller error correction code is disabled."
                    }
                  ]
                },
                "enable_single_interrupt": {
                  "title": "Single interrupt",
                  "type": "boolean",
                  "description": "Enable single ECC error interrupt on all monitors.",
                  "default": false,
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$additional.controller.enable_ecc && !$additional.controller.enable_global_interrupt",
                      "message": "This field is read-only because controller error correction code is disabled or global ECC error interrupt is enabled."
                    },
                    {
                      "type": "set",
                      "condition": "$additional.controller.enable_global_interrupt",
                      "attributes": {
                        "const": true
                      }
                    }
                  ]
                },
                "enable_double_interrupt": {
                  "title": "Double interrupt",
                  "type": "boolean",
                  "description": "Enable double ECC error interrupt on all monitors.",
                  "default": false,
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$additional.controller.enable_ecc && !$additional.controller.enable_global_interrupt",
                      "message": "This field is read-only because controller error correction code is disabled or global ECC error interrupt is enabled."
                    },
                    {
                      "type": "set",
                      "condition": "$additional.controller.enable_global_interrupt",
                      "attributes": {
                        "const": true
                      }
                    }
                  ]
                },
                "enable_double_on_byte_write_interrupt": {
                  "title": "Double on byte write interrupt",
                  "type": "boolean",
                  "description": "Enable interrupt for double ECC errors detected during byte writes on all monitors.",
                  "default": false,
                  "actions": [
                    {
                      "type": "enable",
                      "condition": "$additional.controller.enable_ecc && !$additional.controller.enable_global_interrupt",
                      "message": "This field is read-only because controller error correction code is disabled or global ECC error interrupt is enabled."
                    },
                    {
                      "type": "set",
                      "condition": "$additional.controller.enable_global_interrupt",
                      "attributes": {
                        "const": true
                      }
                    }
                  ]
                }
              }
            },
            "monitor": {
              "title": "Monitors",
              "type": "array",
              "rendering": "horizontal-list",
              "source": "$resource.resources.filter(element => (element.resourceType === 'assigned_resource'))",
              "itemId": "id",
              "itemVar": "element",
              "actions": [
                {
                  "type": "set",
                  "condition": "$resource.resources.filter(element => (element.resourceType === 'assigned_resource')).length === 1",
                  "attributes": {
                    "title": "Monitor"
                  }
                }
              ],
              "items": {
                "type": "object",
                "properties": {
                  "hw_instance": {
                    "title": "Name",
                    "type": "string",
                    "default": "",
                    "actions": [
                      {
                        "type": "disable",
                        "condition": "true",
                        "message": "This field is read-only and cannot be edited."
                      },
                      {
                        "type": "set",
                        "condition": "true",
                        "computed": {
                          "const": "$element.id"
                        }
                      }
                    ]
                  },
                  "enable_ecc": {
                    "title": "Error correction code",
                    "type": "boolean",
                    "description": "Turn on ECC_ON_SRAM option bit to enable error correction code.",
                    "default": false,
                    "actions": [
                      {
                        "type": "disable",
                        "condition": "$additional.controller.enable_ecc || $additional.controller.enable_global_interrupt || $additional.controller.enable_single_interrupt || $additional.controller.enable_double_interrupt || $additional.controller.enable_double_on_byte_write_interrupt",
                        "message": "This field is read-only because controller ECC error interrupts is used."
                      },
                      {
                        "type": "set",
                        "condition": "$additional.controller.enable_ecc",
                        "attributes": {
                          "const": true
                        }
                      }
                    ]
                  },
                  "enable_single_interrupt": {
                    "title": "Single interrupt",
                    "type": "boolean",
                    "default": false,
                    "actions": [
                      {
                        "type": "enable",
                        "condition": "$item.enable_ecc && !$additional.controller.enable_global_interrupt && !$additional.controller.enable_single_interrupt",
                        "message": "This field is read-only because monitor error correction code is disabled or controller ECC error interrupt is used."
                      },
                      {
                        "type": "set",
                        "condition": "$additional.controller.enable_global_interrupt || $additional.controller.enable_single_interrupt",
                        "attributes": {
                          "const": true
                        }
                      }
                    ]
                  },
                  "enable_double_interrupt": {
                    "title": "Double interrupt",
                    "type": "boolean",
                    "default": false,
                    "actions": [
                      {
                        "type": "enable",
                        "condition": "$item.enable_ecc && !$additional.controller.enable_global_interrupt && !$additional.controller.enable_double_interrupt",
                        "message": "This field is read-only because monitor error correction code is disabled or controller ECC error interrupt is used."
                      },
                      {
                        "type": "set",
                        "condition": "$additional.controller.enable_global_interrupt || $additional.controller.enable_double_interrupt",
                        "attributes": {
                          "const": true
                        }
                      }
                    ]
                  },
                  "enable_double_on_byte_write_interrupt": {
                    "title": "Double on byte write interrupt",
                    "type": "boolean",
                    "default": false,
                    "actions": [
                      {
                        "type": "enable",
                        "condition": "$item.enable_ecc && !$additional.controller.enable_global_interrupt && !$additional.controller.enable_double_on_byte_write_interrupt",
                        "message": "This field is read-only because monitor error correction code is disabled or controller ECC error interrupt is used."
                      },
                      {
                        "type": "set",
                        "condition": "$additional.controller.enable_global_interrupt || $additional.controller.enable_double_on_byte_write_interrupt",
                        "attributes": {
                          "const": true
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "system": {
          "title": "System",
          "type": "object",
          "properties": {
            "nvic": {
              "title": "NVIC",
              "type": "object",
              "properties": {
                "ramecc_interruption": {
                  "title": "Interrupt",
                  "type": "boolean",
                  "default": false
                },
                "irq_handler_generation": {
                  "title": "IRQ handler generation",
                  "type": "boolean",
                  "description": "Handles RAMECC interrupts when ECC errors occur in SRAM.",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($system.nvic.ramecc_interruption === true ) && ($info.layer === 'HAL')"
                    }
                  ]
                },
                "irq_config": {
                  "title": "IRQ line priority",
                  "type": "object",
                  "objectType": "need.interrupt.lines",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "($system.nvic.ramecc_interruption === true)"
                    }
                  ],
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}