{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:GPIO",
  "grammarVersion": "3.8",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/gpio_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ],
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": ""
              }
            },
            "layer": {
              "type": "string",
              "title": "Software layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_GPIO_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called",
              "actions": [
                {
                  "type": "set",
                  "condition": "$pins.length == 0",
                  "attributes": {
                    "const": "disabled"
                   }
                 }
               ]
            }
          }
        },
        "pins": {
          "type": "array",
          "title": "Pins",
          "source": "$resource.pins.map(p => { const labels = p.userLabels ? p.userLabels.filter(l => l !== p.name) : []; return { ...p, title: labels.length > 0 ? `${p.name} (${labels.join(', ')})` : p.name }; })",
          "itemId": "name",
          "itemTitle": "title",
          "itemVar": "resource",
          "items": {
            "type": "object",
            "configFor": ["need.pinout.signals"],
            "properties": {
              "label_name": {
                  "type": "array",
                  "title": "SW label for signal",
                  "items": {
                  "type": "string",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ],
                  "minLength": 0,
                  "maxLength": 32,
                  "unique": "project",
                  "default": ""
                }
              },
              "basic": {
                "type": "object",
                "title": "Main features",
                "description": "GPIO configuration structure definition.",
                "actions": [
                  {
                    "type": "include",
                    "condition": "$resource.signal.type!=='additional'"
                  }
                ],
                "properties": {
                  "mode": {
                    "type": "string",
                    "title": "Mode",
                    "description": "Specifies the operating mode for the selected pin.",
                    "oneOf": [
                      {
                        "title": "Input",
                        "const": "INPUT"
                      },
                      {
                        "title": "Output",
                        "const": "OUTPUT"
                      },
                      {
                        "title": "Alternate",
                        "const": "ALTERNATE",
                        "actions": [
                          {
                            "type": "include",
                            "condition": "$isNeed"
                          }
                        ]
                      },
                      {
                        "title": "Eventout",
                        "const": "EVENTOUT",
                        "actions": [
                          {
                            "type": "include",
                            "condition": "!$isNeed"
                          }
                        ]
                      },
                      {
                        "title": "Analog",
                        "const": "ANALOG"
                      }
                    ],
                    "default": "INPUT"
                  },
                  "pull": {
                    "type": "string",
                    "title": "Pull",
                    "description": "Specifies the Pull-up or Pull-Down activation for the selected pin.",
                    "oneOf": [
                      {
                        "title": "No pull-up and no pull-down",
                        "const": "NO"
                      },
                      {
                        "title": "Pull-up",
                        "const": "UP",
                        "actions": [
                          {
                            "type": "include",
                            "condition": "$config.basic.mode!=='ANALOG'"
                          }
                        ]
                      },
                      {
                        "title": "Pull-down",
                        "const": "DOWN"
                      }
                    ],
                    "actions": [
                      {
                        "type": "set",
                        "computed": {
                          "default": "$common.helper_gpio_get_default_pull($resource.port, $resource.index)"
                        }
                      }
                    ]
                  },
                  "output_init_state": {
                    "type": "string",
                    "title": "Initialization state",
                    "description": "Specifies the default output state.",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$config.basic.mode==='OUTPUT'"
                      }
                    ],
                    "oneOf": [
                      {
                        "title": "Low",
                        "const": "RESET"
                      },
                      {
                        "title": "High",
                        "const": "SET"
                      }
                    ],
                    "default": "RESET"
                  },
                  "output_active_state": {
                    "type": "string",
                    "title": "Active state",
                    "description": "Specifies the active output state.",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$config.basic.mode==='OUTPUT'"
                      }
                    ],
                    "oneOf": [
                      {
                        "title": "Low",
                        "const": "RESET"
                      },
                      {
                        "title": "High",
                        "const": "SET"
                      }
                    ],
                    "default": "SET"
                  },
                  "speed": {
                    "type": "string",
                    "title": "Speed",
                    "description": "Specifies the speed for the selected pin.",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$config.basic.mode==='OUTPUT' || $config.basic.mode==='ALTERNATE' || $config.basic.mode==='EVENTOUT'"
                      },
                      {
                        "type": "set",
                        "computed": {
                          "default": "$common.helper_gpio_get_default_speed($resource.port, $resource.index)"
                        }
                      },
                      {
                        "type": "info",
                        "condition": "true",
                        "message": "GPIO speed depends on several electrical parameters, such as HSLV activation and the value of C(L). For further information, refer to the datasheet."
                      }
                    ],
                    "oneOf": [
                      {
                        "title": "Low",
                        "const": "LOW"
                      },
                      {
                        "title": "Medium",
                        "const": "MEDIUM"
                      },
                      {
                        "title": "High",
                        "const": "HIGH"
                      },
                      {
                        "title": "Very high",
                        "const": "VERY_HIGH"
                      }
                    ]
                  },
                  "output_type": {
                    "type": "string",
                    "title": "Output type",
                    "description": "Specifies the operating output type for the selected pin.",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$config.basic.mode==='OUTPUT' || $config.basic.mode==='ALTERNATE' || $config.basic.mode==='EVENTOUT'"
                      }
                    ],
                    "oneOf": [
                      {
                        "title": "Push pull",
                        "const": "PUSHPULL"
                      },
                      {
                        "title": "Open drain",
                        "const": "OPENDRAIN"
                      }
                    ],
                    "default": "PUSHPULL"
                  },
                  "enable_exti": {
                    "type": "boolean",
                    "title": "EXTI",
                    "description": "Specifies whether EXTI is enabled or disabled for the selected pin.",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$config.basic.mode!=='ANALOG'"
                      }
                    ],
                    "default": false
                  },
                  "exti_config": {
                    "title": "EXTI",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$config.basic.enable_exti"
                      }
                    ],
                    "type": "object",
                    "objectType": "need.exti.lines",
                    "variables": [
                        {
                            "on": "update-value",
                            "name": "HAL_EXTI_PROJECT_USE_HAL",
                            "condition": "(!$isNeed && $info?.layer !== 'LL') || ($isNeed && ($getRootParameter('layer') === 'HAL'))",
                            "semaphore": true
                        }
                    ],
                    "owner": "$resource.id",
                    "needs": [
                      {
                        "selector": "*"
                      }
                    ]
                  }
                }
              },
              "additional": {
                "type": "object",
                "title": "Advanced features",
                "actions": [
                  {
                    "type": "include",
                    "condition": "($resource.signal.type!=='additional') && ((($resource.ioStructureOptions.indexOf('h')!==-1) && ($config.basic.mode!=='ANALOG')) || $common.helper_gpio_get_retime_cfg($get('peripheral.hardwareIpDescription', 'GPIO' + $resource.port)?.features?.RETIME_CFG, $resource.index))"
                  }
                ],
                "properties": {
                  "high_speed_low_voltage": {
                    "type": "boolean",
                    "title": "High speed low voltage",
                    "description": "Specifies whether high speed low voltage feature is enabled or disabled for the selected pin.",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "($resource.ioStructureOptions.indexOf('h')!==-1) && ($config.basic.mode!=='ANALOG')"
                      },
                      {
                        "type": "warning",
                        "condition": "$value",
                        "message": "It must be used only if the I/O supply voltage is below 2.7 V."
                      }
                    ],
                    "variables": [
                      {
                        "on": "update-value",
                        "name": "HAL_GPIO_CORE_USE_HSLV",
                        "condition": "$value",
                        "value": true
                      }
                    ],
                    "default": false
                  },
                  "advanced_io": {
                    "type": "boolean",
                    "title": "Advanced IO",
                    "description": "Specifies whether Advanced IO feature is enabled or disabled for the selected pin.",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$common.helper_gpio_get_retime_cfg($get('peripheral.hardwareIpDescription', 'GPIO' + $resource.port)?.features?.RETIME_CFG, $resource.index)"
                      }
                    ],
                    "default": false
                  },
                  "delay": {
                    "type": "integer",
                    "title": "Delay",
                    "description": "Specifies the delay for the selected pin in picoseconds.",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$item.additional.advanced_io"
                      }
                    ],
                    "oneOf": [
                      {
                        "title": "0",
                        "const": 0
                      },
                      {
                        "title": "300",
                        "const": 300
                      },
                      {
                        "title": "500",
                        "const": 500
                      },
                      {
                        "title": "750",
                        "const": 750
                      },
                      {
                        "title": "1000",
                        "const": 1000
                      },
                      {
                        "title": "1250",
                        "const": 1250
                      },
                      {
                        "title": "1500",
                        "const": 1500
                      },
                      {
                        "title": "1750",
                        "const": 1750
                      },
                      {
                        "title": "2000",
                        "const": 2000
                      },
                      {
                        "title": "2250",
                        "const": 2250
                      },
                      {
                        "title": "2500",
                        "const": 2500
                      },
                      {
                        "title": "2750",
                        "const": 2750
                      },
                      {
                        "title": "3000",
                        "const": 3000
                      },
                      {
                        "title": "3250",
                        "const": 3250
                      }
                    ],
                    "default": 0
                  },
                  "delay_path": {
                    "type": "string",
                    "title": "Delay path",
                    "description": "Specifies the delay path for the selected pin.",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$item.additional.advanced_io"
                      },
                      {
                        "type": "enable",
                        "condition": "($item.additional.delay!==0)",
                        "message": "Delay path is available when delay is different from 0."
                      }
                    ],
                    "oneOf": [
                      {
                        "title": "Output",
                        "const": "OUT"
                      },
                      {
                        "title": "Input",
                        "const": "IN"
                      }
                    ],
                    "default": "OUT"
                  },
                  "retime": {
                    "type": "boolean",
                    "title": "Retime",
                    "description": "Specifies whether retime feature is enabled or disabled for the selected pin.",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$item.additional.advanced_io"
                      }
                    ],
                    "default": false
                  },
                  "retime_configuration": {
                    "type": "string",
                    "title": "Retime",
                    "description": "Specifies the retime edge for the selected pin.",
                    "actions": [
                      {
                        "type": "include",
                        "condition": "$item.additional.retime"
                      }
                    ],
                    "oneOf": [
                      {
                        "title": "Rising",
                        "const": "RISING"
                      },
                      {
                        "title": "Falling",
                        "const": "FALLING"
                      },
                      {
                        "title": "Rising and falling",
                        "const": "RISING_FALLING"
                      }
                    ],
                    "default": "RISING"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
