{
  "$schema": "http://json-schema.org/draft-07/schema",
  "version": "0.0.1",
  "componentid": "::Device:STM32CubeMX2 Config:FMAC",
  "grammarVersion": "3.8",
  "type": "object",
  "functions": [
    {
      "path": ".config/template/helpers/fmac_helpers.js",
      "accessor": "common"
    }
  ],
  "properties": {
    "parameters": {
      "type": "object",
      "properties": {
        "info": {
          "type": "object",
          "title": "General information",
          "properties": {
            "labels": {
              "type": "array",
              "title": "Add a label",
              "description": "Labels allow to create aliases inside mx_hal_def.h file like '<label>_init', '<label>_deinit' and '<label>_gethandle'. These aliases can be used on application side.",
              "items": {
                "type": "string",
                "minLength": 0,
                "maxLength": 32,
                "unique": "project",
                "default": "",
                "actions": [
                  {
                    "type": "error",
                    "condition": "!/^[A-Za-z_][A-Za-z0-9_]*$/.test($value)",
                    "message": "Name must be a valid C identifier: start with a letter or underscore, and contain only letters, digits, or underscores."
                  }
                ]
              }
            },
            "layer": {
              "type": "string",
              "title": "Software layer",
              "oneOf": [
                {
                  "title": "HAL",
                  "const": "HAL"
                },
                {
                  "title": "LL",
                  "const": "LL"
                }
              ],
              "variables": [
                {
                  "on": "update-value",
                  "name": "HAL_FMAC_PROJECT_USE_HAL",
                  "condition": "$value === 'HAL'",
                  "semaphore": true
                }
              ],
              "default": "HAL"
            },
            "init_type": {
              "type": "string",
              "title": "Resource initialization code generation",
              "description": "Pick whether the initialization code should be generated and automatically called at startup.",
              "oneOf": [
                {
                  "title": "Callable",
                  "const": "called",
                  "description": "Initialization code is generated and called in peripheral initialization."
                },
                {
                  "title": "Generated",
                  "const": "enabled",
                  "description": "Initialization code is generated but not called in peripheral initialization."
                },
                {
                  "title": "Not generated",
                  "const": "disabled",
                  "description": "Initialization code is not generated."
                }
              ],
              "default": "called"
            },
            "explanation": {
              "type": "string",
              "readOnly": true,
              "title": "Short description",
              "default": "The X1 and X2 buffers are used to store data for input to the FMAC.\nEach multiplication takes a value from the X1 buffer and a value from the X2 buffer and multiplies them together.\nThe Y (output) buffer is used to store the output of an accumulation.\nEach new output value is stored in the Y buffer until it is read by the processor or DMA controller"
            }
          }
        },
        "basic": {
          "type": "object",
          "title": "Main features",
          "properties": {
            "buff_x1": {
              "type": "object",
              "title": "Input buffer X1",
              "description": "X1 buffer is used to store data for input to the FMAC.",
              "properties": {
                "base_half_word": {
                  "type": "integer",
                  "title": "Base",
                  "description": "Base address within the FMAC internal 16-bit memory (0x00 to 0xFF).",
                  "minimum": 0,
                  "maximum": 255,
                  "default": 0,
                  "display_format": [
                    "hex"
                  ]
                },
                "size_half_word": {
                  "type": "integer",
                  "title": "Size",
                  "description": "The number of 16-bit addresses allocated to the X1 buffer.",
                  "minimum": 0,
                  "maximum": 255,
                  "default": 0
                }
              }
            },
            "buff_x2": {
              "type": "object",
              "title": "Input buffer X2",
              "description": "X2 buffer is used to store data for input to the FMAC.",
              "properties": {
                "base_half_word": {
                  "type": "integer",
                  "title": "Base",
                  "description": "Base address within the FMAC internal 16-bit memory (0x00 to 0xFF).",
                  "minimum": 0,
                  "maximum": 255,
                  "default": 0,
                  "display_format": [
                    "hex"
                  ],
                  "actions": [
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "default": "$common.helper_fmac_autofill_base($basic.buff_x1.base_half_word, 0, $basic.buff_x1.size_half_word)"
                      }
                    }
                  ]
                },
                "size_half_word": {
                  "type": "integer",
                  "title": "Size",
                  "description": "The number of 16-bit addresses allocated to the X2 buffer.",
                  "minimum": 0,
                  "maximum": 255,
                  "default": 0
                }
              }
            },
            "buff_y": {
              "type": "object",
              "title": "Output buffer Y",
              "description": "Y buffer is used to store the output of an accumulation.",
              "properties": {
                "base_half_word": {
                  "type": "integer",
                  "title": "Base",
                  "description": "Base address within the FMAC internal 16-bit memory (0x00 to 0xFF).",
                  "minimum": 0,
                  "maximum": 255,
                  "default": 0,
                  "display_format": [
                    "hex"
                  ],
                  "actions": [
                    {
                      "type": "set",
                      "condition": "true",
                      "computed": {
                        "default": "$common.helper_fmac_autofill_base($basic.buff_x1.base_half_word, 0, $basic.buff_x1.size_half_word)"
                      }
                    }
                  ]
                },
                "size_half_word": {
                  "type": "integer",
                  "title": "Size",
                  "description": "The number of 16-bit addresses allocated to the Y buffer.",
                  "minimum": 0,
                  "maximum": 255,
                  "default": 0
                }
              }
            }
          }
        },
        "additional": {
          "type": "object",
          "title": "Advanced features",
          "properties": {
            "watermark": {
              "type": "object",
              "title": "Watermark",
              "properties": {
                "x1_full": {
                  "type": "integer",
                  "title": "X1 full watermark threshold",
                  "default": 1,
                  "oneOf": [
                    {
                      "title": "1 half word",
                      "const": 1
                    },
                    {
                      "title": "2 half word",
                      "const": 2
                    },
                    {
                      "title": "4 half word",
                      "const": 3
                    },
                    {
                      "title": "8 half word",
                      "const": 4
                    }
                  ]
                },
                "y_empty": {
                  "type": "integer",
                  "title": "Y empty watermark threshold",
                  "default": 1,
                  "oneOf": [
                    {
                      "title": "1 half word",
                      "const": 1
                    },
                    {
                      "title": "2 half word",
                      "const": 2
                    },
                    {
                      "title": "4 half word",
                      "const": 3
                    },
                    {
                      "title": "8 half word",
                      "const": 4
                    }
                  ]
                }
              }
            },
            "clipping_range": {
              "type": "boolean",
              "title": "Clipping q1.15 range",
              "description": "When you enable clipping, the accumulator saturates its output. If a value exceeds the q1.15 range, the FMAC outputs +1 or -1 depending on the sign. When clipping is disabled, it truncates the extra accumulator bits after applying the gain.",
              "default": false
            }
          }
        },
        "security_privilege": {
          "title": "Security and privilege",
          "description": "Manage security and privileged access levels attributes.",
          "#comment": "Use for instance for FMAC",
          "type": "object",
          "actions": [
            {
              "type": "exclude",
              "condition": "($get('swproject.getCurrentEngine') === null) || ($get('swproject.getCurrentEngine').secure === 'TZ-disabled')"
            },
            {
              "type": "set",
              "condition": "$get('swproject.getCurrentEngine').secure === 'Non-secure'",
              "attributes": {
                "title": "Privileged",
                "description": "Manage privileged access levels attributes."
              }
            }
          ],
          "properties": {
            "security": {
              "type": "string",
              "title": "Security attribute",
              "description": "Set the security attribute of the securable peripheral.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "SEC"
                  },
                  "condition": "$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "set",
                  "attributes": {
                    "const": "NSEC"
                  },
                  "condition": "!$get('peripheral.isBound', $resource.id)"
                },
                {
                  "type": "disable",
                  "condition": "$get('peripheral.isBound', $resource.id)",
                  "message": "The security attribute of the peripheral is automatically set to secure when the peripheral is bound to a secure resource and to non-secure when it is not. Manual configuration is not allowed."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-sec-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Secure",
                  "const": "SEC"
                },
                {
                  "title": "Non-secure",
                  "const": "NSEC"
                }
              ],
              "default": "NSEC"
            },
            "privilege": {
              "type": "string",
              "title": "Privileged attribute",
              "description": "Set the privilege attribute of a securable RISC peripheral.",
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-priv-attr",
                "custom": "$resource.id"
              },
              "oneOf": [
                {
                  "title": "Privileged",
                  "const": "PRIV"
                },
                {
                  "title": "Unprivileged",
                  "const": "NPRIV"
                }
              ],
              "default": "PRIV"
            },
            "lock": {
              "type": "boolean",
              "title": "Lock",
              "description": "Optional. Lock security and privilege attributes to prevent changes.",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-risc-peripheral-lock-attr",
                "custom": "$resource.id"
              },
              "default": false
            },
            "illegal_access": {
              "title": "Illegal access interrupt",
              "type": "boolean",
              "actions": [
                {
                  "type": "include",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure') || ($get('swproject.getCurrentEngine').secure === 'Secure-only')"
                },
                {
                  "type": "disable",
                  "condition": "($get('swproject.getCurrentEngine').secure === 'Secure-only')",
                  "message": "Secure-only mode: The illegal access interrupt is always disabled."
                }
              ],
              "synchronize": true,
              "synchronizeOn": {
                "component": "ST-HAL",
                "path": "rif-iac-peripheral",
                "custom": "$resource.id"
              },
              "default": false
            }
          }
        },
        "system": {
          "type": "object",
          "title": "System",
          "properties": {
            "dma": {
              "type": "object",
              "title": "DMA",
              "properties": {
                "enable_dma_write": {
                  "type": "boolean",
                  "title": "Write X1 DMA request",
                  "default": false
                },
                "dma_config_write": {
                  "title": "DMA write",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.dma.enable_dma_write"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "wr",
                      "constraints": {
                        "direction": {
                          "const": "MEMORY_TO_PERIPH"
                        },
                        "src_inc": {
                          "const": "INCREMENTED"
                        },
                        "dest_inc": {
                          "const": "FIXED"
                        },
                        "src_data_width": {
                          "const": "HALFWORD"
                        },
                        "dest_data_width": {
                          "const": "HALFWORD"
                        },
                        "priority": {
                          "const": "HIGH"
                        }
                      }
                    }
                  ]
                },
                "enable_dma_read": {
                  "type": "boolean",
                  "title": "Read Y DMA request",
                  "default": false
                },
                "dma_config_read": {
                  "title": "DMA read",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.dma.enable_dma_read"
                    }
                  ],
                  "type": "object",
                  "objectType": "need.dma.channels",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_DMA_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "rd",
                      "constraints": {
                        "direction": {
                          "const": "PERIPH_TO_MEMORY"
                        },
                        "src_inc": {
                          "const": "FIXED"
                        },
                        "dest_inc": {
                          "const": "INCREMENTED"
                        },
                        "src_data_width": {
                          "const": "HALFWORD"
                        },
                        "dest_data_width": {
                          "const": "HALFWORD"
                        },
                        "priority": {
                          "const": "HIGH"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "nvic": {
              "type": "object",
              "title": "NVIC",
              "properties": {
                "enable_interruption": {
                  "type": "boolean",
                    "title": "Interrupt",
                  "default": false
                },
                "irq_handler_generation": {
                  "type": "boolean",
                  "title": "IRQ handler generation",
                  "default": true,
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption && $info.layer === 'HAL'"
                    }
                  ]
                },
                "nvic_config": {
                  "type": "object",
                  "title": "NVIC",
                  "actions": [
                    {
                      "type": "include",
                      "condition": "$system.nvic.enable_interruption"
                    }
                  ],
                  "objectType": "need.interrupt.lines",
                  "variables": [
                    {
                      "on": "update-value",
                      "name": "HAL_CORTEX_PROJECT_USE_HAL",
                      "condition": "$info.layer === 'HAL'",
                      "semaphore": true
                    }
                  ],
                  "owner": "$resource.id",
                  "needs": [
                    {
                      "selector": "*"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}