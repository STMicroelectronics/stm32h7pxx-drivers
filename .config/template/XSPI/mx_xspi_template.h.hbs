/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{@root.current_resource}}_H
#define MX_{{@root.current_resource}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{#each @root.instances}}
{{assign 'xspi_cxt' config~}}
{{/each}}
{{assign 'include_mx_def' false~}}
{{#with @root.xspi_cxt.security_privilege}}
{{#unless @root.include_mx_def}}
{{~assign 'include_mx_def' true~}}
#include "mx_def.h"
{{/unless}}
{{/with}}
{{#unless @root.include_mx_def}}
{{#if (gt @root.codegen_ctxt.init_model 0)}}
#include "mx_def.h"
{{/if}}
{{/unless}}
#include "stm32_hal.h"

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#each @root.instances}}
{{assign 'xspi_cxt' config~}}
{{assign 'current_resource' current_resource~}}
{{assign 'current_layer' @root.xspi_cxt.info.layer~}}
{{helper_gpio_generate_aliases @root.pinoutAPI @root.current_resource @root.current_layer~}}
{{helper_dma_generate_channel_aliases @root.current_resource @root.DmaAPI @root.SWConfigurationAPI~}}
{{/each}}

/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{helper_common_initialize_index~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{#each @root.instances}}
{{assign 'xspi_cxt' config~}}
{{assign 'current_resource' current_resource~}}
{{assign 'current_layer' @root.xspi_cxt.info.layer~}}
{{assign 'configs' @root.xspi_cxt~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
/******************************************************************************/
/* Exported functions for XSPI in {{@root.current_layer}} layer */
/******************************************************************************/
{{#with @root.configs}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index)~}}
{{assign 'current_index' (helper_common_inc_index @root.current_resource)~}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  * @retval pointer to handle or NULL in case of failure
  */
hal_xspi_handle_t *{{@root.fct_name}}_init(void);

{{> GPIO_HAL fct='init_resource_independently' resource=@root.current_resource init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}

/**
  * @brief  De-initialize {{lowercase @root.current_resource}} instance and return it.
  */
void {{@root.fct_name}}_deinit(void);

{{#with security_privilege}}
{{#if (eq @root.getCurrentEngine.secure 'Non-secure')}}
/**
  * @brief Peripheral privilege configuration function
  * @retval system_status_t
  */
system_status_t {{@root.fct_name}}_config_privilege(void);
{{else}}
/**
  * @brief Peripheral security and privilege configuration function
  * @retval system_status_t
  */
system_status_t {{@root.fct_name}}_config_security_privilege(void);
{{/if}}

{{/with}}

{{/with}}

{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
/**
  * @brief  Get the {{@root.current_resource}} object.
  * @retval Pointer on the {{@root.current_resource}} Handle
  */
hal_xspi_handle_t *{{@root.fct_name}}_gethandle(void);

{{> GPIO_HAL fct='gpio_exti_gethandle' resource=@root.current_resource type='prototype'}}

{{#with @root.xspi_cxt}}
{{#with system}}
{{#with dma}}
{{#if enable_dma_tx}}
{{> DMA_HAL fct='init_independently' needs=dma_config_tx.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}
{{/if}}
{{#if enable_dma_rx}}
{{> DMA_HAL fct='init_independently' needs=dma_config_rx.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}
{{/if}}
{{/with}}
{{/with}}
{{/with}}

{{/each}}
{{> CORTEX fct='generate_irqhandler' type='prototype' component='XSPI'}}

