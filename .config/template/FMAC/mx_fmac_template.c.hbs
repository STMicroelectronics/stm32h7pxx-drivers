{{#helper_common_beautifier}}
{{assign "codegen_ctxt" (helper_common_get_codegen_context 'FMAC' (get '') @root.EnvVarAPI @root.peripheralsResourceManagerAPI @root.SWConfigurationAPI)~}}
{{log "FMAC template codegen_ctxt:" @root.codegen_ctxt~}}
{{assign 'strategy' @root.codegen_ctxt.strategy~}}
{{assign 'current_resource' @root.codegen_ctxt.current_resource~}}
{{assign 'instances' @root.codegen_ctxt.instances~}}
{{assign 'dma_resource' @root.codegen_ctxt.dma_resource~}}
{{> SYSTEM fct='system_check_ll_optim'}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.current_resource}}.c
  * @brief          : {{@root.current_resource}} Peripheral initialization
{{> LICENSE}}

/* Includes ------------------------------------------------------------------*/
#include "mx_{{lowercase @root.current_resource}}.h"
{{> RCC fct='include_rcc'}}

/* Private typedef -----------------------------------------------------------*/
/* Private define ------------------------------------------------------------*/
/* Private macros ------------------------------------------------------------*/
/* Private variables ---------------------------------------------------------*/
/* Private functions prototype------------------------------------------------*/
/* Exported variables by reference--------------------------------------------*/
{{assign 'hal_handle_exist' 0~}}
{{#each @root.instances~}}
  {{~assign 'fmac_cxt' config~}}
  {{~log "FMAC template fmac_cxt:" (toJSON @root.fmac_cxt)~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' @root.fmac_cxt.info.layer~}}
  {{~log "FMAC template current_resource:" @root.current_resource~}}
  {{#if (eq @root.current_layer 'HAL')}}
    {{#if (eq @root.hal_handle_exist 0)}}
static hal_fmac_handle_t h{{@root.current_resource}};
    {{~assign 'hal_handle_exist' 1}}
    {{/if}}
{{> DMA_HAL fct='get_dma_handles' resource=@root.current_resource strategy=@root.strategy}}
  {{else}}
{{> DMA_LL fct='get_dma_lli_variables' resource=@root.current_resource strategy=@root.strategy}}
  {{/if}}
{{/each}}

{{assign 'hal_handle_exist' 0~}}
{{assign 'nvic_context' 'undefined'~}}
{{#each @root.instances}}
  {{~assign 'fmac_cxt' config~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' @root.fmac_cxt.info.layer~}}
{{assign 'lut_table'   (helper_fmac_get_lut_table)~}}
{{helper_common_initialize_ll_code @root.optim_enable @root.lut_table @root.current_resource~}}
/******************************************************************************/
/* Exported functions for {{@root.current_resource}} in {{@root.current_layer}} layer */
/******************************************************************************/

{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer 0)~}}
  {{#with @root.fmac_cxt}}
{{#if (eq @root.current_layer 'HAL')}}
{{!
    Generation of initialization function used in HAL
~}}
{{> FMAC_HAL fct='init'}}

{{!
    Generation of de-initialization function used in HAL
~}}
{{> FMAC_HAL fct='deinit'}}

{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
{{!
    Generation of getHandle functions used in HAL
~}}
hal_fmac_handle_t *{{@root.fct_name}}_gethandle(void)
{
  return &h{{@root.current_resource}};
}

{{else}}{{! eq @root.current_layer 'LL' ~}}
{{assign 'nvic_generate_handler' false~}}
{{!
    Generation of initialization function used in LL
~}}
{{> FMAC_LL fct='init'}}
{{!
    Generation of initialization function used in LL
~}}
{{> FMAC_LL fct='deinit'}}
{{> DMA_LL fct='get_dma_lli_reg' resource=@root.current_resource strategy=@root.strategy type='implementation'}}
{{/if}}
{{#if (eq @root.current_layer 'HAL')}}
{{#if (eq @root.hal_handle_exist 0)}}
{{assign 'hal_handle_exist' 1~}}
{{/if}}
{{/if}}

    {{#with security_privilege}}
      {{~assign 'getCurrentEngine' (@root.SwComposerAPI.getCurrentEngine)~}}
      {{#if (eq @root.getCurrentEngine.secure 'Non-secure')}}
system_status_t {{@root.fct_name}}_config_privilege(void)
      {{else}}
system_status_t {{@root.fct_name}}_config_security_privilege(void)
      {{/if}}
{
  /*
    Full access security path:
    - Enable clock for RIF/RCC peripherals
    - Configure the security/privilege items for FMAC peripheral
    - other FMAC systems security/privilege configuration if any (DMA)
    */

{{#> RIF fct='rif_config_security' layer=@root.current_layer resource=@root.current_resource}}{{/RIF}}
{{#> GTZC fct='gtzc_config_security' layer=@root.current_layer resource=@root.current_resource}}{{/GTZC}}

      {{#if (eq @root.current_layer 'HAL')~}}
{{#> DMA_HAL fct='dma_config_security' resource=@root.current_resource}}{{/DMA_HAL}}
      {{else}}
{{#> DMA_LL fct='dma_config_security' resource=@root.current_resource}}{{/DMA_LL}}
      {{/if}}

  return SYSTEM_OK;
}
    {{/with}}

{{#with system}}
{{#if (eq @root.current_layer 'HAL')}}
{{#with dma}}
{{#if enable_dma_write}}
{{> DMA_HAL fct='init_independently' needs=dma_config_write.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='implementation'}}

{{/if}}
{{#if enable_dma_read}}
{{> DMA_HAL fct='init_independently' needs=dma_config_read.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='implementation'}}

{{/if}}
{{/with}}{{! dma ~}}
{{else}}
{{#with dma}}
{{#if enable_dma_write}}
{{> DMA_LL fct='init_independently' needs=dma_config_write.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='implementation'}}

{{/if}}
{{#if enable_dma_read}}
{{> DMA_LL fct='init_independently' needs=dma_config_read.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='implementation'}}

{{/if}}
{{/with}}{{! dma ~}}
{{/if}}
{{/with}}{{! system}}

  {{/with}}
{{/each}}

{{> CORTEX fct='generate_irqhandler' type='implementation' component='FMAC'}}
{{/helper_common_beautifier}}
