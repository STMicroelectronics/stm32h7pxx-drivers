{{#helper_common_beautifier}}
{{assign "codegen_ctxt" (helper_common_get_codegen_context 'FMAC' (get '') @root.EnvVarAPI @root.peripheralsResourceManagerAPI @root.SWConfigurationAPI)~}}
{{log "FMAC template codegen_ctxt:" @root.codegen_ctxt~}}
{{assign 'strategy' @root.codegen_ctxt.strategy~}}
{{assign 'current_resource' @root.codegen_ctxt.current_resource~}}
{{assign 'file_name' @root.codegen_ctxt.current_resource~}}
{{assign 'instances' @root.codegen_ctxt.instances~}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.file_name}}.h
  * @brief          : Header for mx_{{lowercase @root.file_name}}.c file.
{{> LICENSE}}


/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{@root.file_name}}_H
#define MX_{{@root.file_name}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{assign 'only_ll' true~}}
{{assign 'include_mx_def' false~}}
{{#each @root.instances~}}
  {{~assign 'fmac_cxt' config~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' @root.fmac_cxt.info.layer~}}
  {{#if (eq @root.current_layer 'HAL')}}
    {{~assign 'only_ll' false~}}
  {{/if}}
{{/each}}
{{#with @root.fmac_cxt.security_privilege}}
{{#unless @root.include_mx_def}}
{{~assign 'include_mx_def' true~}}
#include "mx_def.h"
{{/unless}}
  {{/with}}

{{#unless @root.include_mx_def}}
  {{#if (gt @root.codegen_ctxt.init_model 0)}}
#include "mx_def.h"
  {{/if}}
{{/unless}}
{{#if @root.only_ll}}
#include "stm32_ll.h"
{{else}}
#include "stm32_hal.h"
{{/if}}

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#each @root.instances}}
{{~assign 'fmac_cxt' config~}}
{{~assign 'current_resource' current_resource~}}
{{~assign 'current_layer' @root.fmac_cxt.info.layer~}}
{{#if (eq @root.current_layer 'LL')}}
#define USE_{{uppercase @root.current_resource}}
{{/if}}
{{helper_dma_generate_channel_aliases @root.current_resource @root.DmaAPI @root.SWConfigurationAPI~}}
{{/each}}

/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{helper_common_initialize_index~}}
{{assign 'current_index' (helper_common_get_index @root.current_resource)~}}
{{#each @root.instances}}
  {{~assign 'fmac_cxt' config~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' @root.fmac_cxt.info.layer~}}
{{assign 'configs' @root.fmac_cxt~}}
/******************************************************************************/
/* Exported functions for FMAC in {{@root.current_layer}} layer */
/******************************************************************************/

{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index @root.current_function @root.from_where)~}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  * @retval pointer to handle or NULL in case of failure
  */
{{#if (eq @root.current_layer 'HAL')}}
hal_fmac_handle_t *{{@root.fct_name}}_init(void);
{{else}}
FMAC_TypeDef *{{@root.fct_name}}_init(void);
{{/if}}

/**
  * @brief  De-initialize {{lowercase @root.current_resource}} instance and return it.
  */
void {{@root.fct_name}}_deinit(void);

  {{#with @root.fmac_cxt.security_privilege}}
    {{#if (eq @root.getCurrentEngine.secure 'Non-secure')}}
/**
  * @brief Peripheral privilege configuration function
  * @retval system_status_t
  */
system_status_t {{@root.fct_name}}_config_privilege(void);
    {{else}}
/**
  * @brief Peripheral security and privilege configuration function
  * @retval system_status_t
  */
system_status_t {{@root.fct_name}}_config_security_privilege(void);
    {{/if}}

  {{/with}}
{{#if (eq @root.current_layer 'HAL')}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
/**
  * @brief  Get the {{@root.current_resource}} object.
  * @retval Pointer on the {{@root.current_resource}} Handle
  */
hal_fmac_handle_t *{{@root.fct_name}}_gethandle(void);
{{#with @root.fmac_cxt.system.dma}}
{{#if enable_dma_write}}
{{> DMA_HAL fct='init_independently' needs=dma_config_write.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}
{{/if}}
{{#if enable_dma_read}}
{{> DMA_HAL fct='init_independently' needs=dma_config_read.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}
{{/if}}
{{/with}}{{! dma ~}}
{{else}}
{{> DMA_LL fct='get_dma_lli_reg' resource=@root.current_resource strategy=@root.strategy type='prototype'}}
{{#with @root.fmac_cxt.system.dma}}
{{#if enable_dma_write}}
{{> DMA_LL fct='init_independently' needs=dma_config_write.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}
{{/if}}
{{#if enable_dma_read}}
{{> DMA_LL fct='init_independently' needs=dma_config_read.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}
{{/if}}
{{/with}}{{! dma ~}}
{{/if}}
{{/each}}

{{> CORTEX fct='generate_irqhandler' type='prototype' component='FMAC'}}

#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_{{@root.file_name}}_H */
{{/helper_common_beautifier}}
