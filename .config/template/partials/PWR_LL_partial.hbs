{{~log "PWR_LL_partial generation started"~}}
{{~log "PWR root="@root~}}
{{~helper_pwr_globalize_API @root~}}
{{~assign 'pwr_context' (helper_pwr_get_context 'STMicroelectronics::Device:STM32CubeMX2 Config:PWR')~}}
{{~log "PWR_LL_partial generate_main_supply_config: pwr_context="@root.pwr_context~}}
{{~assign "ll_pwr_partial_modules_activated" (helper_pwr_add_analog_module (@root.peripheralsResourceManagerAPI.getPeripheralsBoundToSoftwareInstances))~}}
{{#if (not (inArray @root.ll_pwr_partial_modules_activated 'PWR'))}}
  {{~assign 'rcc_context' (helper_pwr_get_context 'STMicroelectronics::Device:STM32CubeMX2 Config:RCC')~}}
  {{~log "PWR_LL_partial generate_main_supply_config: rcc_context="@root.rcc_context~}}
  {{~assign 'ucpd_context' (helper_pwr_get_context 'STMicroelectronics::Device:STM32CubeMX2 Config:UCPD')~}}
  {{~log "PWR_LL_partial generate_main_supply_config: ucpd_context="@root.ucpd_context~}}
{{/if}}
{{!
  * @file Partial used to generate LL code for PWR:
  * @license
  * @attention
  *
  * Copyright (c) 2026 STMicroelectronics.
  * All rights reserved.
  *
  * This software is licensed under terms that can be found in the LICENSE file
  * in the root directory of this software component.
  * If no LICENSE file comes with this software, it is provided AS-IS.
  *
  *
  * how to use
  * > PWR_LL fct='xxxx' with xxxx:
  *   * generate_main_supply_config
  *   * generate_vos_config
  *   * generate_write_protection_disable
  *   * generate_write_protection_enable
  *   * generate_pull_standby periph="[I3C, XSPI]" gpio="PXXX"(e.g PA1 PC12) pull="[PULL_NO, PULL_UP, PULL_DOWN]"
  *   * exported_functions_init
  *   * exported_functions_deinit
~}}
{{!
############################
##  exported_variables
############################
~}}
{{#if (eq fct 'generate_main_supply_config')}}
{{!
 No main supply configuration on this series
~}}
{{else if (eq fct 'generate_vos_config')~}}
{{!
 Generate the PWR LL code to configure the voltage scaling
~}}
  {{#if (inArray @root.ll_pwr_partial_modules_activated 'PWR')}}
  /* Configure the Voltage scaling level */
  {{helper_common_gen_ll_code 'LL_PWR_SetRegulatorVoltageScaling' (concat 'LL_PWR_REGU_' @root.pwr_context.additional.main_supply_configuration.voltage_scaling)}}

  {{else}}
  /* Configure the Voltage scaling level */
  {{helper_common_gen_ll_code 'LL_PWR_SetRegulatorVoltageScaling' (concat 'LL_PWR_REGU_' @root.rcc_context.basic.voltage_scaling)}}

  {{/if}}
    {{#if (not (eq @root.pwr_context.additional.main_supply_configuration.mcu_main_supply 'BYPASSED'))}}
  /* Poll on VOS ready and Active VOS ready flag to reach correct voltage */
  while((LL_PWR_IsActiveFlag_VOS() == 0U) || (LL_PWR_IsActiveFlag_ACTVOS() == 0U));
  {{/if}}
{{else if (eq fct 'generate_write_protection_disable')}}
{{!
 Generate the PWR LL code to disable the RTC/Backup Domain Write protection
}}
{{!> PWR_LL fct='generate_write_protection_disable'}}
  /* Disable Backup Domain Write Protection */
  LL_PWR_DisableBackupDomainWriteProtection();
{{else if (eq fct 'generate_write_protection_enable')}}
{{!
 Generate the PWR LL code to enable the RTC/Backup Domain Write protection
}}
{{!> PWR_LL fct='generate_write_protection_enable'}}
  /* In order to simplify the code generation and management for the user, the write protection is not enabled by
     default. In real case application, we advise to enable it once all the necessary configurations are done. */
  /* Enable Backup Domain Write Protection */
  /* LL_PWR_EnableBackupDomainWriteProtection(); */
{{else if (eq fct 'generate_pull_standby')}}
{{! > PWR_LL fct='generate_pull_standby' periph="[I3C, XSPI]" gpio="PXXX"(e.g PA1 PC12) pull="[PULL_NO, PULL_UP, PULL_DOWN]"}}
{{!
 Generate the PWR LL code to configure pull of a specific GPIO during standby
~}}
  {{~log "PWR_LL_partial generate_pull_standby input periph ="periph}}
  {{~log "PWR_LL_partial generate_pull_standby input gpio  ="gpio}}
  {{~log "PWR_LL_partial generate_pull_standby input pull ="pull}}
  /* Set GPIO {{gpio}} for peripheral {{periph}} in {{pull}} config, effective only after LL_PWR_EnablePUPDConfig call */
  {{#if (eq periph 'I3C')}}
    {{#if (eq pull 'PULL_NO')}}
  {{helper_common_gen_ll_code 'LL_PWR_DisableI3CPullUp' (concat 'LL_PWR_I3C_PULLUP_' gpio)}}
    {{else if (eq pull 'PULL_UP')}}
  LL_PWR_EnableI3CPullUp(LL_PWR_I3C_PULLUP_{{gpio}});
    {{/if}}
  {{/if}}
  {{#if (eq periph 'XSPI')}}
    {{#if (eq pull 'PULL_NO')}}
  {{helper_common_gen_ll_code 'LL_PWR_DisableXSPIPullUp' (concat 'LL_PWR_XSPI_PULLUP_' gpio)}}
  {{helper_common_gen_ll_code 'LL_PWR_DisableXSPIPullDown' (concat 'LL_PWR_XSPI_PULLUP_' gpio)}}
    {{else if (eq pull 'PULL_UP')}}
  LL_PWR_EnableXSPIPullUp(LL_PWR_XSPI_PULLUP_{{gpio}});
  {{helper_common_gen_ll_code 'LL_PWR_DisableXSPIPullDown' (concat 'LL_PWR_XSPI_PULLUP_' gpio)}}
    {{else if (eq pull 'PULL_DOWN')}}
  {{helper_common_gen_ll_code 'LL_PWR_DisableXSPIPullUp' (concat 'LL_PWR_XSPI_PULLUP_' gpio)}}
  LL_PWR_EnableXSPIPullDown(LL_PWR_XSPI_PULLUP_{{gpio}});
    {{/if}}
  {{/if}}
{{else if (eq fct 'exported_functions_init')}}
{{!
    Generation of initialization function used in LL
}}
system_status_t {{@root.pwr_root_fct_name}}_init(void)
{
  {{#if (length @root.pins_configs)}}
    {{~assign "wkup_pin_conc_max" (helper_pwr_get_max_wakeup_settings_pin_num @root.pins_configs)~}}
    {{#if (gt @root.wkup_pin_conc_max 1)}}
{{! Content to display if length > 1, initialize parameters for wkuppin management~}}
      {{~assign "wkup_pin_init" (helper_pwr_get_ll_wkup_pin_codegen_init 'H7P')~}}
      {{{@root.wkup_pin_init}}}
    {{else}}
{{! nothing to display if length <= 1~}}
    {{/if}}
  {{/if}}
  {{#> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}
  {{/RCC}}
  {{#with additional}}
    {{#if (and (not (eq @root.codegen_ctxt.init_model 1)) (or (eq status_pins_configuration.enable_csleep true)(eq status_pins_configuration.enable_cstop true)(eq status_pins_configuration.enable_srdstop true)(and (eq voltage_detection_configuration.pvd_configuration.enable true)(eq voltage_detection_configuration.pvd_configuration.level_selection '8'))))}}
  /****************************************************************************/
  /* GPIO configuration                                                       */
  /****************************************************************************/
      {{#> GPIO_LL fct='init_resource' resource=@root.current_resource return_if_failed='SYSTEM_POWER_ERROR' init_model=@root.codegen_ctxt.init_model fct_name=@root.pwr_root_fct_name~}}
      {{/GPIO_LL}}

    {{/if}}
    {{#with main_supply_configuration}}
      {{#if (or stop_voltage_scaling (not (inArray @root.modules_activated 'RCC')))}}
  /****************************************************************************/
  /* Main supply configuration                                                */
  /****************************************************************************/
        {{#if (not (inArray @root.modules_activated 'RCC'))}}
          {{#> PWR_LL fct='generate_vos_config'~}}
          {{/PWR_LL}}

        {{/if}}
        {{#if stop_voltage_scaling}}
  /* Stop Voltage scaling configuration */
  {{helper_common_gen_ll_code  'LL_PWR_SetStopRegulatorVoltageScaling' (concat 'LL_PWR_REGU_STOP_' stop_voltage_scaling)}}

        {{/if}}
      {{/if}}
    {{/with}}
    {{#with independent_supply_configuration}}
      {{#if (or enable_vddusb_supply (and (not (inArray @root.modules_activated 'ANALOG')) (or (eq analog_io_switch_supply 'VDDA_SUPPLY') (eq analog_io_switch_supply 'BOOSTER_SUPPLY') (eq analog_io_switch_supply 'VDD_SUPPLY'))))}}
  /****************************************************************************/
  /* Independent supply configuration                                         */
  /****************************************************************************/
        {{#if enable_vddusb_supply}}
          {{#if (not (or (inArray @root.modules_activated 'USB_DRD_FS.HOST') (inArray @root.modules_activated 'USB_DRD_FS.DEVICE')))}}
            {{#> PWR_LL fct='generate_peripheral_supply_activation' hw_resource='USB' ~}}
            {{/PWR_LL}}

          {{/if}}
        {{/if}}
        {{#if (and (not (inArray @root.modules_activated 'ANALOG')) (not (eq analog_io_switch_supply 'NONE')))}}
          {{#> PWR_LL fct='generate_peripheral_supply_activation' hw_resource='ADC'}}
          {{/PWR_LL}}

        {{/if}}
      {{/if}}
    {{/with}}
    {{#with voltage_detection_configuration}}
      {{#if pvd_configuration.enable}}
  /****************************************************************************/
  /* Configuration of PVD (Programmable Voltage Detector)                     */
  /****************************************************************************/
        {{#with pvd_configuration}}
          {{#if level_selection}}
            {{~assign 'voltage_reference' (helper_pwr_get_pvdin_or_vdd_level level_selection (@root.peripheralsResourceManagerAPI.getHardwareIpDescription "PWR"))~}}
            {{!~ Line break because of the helper above}}
  /* Configure PVD Level */
  {{helper_common_gen_ll_code 'LL_PWR_SetPVDLevel' (concat 'LL_PWR_PVD_' @root.voltage_reference)}}

          {{/if}}
  /* Enable PVD */
  LL_PWR_EnablePVD();

          {{#if (eq enable_exti true)}}
  /* Configure PVD EXTI Line */
            {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.pvd_exti_needs}}
            {{/EXTI}}
          {{/if}}
        {{/with}}
      {{/if}}
      {{#if avd_configuration.enable}}
  /****************************************************************************/
  /* Configuration of AVD (Analog Voltage Detector)                           */
  /****************************************************************************/
        {{#with avd_configuration}}
          {{#if level_selection}}
  /* Configure AVD Level */
  {{helper_common_gen_ll_code 'LL_PWR_SetAVDLevel' (concat 'LL_PWR_AVD_VDDA_LEVEL_' level_selection)}}


          {{/if}}
  /* Enable AVD */
  LL_PWR_EnableAVD();

          {{#if (eq enable_exti true)}}
  /* Configure AVD EXTI Line */
            {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.avd_exti_needs}}
            {{/EXTI}}
          {{/if}}
        {{/with}}
      {{/if}}
      {{#if (eq enable_exti true)}}
  /* Configure PVD/AVD EXTI Line */
        {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.pvd_avd_exti_needs}}
        {{/EXTI}}
      {{/if}}
      {{#if temperature_vbat_monitoring.enable}}
  /****************************************************************************/
  /* Configuration of VBAT/Temp monitor                                       */
  /****************************************************************************/
        {{#> PWR_LL fct='generate_write_protection_disable'}}
        {{/PWR_LL}}

  /* Enable VBAT/Temp monitoring */
  LL_PWR_EnableTemperatureVbatMonitor();

        {{#> PWR_LL fct='generate_write_protection_enable'}}
        {{/PWR_LL}}
      {{/if}}
      {{#if temperature_vdd_monitoring.enable}}
  /****************************************************************************/
  /* Configuration of VDD/Temp monitor                                        */
  /****************************************************************************/
        {{#> PWR_LL fct='generate_write_protection_disable'}}
        {{/PWR_LL}}

  /* Enable VDD/Temp monitoring */
  LL_PWR_EnableTemperatureVddMonitor();

        {{#> PWR_LL fct='generate_write_protection_enable'}}
        {{/PWR_LL}}
      {{/if}}
    {{/with}}
    {{#with ram_configuration}}
      {{#if (length @root.sram_configs)}}
  /****************************************************************************/
  /* Configuration of RAM retention                                           */
  /****************************************************************************/
        {{#each @root.sram_configs}}
          {{#unless pageStatus}}
            {{#if fullretention}}
              {{#if (eq mode 'STANDBY_VBAT')}}
                {{#> PWR_LL fct='generate_write_protection_disable'}}
                {{/PWR_LL}}

  /* For {{sram}} in standby mode, retention is enabled */
  LL_PWR_EnableBackupRegulator();

                {{#> PWR_LL fct='generate_write_protection_enable'}}
                {{/PWR_LL}}
              {{else}}
  /* For {{sram}} in {{lowercase mode}} mode, memory retention is disabled */
  LL_PWR_DisableMemoryStopRetention(LL_PWR_{{sram}}_{{mode}}_RETENTION);
              {{/if}}

            {{else}}
              {{#if pageDefinesStr}}
                {{#if enabledPagesStr}}
  /* For {{sram}} in {{lowercase mode}} mode, retention is enabled only for pages {{enabledPagesStr}} */
                {{else}}
  /* For {{sram}} in {{lowercase mode}} mode, memory retention is disabled on all pages */
                {{/if}}
  uint32_t pages = {{pageDefinesStr}};
  LL_PWR_Disable{{sram}}PagesStopRetention(pages);

              {{/if}}
            {{/if}}
          {{/unless}}
        {{/each}}
      {{/if}}
    {{/with}}
    {{#if flash_low_power_configuration.enable_flash_low_power_mode}}
  /****************************************************************************/
  /* Configuration of FLASH low power mode                                    */
  /****************************************************************************/
  LL_PWR_EnableFlashLowPWRMode();

    {{/if}}
    {{#if nvm_low_power_configuration.enable_nvm_low_power_mode}}
  /****************************************************************************/
  /* Configuration of NVM low power mode                                      */
  /****************************************************************************/
  LL_PWR_EnableNVMLowPWRMode();

    {{/if}}
    {{#if battery_configuration.enable_battery_charging}}
  /****************************************************************************/
  /* Configuration of the battery charging management                         */
  /****************************************************************************/
  /* Configure battery charging resistor value */
  {{helper_common_gen_ll_code 'LL_PWR_SetBattChargResistor' (concat 'LL_PWR_BATT_CHARG_RESISTOR_' (uppercase battery_configuration.battery_charging_resistor_selection))}}

  /* Enable battery charging */
  LL_PWR_EnableBatteryCharging();

    {{/if}}
    {{#with ucpd_configuration}}
  /****************************************************************************/
  /* Configuration of the UCPD (USB Type-C and Power Delivery) PWR features   */
  /****************************************************************************/
      {{#if (not (inArray @root.modules_activated 'UCPD1'))}}
        {{#> PWR_LL fct='manage_dead_battery'}}
        {{/PWR_LL}}
      {{/if}}
      {{#if enable_ucpd_config_retention}}
  /* Enable UCPD configuration retention in Standby mode */
  {{helper_common_gen_ll_code 'LL_PWR_EnableUCPDRetentionStandbyMode'}}

      {{else}}
        {{#if (eq @root.PWR_ctx.runtime.mode 'STANDBY_MODE')}}
  /* This bit must be written to 1 just before entering Standby mode when using UCPD,
  and it must be written to 0 after exiting the standby mode and before writing any UCPD register */
        {{/if}}
  /* Disable UCPD configuration retention in Standby mode */
  {{helper_common_gen_ll_code 'LL_PWR_DisableUCPDRetentionStandbyMode'}}

      {{/if}}
    {{/with}}
    {{~assign 'enabled_pins' ''~}}
    {{#with wakeup_pins_configuration}}
      {{~assign 'pull_availability' (helper_pwr_pull_or_source @root.pins_configs)~}}
      {{~helper_pwr_breakpoint (length @root.pins_configs) @root~}}
      {{#if (length @root.pins_configs)}}
  /****************************************************************************/
  /* Wake-up pins configuration                                               */
  /****************************************************************************/
        {{~helper_pwr_breakpoint @root.pull_availability @root}}
        {{#each @root.pins_configs}}
          {{#if (gt pinsnum 1)}}
  {{! Content to display if length > 1, pins concanated management }}
            {{#if @root.pull_availability}}
  /* Configuration of selected wake-up pins with pull {{pull}} and {{polarity}} polarity */
              {{~assign 'pull_core_code' (helper_pwr_get_ll_wkup_pin_codegen_core 'H7P' pins (concat 'LL_PWR_WAKEUP_PIN_POLARITY_' polarity) (concat 'LL_PWR_WAKEUP_PIN_PULL_' pull))}}
            {{else}}
  /* Configuration of selected wake-up pins with {{source}} and {{polarity}} polarity */
              {{~assign 'pull_core_code' (helper_pwr_get_ll_wkup_pin_codegen_core 'H7P' pins (concat 'LL_PWR_WAKEUP_PIN_POLARITY_' polarity) '' (concat 'LL_PWR_WAKEUP_PIN_SELECTION_' source))}}
            {{/if~}}
            {{{@root.pull_core_code}}}

          {{else}}
  {{! content to display if length <= 1, pins not concanated management }}
            {{#if @root.pull_availability}}
  /* Configuration of selected wake-up pins with pull {{pull}} and {{polarity}} polarity */
  {{helper_common_gen_ll_code 'LL_PWR_SetWakeUpPinPolarity' pins (concat 'LL_PWR_WAKEUP_PIN_POLARITY_' polarity)}}
  {{helper_common_gen_ll_code 'LL_PWR_SetWakeUpPinPull' pins (concat 'LL_PWR_WAKEUP_PIN_PULL_' pull)}}

            {{else}}
  /* Configuration of selected wake-up pins with {{source}} and {{polarity}} polarity    */
  {{helper_common_gen_ll_code 'LL_PWR_SetWakeUpPinPolarity' pins (concat 'LL_PWR_WAKEUP_PIN_POLARITY_' polarity)}}
  {{helper_common_gen_ll_code 'LL_PWR_SetWakeupPinSelection'pins (concat 'LL_PWR_WAKEUP_PIN_SELECTION_' source)}}

            {{/if}}
          {{/if}}
          {{~assign 'enabled_pins' (helper_pwr_concatenate_pins pins @root.enabled_pins)~}}
        {{/each}}
        {{~assign 'enabled_pins' (helper_pwr_reorder_pins @root.enabled_pins)~}}
      {{/if}}
      {{#if (and wkup_1_configuration.enable wkup_1_configuration.enable_exti)}}
  /* Configure wake-up pin 1 EXTI line */
      {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.wkup1_exti_needs~}}
      {{/EXTI}}

      {{/if}}
      {{#if (and wkup_2_configuration.enable wkup_2_configuration.enable_exti)}}
  /* Configure wake-up pin 2 EXTI line */
      {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.wkup2_exti_needs~}}
      {{/EXTI}}

      {{/if}}
      {{#if (and wkup_3_configuration.enable wkup_3_configuration.enable_exti)}}
  /* Configure wake-up pin 3 EXTI line */
      {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.wkup3_exti_needs~}}
      {{/EXTI}}

      {{/if}}
      {{#if (and wkup_4_configuration.enable wkup_4_configuration.enable_exti)}}
  /* Configure wake-up pin 4 EXTI line */
      {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.wkup4_exti_needs~}}
      {{/EXTI}}

      {{/if}}
      {{#if (and wkup_5_configuration.enable wkup_5_configuration.enable_exti)}}
  /* Configure wake-up pin 5 EXTI line */
      {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.wkup5_exti_needs~}}
      {{/EXTI}}

      {{/if}}
      {{#if (and wkup_6_configuration.enable wkup_6_configuration.enable_exti)}}
  /* Configure wake-up pin 6 EXTI line */
      {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.wkup6_exti_needs~}}
      {{/EXTI}}

      {{/if}}
      {{#if (and wkup_7_configuration.enable wkup_7_configuration.enable_exti)}}
  /* Configure wake-up pin 7 EXTI line */
      {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.wkup7_exti_needs~}}
      {{/EXTI}}

      {{/if}}
      {{#if (and wkup_8_configuration.enable wkup_8_configuration.enable_exti)}}
  /* Configure wake-up pin 8 EXTI line */
      {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.wkup8_exti_needs~}}
      {{/EXTI}}

      {{/if}}
      {{#unless (eq @root.enabled_pins '')}}
  /****************************************************************************/
  /* Enable all configured wake-up pins                                       */
  /****************************************************************************/
  LL_PWR_EnableWakeUpPin({{@root.enabled_pins}});

      {{/unless}}
    {{/with}}
    {{#with io_retention}}
      {{#if (or (eq all_io true)(eq jtag_io true))}}
  /****************************************************************************/
  /* Configuration of I/O retention in standby mode                           */
  /****************************************************************************/
      {{/if}}
      {{#if all_io}}
  /* Enable I/O retention mode for all I/Os except standby I/Os and PA13, PA14, PA15, PB4 pins */
  LL_PWR_EnableIORetentionStandbyMode();

      {{/if}}
      {{#if jtag_io}}
  /* Enable I/O retention mode for PA13, PA14, PA15, and PB4 */
  LL_PWR_EnableJTAGIORetentionStandbyMode();

      {{/if}}
    {{/with}}
  return SYSTEM_OK;
  {{/with}}
}

{{!
############################
##  exported_functions_deinit
############################
~}}
{{else if (eq fct 'exported_functions_deinit')}}
system_status_t {{@root.pwr_root_fct_name}}_deinit(void)
{
  {{#> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}
  {{/RCC}}
  {{#with additional}}
    {{#if (or (eq status_pins_configuration.enable_csleep true)(eq status_pins_configuration.enable_cstop true)(eq status_pins_configuration.enable_srdstop true)(and (eq voltage_detection_configuration.pvd_configuration.enable true)(eq voltage_detection_configuration.pvd_configuration.level_selection '8')))}}
  /****************************************************************************/
  /* Status pin GPIO Deinitialization                                         */
  /****************************************************************************/
      {{#> GPIO_LL fct='deinit_resource' resource=@root.current_resource}}
      {{/GPIO_LL}}
    {{/if}}
    {{#unless (eq @root.enabled_pins '')}}
  /****************************************************************************/
  /* Disable all configured wake-up pins                                      */
  /****************************************************************************/
  LL_PWR_DisableWakeUpPin({{@root.enabled_pins}});

    {{/unless}}
    {{#with voltage_detection_configuration}}
      {{#if pvd_configuration.enable}}
        {{#if (eq pvd_configuration.enable_exti true)}}
  /* Deinit PVD EXTI Line */
          {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.pvd_exti_needs}}
          {{/EXTI}}
        {{/if}}
      {{/if}}
      {{#if avd_configuration.enable}}
        {{#if (eq avd_configuration.enable_exti true)}}
  /* Deinit AVD EXTI Line */
          {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.avd_exti_needs}}
          {{/EXTI}}
        {{/if}}
      {{/if}}
      {{#if (eq enable_exti true)}}
  /* Deinit PVD/AVD EXTI Line */
        {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.pvd_avd_exti_needs}}
        {{/EXTI}}
      {{/if}}
    {{/with}}
    {{#with wakeup_pins_configuration}}
      {{#if (and wkup_1_configuration.enable wkup_1_configuration.enable_exti)}}
  /* Deinit wake-up 1 EXTI line */
        {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.wkup1_exti_needs}}
        {{/EXTI}}

      {{/if}}
      {{#if (and wkup_2_configuration.enable wkup_2_configuration.enable_exti)}}
  /* Deinit wake-up 2 EXTI line */
        {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.wkup2_exti_needs}}
        {{/EXTI}}

      {{/if}}
      {{#if (and wkup_3_configuration.enable wkup_3_configuration.enable_exti)}}
  /* Deinit wake-up 3 EXTI line */
        {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.wkup3_exti_needs}}
        {{/EXTI}}

      {{/if}}
      {{#if (and wkup_4_configuration.enable wkup_4_configuration.enable_exti)}}
  /* Deinit wake-up 4 EXTI line */
        {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.wkup4_exti_needs}}
        {{/EXTI}}

      {{/if}}
      {{#if (and wkup_5_configuration.enable wkup_5_configuration.enable_exti)}}
  /* Deinit wake-up 5 EXTI line */
        {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.wkup5_exti_needs}}
        {{/EXTI}}

      {{/if}}
      {{#if (and wkup_6_configuration.enable wkup_6_configuration.enable_exti)}}
  /* Deinit wake-up 6 EXTI line */
        {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.wkup6_exti_needs}}
        {{/EXTI}}

      {{/if}}
      {{#if (and wkup_7_configuration.enable wkup_7_configuration.enable_exti)}}
  /* Deinit wake-up 7 EXTI line */
        {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.wkup7_exti_needs}}
        {{/EXTI}}

      {{/if}}
      {{#if (and wkup_8_configuration.enable wkup_8_configuration.enable_exti)}}
  /* Deinit wake-up 8 EXTI line */
        {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.wkup8_exti_needs}}
        {{/EXTI}}

      {{/if}}
    {{/with}}
    {{#with independent_supply_configuration}}
      {{#if enable_vddusb_supply}}
        {{#if (not (or (inArray @root.modules_activated 'USB_DRD_FS.HOST') (inArray @root.modules_activated 'USB_DRD_FS.DEVICE')))}}
          {{#> PWR_LL fct='generate_peripheral_supply_deactivation' hw_resource='USB' ~}}
          {{/PWR_LL}}

        {{/if}}
      {{/if}}
    {{/with}}
  {{/with}}
  return SYSTEM_OK;
}

