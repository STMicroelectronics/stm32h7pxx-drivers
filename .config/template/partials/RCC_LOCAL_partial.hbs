{{>RCC_LOCAL fct='generate_enable_osc_with_checks' osc=@root.pll_src_name direct=direct nb_resources=1 display_message=false}}{{! Only one PLL using the source ~}}
    {{/if~}}

    {{!  Generate the PLL config and enable ~}}
    {{~assign 'pll_name' (concat 'pll' pll_info.idx)}}
    {{~#if (not (helper_rcc_is_resource_enabled @root.pll_name))}}
{{>RCC_LOCAL fct='generate_pll_config_enable'}}
      {{~#if (not (helper_rcc_is_central @root.rcc_ctx))}}
  RCC_CONSUME_RESOURCE({{@root.pll_name}}, 1);
      {{/if~}}
    {{~helper_rcc_set_resource_enabled @root.pll_name}}
    {{else if display_message}}
  /* PLL{{pll_info.idx}} already configured and enabled inside {{@root.rcc_root_fct_name}}_init() */
    {{/if}}
  {{else}}
  if (mx_rcc_pll{{pll_info.idx}}_config() != SYSTEM_OK)
  {
    return SYSTEM_CLOCK_ERROR;
  }
  {{/if~}}

{{else if (eq fct 'generate_pll_config_enable')}}
{{!  Generate the pll config and enable code ~}}
{{!> RCC fct='generate_pll_config_enable' pll_info=@root.system_config.pll_used.PLLx}}

  {{#with pll_info}}
    {{~#if (eq @root.current_layer 'HAL')}}
  hal_rcc_pll_config_t config_pll{{idx}};
  config_pll{{idx}}.pll_source      = HAL_RCC_PLL_SRC_{{config.src}};
  config_pll{{idx}}.pll_m           = {{config.m}}U;
  config_pll{{idx}}.pll_n           = {{config.n}}U;
  config_pll{{idx}}.pll_p           = {{config.p}}U;
  config_pll{{idx}}.pll_q           = {{config.q}}U;
  config_pll{{idx}}.pll_r           = {{config.r}}U;
  config_pll{{idx}}.pll_s           = {{config.s}}U;
  config_pll{{idx}}.pll_t           = {{config.t}}U;
  config_pll{{idx}}.pll_fracn       = {{config.fracn}}U;
  config_pll{{idx}}.pll_input_range = HAL_RCC_PLL_INPUT_RANGE_{{config.input_range}};
  config_pll{{idx}}.pll_vco_range   = HAL_RCC_PLL_VCO_RANGE_{{config.vco_range}};
  config_pll{{idx}}.pll_sscg_state  = HAL_RCC_PLL_SSCG_DISABLE;
  if (HAL_RCC_PLL{{idx}}_SetConfig(&config_pll{{idx}}) != HAL_OK)
  {
    return SYSTEM_CLOCK_ERROR;
  }

  if (HAL_RCC_PLL{{idx}}_Enable() != HAL_OK)
  {
    return SYSTEM_CLOCK_ERROR;
  }
    {{else}}
  LL_RCC_PLL_SetSource(LL_RCC_PLLSOURCE_{{config.src}});
  LL_RCC_PLL{{idx}}_SetM({{config.m}}U);
  LL_RCC_PLL{{idx}}_SetN({{config.n}}U);
  LL_RCC_PLL{{idx}}_SetP({{config.p}}U);
      {{#if @root.do_rcc_ll_optim}}
  {{helper_common_gen_ll_code (concat 'LL_RCC_PLL' idx '_SetQ') (concat config.q 'U')}}
        {{#if (or (eq idx 2) (eq idx 3))}}
  {{helper_common_gen_ll_code (concat 'LL_RCC_PLL' idx '_SetR') (concat config.r 'U')}}
        {{/if}}
  {{helper_common_gen_ll_code (concat 'LL_RCC_PLL' idx '_SetS') (concat config.s 'U')}}
        {{#if (eq idx 2)}}
  {{helper_common_gen_ll_code (concat 'LL_RCC_PLL' idx '_SetT') (concat config.t 'U')}}
        {{/if}}
        {{#if (gt config.fracn 0)}}
  LL_RCC_PLL{{idx}}_SetFRACN({{config.fracn}}U);
  LL_RCC_PLL{{idx}}_EnableFRACN();

        {{/if}}
  {{helper_common_gen_ll_code (concat 'LL_RCC_PLL' idx '_SetInputRange') (concat 'LL_RCC_PLL' idx 'INPUTRANGE_' config.input_range)}}
  {{helper_common_gen_ll_code (concat 'LL_RCC_PLL' idx '_SetVCORange') (concat 'LL_RCC_PLL' idx 'VCORANGE_' config.vco_range)}}

      {{else}}
  LL_RCC_PLL{{idx}}_SetQ({{config.q}}U);
        {{#if (or (eq idx 2) (eq idx 3))}}
  LL_RCC_PLL{{idx}}_SetR({{config.r}}U);
        {{/if}}
  LL_RCC_PLL{{idx}}_SetS({{config.s}}U);
        {{#if (eq idx 2)}}
  LL_RCC_PLL{{idx}}_SetT({{config.t}}U);
        {{/if}}

  LL_RCC_PLL{{idx}}_DisableFRACN();
        {{#if (gt config.fracn 0)}}
  LL_RCC_PLL{{idx}}_SetFRACN({{config.fracn}}U);
  LL_RCC_PLL{{idx}}_EnableFRACN();
        {{else}}
  LL_RCC_PLL{{idx}}_SetFRACN(0U);
        {{/if}}

  LL_RCC_PLL{{idx}}_SetInputRange(LL_RCC_PLL{{idx}}INPUTRANGE_{{config.input_range}});
  LL_RCC_PLL{{idx}}_SetVCORange(LL_RCC_PLL{{idx}}VCORANGE_{{config.vco_range}});

      {{/if}}
  LL_RCC_PLL{{idx}}_Enable();
  {{~> SYSTEM fct='system_timeout_loop' timing='2UL' return_if_failed='SYSTEM_CLOCK_ERROR'}}
  while (LL_RCC_PLL{{idx}}_IsReady() != 1U);

    {{/if}}
  {{/with}}

