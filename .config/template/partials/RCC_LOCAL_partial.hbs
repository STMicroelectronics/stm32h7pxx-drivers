        {{~assign 'return_if_failed' 'SYSTEM_CLOCK_ERROR'~}}
      {{/if}}
  LL_RCC_SetSysClkSource(LL_RCC_SYS_CLKSOURCE_{{@root.system_clock_name_ll}});
  /* Wait till System clock is ready */
  {{~> SYSTEM fct='system_timeout_loop' timing='5000UL' return_if_failed=@root.return_if_failed}}
  while (LL_RCC_GetSysClkSource() != LL_RCC_SYS_CLKSOURCE_STATUS_{{@root.system_clock_name_ll}});
