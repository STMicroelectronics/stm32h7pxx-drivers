{{#each needs}}
{{assign 'dma_config' (@root.DmaAPI.getNeedById id)~}}
{{/each}}
{{log "DMA_LL fct='init' dma_config:" @root.dma_config~}}
  {{assign 'dma_channel_instance' @root.dma_config.resourceId~}}
  {{assign 'dma_parent' (helper_dma_get_parent @root.dma_channel_instance)~}}
  {{assign 'dma_config_owner' @root.dma_config.owner~}}
  {{assign 'dma_config_selector' @root.dma_config.selector~}}
{{#if (eq fct 'init')}}
{{! }}
{{! Generate the DMA code inside the PPPi init function}}
{{! > DMA_LL fct='init' needs=dma_config_tx.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name independent_init_call=true}}
{{! independent_init_call is an optional parameter to indicate if the init code is generated in an independent function or not. If true, the clock activation code will be generated.}}
{{! }}
  {{~assign 'independent_init_call' independent_init_call~}}
  {{~assign 'init_model' init_model~}}
  {{#if (eq @root.init_model undefined)}}
    {{~assign 'init_model' 0~}}
  {{/if}}
{{#if (eq @root.init_model 0)}}
  /* ################################################## {{@root.dma_config_owner}}{{#unless (eq @root.dma_config_selector 'GLOBAL')}} {{@root.dma_config_selector}}{{/unless}} DMA configuration */

{{#if (or (helper_dma_clock_should_enable @root.dma_parent @root.dma_config_owner 'init' false) @root.independent_init_call)}}
  /* Enable {{@root.dma_parent}} clock */{{! ~}}
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.dma_parent~}}
{{assign 'independent_init_call' false~}}
{{/if}}
{{#with @root.dma_config.configuration}}
  {{#with basic}}
    {{~assign 'dma_transfer_mode' dma_mode~}}
    {{~assign 'dma_node' (concat (uppercase request.id) '_LLi_reg')~}}

  {{! Initialize LL optimization context with DMA channel instance if LUT available }}
  {{> SYSTEM fct='system_check_ll_optim'}}
  {{assign 'lut_table'   (helper_dma_get_lut_table 'DMA3')~}}
  {{log "DMA_LL init: optim_enable=" @root.optim_enable " lut_table=" (toJSON @root.lut_table)~}}
  {{helper_common_initialize_ll_code @root.optim_enable @root.lut_table 'undefined'~}}
  {{helper_common_gen_ll_code_add_subinst @root.dma_channel_instance~}}
  {{/with}}
{{/with}}

{{#if (eq @root.dma_transfer_mode 0)}}{{! Direct mode with PPP}}
{{#with @root.dma_config.configuration}}
  {{#with basic}}
      {{#if request}}
        {{~assign 'req' (helper_dma_get_request @root.dma_channel_instance @root.current_layer request.id)}}
  /* Configure DMA channel transfer request */
  LL_DMA_SetPeriphRequest({{@root.dma_channel_instance}}, {{@root.req}});

      {{/if}}
  /* Configure DMA channel transfer direction */
  {{helper_common_gen_ll_code_subinst 'LL_DMA_SetDataTransferDirection' (concat 'LL_DMA_DIRECTION_' direction)}}

  /* Configure DMA channel priority level */
  {{helper_common_gen_ll_code_subinst 'LL_DMA_SetChannelPriorityLevel' (concat 'LL_DMA_PRIORITY_' priority )}}

  /* Configure DMA channel transfer register 1 */
  LL_DMA_ConfigTransfer({{@root.dma_channel_instance}},
                        (LL_DMA_SRC_ADDR_{{src_inc}} | LL_DMA_SRC_DATA_WIDTH_{{src_data_width}} | \
                         LL_DMA_DEST_ADDR_{{dest_inc}} | LL_DMA_DEST_DATA_WIDTH_{{dest_data_width}}));

  /* Configure DMA channel hardware request mode */
  {{#if (helper_dma_is_hw_request_block request)}}
  {{helper_common_gen_ll_code_subinst 'LL_DMA_SetHWRequestMode' 'LL_DMA_HARDWARE_REQUEST_BLOCK'}}
  {{else}}
  {{helper_common_gen_ll_code_subinst 'LL_DMA_SetHWRequestMode' 'LL_DMA_HARDWARE_REQUEST_BURST'}}
  {{/if}}
  {{/with}}

  {{#with additional.access_ports_xfer}}
    {{#if configuration}}
  /* Configure DMA channel access ports */
  {{helper_common_gen_ll_code_subinst 'LL_DMA_ConfigAccessPorts' (concat (concat 'LL_DMA_SRC_ALLOCATED_PORT' dma_channel_source_port) " | " (concat 'LL_DMA_DEST_ALLOCATED_PORT' dma_channel_destination_port))}}
    {{/if}}
  {{/with}}

  {{#with additional.burst_xfer}}
    {{#if configuration}}
  /* Configure DMA channel source and destination burst length */
  {{helper_common_gen_ll_code_subinst 'LL_DMA_ConfigBurstLength' (concat dma_channel_source_burst 'U') (concat dma_channel_destination_burst 'U')}}
    {{/if}}
  {{/with}}

  {{#with additional.data_handling_xfer}}
    {{#if configuration}}
  /* Configure DMA channel data handling */
      {{#if dest_word_exchange}}
  {{helper_common_gen_ll_code_subinst 'LL_DMA_ConfigDataHandling' (concat (concat 'LL_DMA_DEST_DATA_TRUNC_' trunc_padd) " | " (concat 'LL_DMA_DEST_WORD_' dest_word_exchange) " | " (concat 'LL_DMA_DEST_HALFWORD_' dest_halfword_exchange) " | " (concat 'LL_DMA_DEST_BYTE_' dest_byte_exchange) " | " (concat 'LL_DMA_SRC_BYTE_' src_byte_exchange) " | " (concat 'LL_DMA_DEST_DATA_' pack))}}
      {{else}}
   {{helper_common_gen_ll_code_subinst 'LL_DMA_ConfigDataHandling' (concat (concat 'LL_DMA_DEST_DATA_TRUNC_' trunc_padd) " | " (concat 'LL_DMA_DEST_HALFWORD_' dest_halfword_exchange) " | " (concat 'LL_DMA_DEST_BYTE_' dest_byte_exchange) " | " (concat 'LL_DMA_SRC_BYTE_' src_byte_exchange) " | " (concat 'LL_DMA_DEST_DATA_' pack))}}
      {{/if}}
    {{/if}}
  {{/with}}
  {{#with additional.trigger_xfer}}
    {{#if configuration}}
      {{~assign 'trigger' (helper_dma_get_trigger @root.dma_channel_instance @root.current_layer dma_channel_trigger_source.id)}}
  /* Configure DMA channel trigger */
  LL_DMA_ConfigChannelTrigger({{@root.dma_channel_instance}}, {{@root.trigger}}, \
                              LL_DMA_TRIGGER_POLARITY_{{dma_channel_trigger_polarity}} | LL_DMA_TRIGGER_{{dma_channel_trigger_mode}});
    {{/if}}
  {{/with}}
  {{#with additional.repeated_block_xfer}}
    {{#if configuration}}

  /* Configure DMA channel repeated block */
  {{helper_common_gen_ll_code_subinst 'LL_DMA_ConfigBlkRpt' (concat block_count 'U') (concat (concat 'LL_DMA_BLOCK_DEST_ADDR_' block_dest_inc) " | " (concat 'LL_DMA_BLOCK_SRC_ADDR_' block_src_inc) " | " (concat 'LL_DMA_BURST_DEST_ADDR_' burst_dest_inc) " | " (concat 'LL_DMA_BURST_SRC_ADDR_' burst_src_inc))}}

  /* Configure DMA channel source and destination addresses offset */
  {{helper_common_gen_ll_code_subinst 'LL_DMA_ConfigAddrUpdateValue' (concat burst_src_offset_byte 'U') (concat burst_dest_offset_byte 'U')}}

  /* Configure DMA channel repeated block source and destination addresses offset */
  {{helper_common_gen_ll_code_subinst 'LL_DMA_ConfigBlkRptAddrUpdateValue' (concat block_src_offset_byte 'U') (concat block_dest_offset_byte 'U')}}

  /* Configure DMA channel transfer event mode */
  {{helper_common_gen_ll_code_subinst 'LL_DMA_SetTransferEventMode' (concat 'LL_DMA_DIRECT_XFER_EVENT_' event_mode)}}
    {{/if}}
  {{/with}}
{{#each @root.dma_config}}
{{#if system.nvic.nvic_config}}
  /* Enable the interruption for DMA */
{{assign 'nvic_needs' (helper_common_concatenate_needs system.nvic.nvic_config.needs @root.nvic_needs)~}}
{{!assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context system.nvic.nvic_config.needs @root.dma_channel_instance system.nvic.irq_handler_generation)~}}
{{#> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.nvic_config.needs}}
#warning "Partial HAL CORTEX is not present"
{{/CORTEX}}
{{/if}}
{{/each}}
{{/with}}
{{else if (eq @root.dma_transfer_mode 2)}}{{! Circular mode with PPP}}
{{#with @root.dma_config.configuration}}
  {{#with basic}}
  /* Configure DMA channel control parameters */
  {{helper_common_gen_ll_code_subinst 'LL_DMA_ConfigControl' (concat (concat 'LL_DMA_PRIORITY_' priority) " | " (concat 'LL_DMA_LINK_ALLOCATED_PORT' node_fetch_port) " | LL_DMA_LINKEDLIST_EXECUTION_Q")}}

  /* Configure DMA channel transfer event mode */
  LL_DMA_SetTransferEventMode({{@root.dma_channel_instance}}, LL_DMA_LINKEDLIST_XFER_EVENT_Q);

  /* Configure DMA channel block data length */
  {{helper_common_gen_ll_code_subinst 'LL_DMA_SetBlkDataLength''0U'}}

  /* Configure DMA channel linked-list base address */
  LL_DMA_SetLinkedListBaseAddr({{@root.dma_channel_instance}}, (uint32_t)&{{@root.dma_node}});

  /* Configure DMA channel registers update and node address offset during the link transfer */
  LL_DMA_ConfigLinkUpdate({{@root.dma_channel_instance}}, LL_DMA_UPDATE_ALL, (uint32_t)&{{@root.dma_node}});

  /* CTR1 register : Data width and address increment configuration */
  {{@root.dma_node~}}[LL_DMA_NODE_CTR1_REG_OFFSET] = LL_DMA_SRC_ADDR_{{src_inc}} | LL_DMA_SRC_DATA_WIDTH_{{src_data_width}} | \
                                                     LL_DMA_DEST_ADDR_{{dest_inc}} | LL_DMA_DEST_DATA_WIDTH_{{dest_data_width}};
  {{/with}}

  {{#with additional.access_ports_xfer}}
    {{#if configuration}}
  /* CTR1 register : access ports configuration */
  {{@root.dma_node~}}[LL_DMA_NODE_CTR1_REG_OFFSET] |= LL_DMA_SRC_ALLOCATED_PORT{{dma_channel_source_port}} | LL_DMA_DEST_ALLOCATED_PORT{{dma_channel_destination_port}};
    {{/if}}
  {{/with}}

  {{#with additional.burst_xfer}}
    {{#if configuration}}
  /* CTR1 register : source and destination burst length configuration */
  {{@root.dma_node~}}[LL_DMA_NODE_CTR1_REG_OFFSET] |= (({{dma_channel_source_burst}}U - 1U) << DMA_CTR1_SBL_1_Pos) | \
                                                      (({{dma_channel_destination_burst}}U - 1U) << DMA_CTR1_DBL_1_Pos);
    {{/if}}
  {{/with}}

  {{#with additional.data_handling_xfer}}
    {{#if configuration}}
  /* CTR1 register : Data handling configuration */
      {{#if dest_word_exchange}}
  {{@root.dma_node~}}[LL_DMA_NODE_CTR1_REG_OFFSET] |= LL_DMA_DEST_DATA_TRUNC_{{trunc_padd}} | LL_DMA_DEST_DATA_{{pack}} | \
                                                     LL_DMA_DEST_WORD_{{dest_word_exchange}} | LL_DMA_DEST_HALFWORD_{{dest_halfword_exchange}} | \
                                                     LL_DMA_DEST_BYTE_{{dest_byte_exchange}} | LL_DMA_SRC_BYTE_{{src_byte_exchange}};

      {{else}}
  {{@root.dma_node~}}[LL_DMA_NODE_CTR1_REG_OFFSET] |= LL_DMA_DEST_DATA_TRUNC_{{trunc_padd}} | LL_DMA_DEST_DATA_{{pack}} | \
                                                     LL_DMA_DEST_HALFWORD_{{dest_halfword_exchange}} | LL_DMA_DEST_BYTE_{{dest_byte_exchange}} |\
                                                     LL_DMA_SRC_BYTE_{{src_byte_exchange}};

      {{/if}}
    {{/if}}
  {{/with}}
  {{#with security_privilege.security.xfer_sec}}
    {{#if (and (eq src_sec 'SEC') (eq dest_sec 'SEC'))}}

  /* CTR1 register : Transfer access security attributes configuration */
  {{@root.dma_node~}}[LL_DMA_NODE_CTR1_REG_OFFSET] |= LL_DMA_SEC_ITEM_ALL;
    {{else if (eq dest_sec 'SEC')}}

  /* CTR1 register : Transfer access security attributes configuration */
  {{@root.dma_node~}}[LL_DMA_NODE_CTR1_REG_OFFSET] |= LL_DMA_SEC_ITEM_DEST;
    {{else if (eq src_sec 'SEC')}}

  /* CTR1 register : Transfer access security attributes configuration */
  {{@root.dma_node~}}[LL_DMA_NODE_CTR1_REG_OFFSET] |= LL_DMA_SEC_ITEM_SRC;
    {{/if}}
  {{/with}}

  {{#with basic}}
    {{#if request}}
      {{~assign 'req' (helper_dma_get_request @root.dma_channel_instance @root.current_layer request.id)}}
    {{/if}}
  /* CTR2 register : Request and direction configuration */
  {{#if (helper_dma_is_hw_request_block request)}}
  {{@root.dma_node~}}[LL_DMA_NODE_CTR2_REG_OFFSET] = {{@root.req}} | LL_DMA_HARDWARE_REQUEST_BLOCK | LL_DMA_DIRECTION_{{direction}};
  {{else}}
  {{@root.dma_node~}}[LL_DMA_NODE_CTR2_REG_OFFSET] = {{@root.req}} | LL_DMA_HARDWARE_REQUEST_BURST | LL_DMA_DIRECTION_{{direction}};
  {{/if}}
  {{/with}}

  {{#with additional.trigger_xfer}}
    {{#if configuration}}
      {{~assign 'trigger' (helper_dma_get_trigger @root.dma_channel_instance @root.current_layer dma_channel_trigger_source.id)}}
  /* CTR2 register : Trigger configuration*/
  {{@root.dma_node~}}[LL_DMA_NODE_CTR2_REG_OFFSET] |= ({{@root.trigger}} << DMA_CTR2_TRIGSEL_Pos) | LL_DMA_TRIGGER_POLARITY_{{dma_channel_trigger_polarity}} | \
                                                      LL_DMA_TRIGGER_{{dma_channel_trigger_mode}};
    {{/if}}
  {{/with}}

  {{#with additional.repeated_block_xfer}}
    {{#if configuration}}
  /* CTR2 register : Transfer event mode configuration */
  {{@root.dma_node~}}[LL_DMA_NODE_CTR2_REG_OFFSET] |= LL_DMA_LINKEDLIST_XFER_EVENT_{{event_mode}};

  /* CBR1 register : repeated block configuration */
  {{@root.dma_node~}}[LL_DMA_NODE_CBR1_REG_OFFSET] = (({{block_count}}U - 1U) << DMA_CBR1_BRC_Pos)             | \
                                                     LL_DMA_BLOCK_DEST_ADDR_{{block_dest_inc}} | \
                                                     LL_DMA_BLOCK_SRC_ADDR_{{block_src_inc}}  | \
                                                     LL_DMA_BURST_DEST_ADDR_{{burst_dest_inc}} | \
                                                     LL_DMA_BURST_SRC_ADDR_{{burst_src_inc}};

  /* CTR3 register : source and destination addresses offset configuration */
  {{@root.dma_node~}}[LL_DMA_NODE_CTR3_REG_OFFSET] = {{burst_src_offset_byte}}U | ({{burst_dest_offset_byte}}U << DMA_CTR3_DAO_Pos);

  /* CBR2 register : repeated block source and destination addresses offset configuration */
  {{@root.dma_node~}}[LL_DMA_NODE_CBR2_REG_OFFSET] = {{block_src_offset_byte}}U | ({{block_dest_offset_byte}}U << DMA_CBR2_BRDAO_Pos);
    {{/if}}
  {{/with}}
{{/with}}

  /* CLLR register */
  if (IS_DMA_2D_ADDRESSING_INSTANCE({{@root.dma_channel_instance}}) != 0U)
  {
    {{@root.dma_node~}}[LL_DMA_NODE_CLLR_REG_OFFSET] = LL_DMA_UPDATE_ALL | ((uint32_t)&{{@root.dma_node}} & DMA_CLLR_LA);
  }
  else
  {
    {{@root.dma_node~}}[LL_DMA_NODE_CLLR_REG_OFFSET - 2U] = LL_DMA_UPDATE_ALL | ((uint32_t)&{{@root.dma_node}} & DMA_CLLR_LA);
  }

{{! DMA channel NVIC configuration : }}
{{#each @root.dma_config}}
{{#if system.nvic.nvic_config}}
  /* Enable the interruption for DMA */
{{assign 'nvic_needs' (helper_common_concatenate_needs system.nvic.nvic_config.needs @root.nvic_needs)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.nvic_config.needs}}
{{/if}}
{{/each}}

{{/if}}
{{else if (eq @root.init_model 2)}}
  {{~assign 'fct_name' fct_name}}
  /* Configure the {{@root.dma_channel_instance}} DMA channel for {{@root.dma_config_owner}} {{@root.dma_config_selector}} */
  if ({{lowercase @root.fct_name}}_{{lowercase @root.dma_channel_instance}}_init() != SYSTEM_OK)
  {
    return NULL;
  }

{{/if}}
{{else if (eq fct 'init_independently')}}
  {{! }}
  {{! Generate the DMA init code in independent function}}
  {{! > DMA_LL fct='init_independently' needs=dma_config_tx.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype/implementation'}}
  {{! }}
{{~assign 'init_model' init_model~}}
{{#if (eq @root.init_model undefined)}}
  {{~assign 'init_model' 0~}}
{{/if}}
{{~assign 'fct_name' fct_name~}}
{{~assign 'type' type~}}
{{#if (or (eq @root.init_model 1) (eq @root.init_model 2))}}
{{#if (eq @root.type 'prototype')}}
/**
  * @brief {{@root.fct_name}} DMA init function.
  * This function configures the DMA channel associated with {{@root.dma_config_owner}} {{@root.dma_config_selector}}.
  * @retval SYSTEM_OK.
  */
system_status_t {{lowercase @root.fct_name}}_{{lowercase @root.dma_channel_instance}}_init(void);
{{else}}
system_status_t {{lowercase @root.fct_name}}_{{lowercase @root.dma_channel_instance}}_init(void)
{
{{> DMA_LL fct='init' needs=needs init_model=0 fct_name=@root.fct_name independent_init_call=true}}

  return SYSTEM_OK;
}
{{/if}}
{{/if}}
{{else if (eq fct 'deinit')}}
{{! }}
{{! Generate the DMA code inside the DMAi_Channely or PPPi init fct}}
{{! > DMA_LL fct='deinit' needs=dma_config_tx.needs}}
{{! }}
  /* De-initialize the DMA channel */
  LL_DMA_DisableChannel({{@root.dma_channel_instance}});
  LL_DMA_ClearFlag({{@root.dma_channel_instance}}, LL_DMA_FLAG_ALL);

  LL_DMA_WRITE_REG({{@root.dma_channel_instance}}, CCR, 0U);
  LL_DMA_WRITE_REG({{@root.dma_channel_instance}}, CTR1, 0U);
  LL_DMA_WRITE_REG({{@root.dma_channel_instance}}, CTR2, 0U);
  LL_DMA_WRITE_REG({{@root.dma_channel_instance}}, CBR1, 0U);
  LL_DMA_WRITE_REG({{@root.dma_channel_instance}}, CTR3, 0U);
  LL_DMA_WRITE_REG({{@root.dma_channel_instance}}, CBR2, 0U);
  LL_DMA_WRITE_REG({{@root.dma_channel_instance}}, CLLR, 0U);

{{#each @root.dma_config}}
{{#if system.nvic.nvic_config}}
  /* Disable the interruption for DMA */
{{assign 'nvic_needs' (helper_common_concatenate_needs system.nvic.nvic_config.needs @root.nvic_needs)~}}
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context system.nvic.nvic_config.needs @root.dma_channel_instance false)~}}
{{#> CORTEX fct='deinit' layer=@root.current_layer needs=system.nvic.nvic_config.needs}}
#warning "Partial HAL CORTEX is not present"
{{/CORTEX}}
{{/if}}
{{/each}}

{{else if (eq fct 'init_dma')}}
{{! }}
{{! Generate the DMA code inside the DMAi_CHy init function}}
{{! > DMA_LL fct='init_dma' arg1=@root.current_resource arg2=@root.current_config}}
{{! }}
{{~assign 'dma_channel_instance' arg1~}}
{{~assign 'dma_config' arg2~}}
{{~assign 'dma_parent' (helper_dma_get_parent @root.dma_channel_instance)}}
  /* Enable {{@root.dma_parent}} clock */{{! ~}}
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.dma_parent~}}

{{#with @root.dma_config}}
  {{#with basic}}
    {{~assign 'dma_transfer_mode' dma_mode~}}
  {{/with}}
{{/with}}

{{#with @root.dma_config}}
{{#if (eq @root.dma_transfer_mode 0)}}{{! Direct mode / DMA standalone}}
  {{#with basic}}

 {{> SYSTEM fct='system_check_ll_optim'}}
 {{assign 'lut_table'   (helper_dma_get_lut_table 'DMA3')~}}
  {{helper_common_initialize_ll_code @root.optim_enable @root.lut_table 'undefined'~}}
  {{helper_common_gen_ll_code_add_subinst @root.dma_channel_instance~}}

  /* Configure DMA channel transfer direction */
  LL_DMA_SetDataTransferDirection({{@root.dma_channel_instance}}, LL_DMA_DIRECTION_{{direction}});

  /* Configure DMA channel priority level */
  {{helper_common_gen_ll_code_subinst 'LL_DMA_SetChannelPriorityLevel' (concat 'LL_DMA_PRIORITY_' priority )}}

  /* Configure DMA channel transfer register 1 */
  LL_DMA_ConfigTransfer({{@root.dma_channel_instance}},
                        (LL_DMA_SRC_ADDR_{{src_inc}} | LL_DMA_SRC_DATA_WIDTH_{{src_data_width}} |
                         LL_DMA_DEST_ADDR_{{dest_inc}} | LL_DMA_DEST_DATA_WIDTH_{{dest_data_width}}));
  {{/with}}

  {{#with additional.access_ports_xfer}}
    {{#if configuration}}
  /* Configure DMA channel access ports */
  {{helper_common_gen_ll_code_subinst 'LL_DMA_ConfigAccessPorts' (concat (concat 'LL_DMA_SRC_ALLOCATED_PORT' dma_channel_source_port) " | " (concat 'LL_DMA_DEST_ALLOCATED_PORT' dma_channel_destination_port))}}
    {{/if}}
  {{/with}}

  {{#with additional.burst_xfer}}
    {{#if configuration}}
  /* Configure DMA channel source and destination burst length */
  {{helper_common_gen_ll_code_subinst 'LL_DMA_ConfigBurstLength' (concat dma_channel_source_burst 'U') (concat dma_channel_destination_burst 'U')}}
    {{/if}}
  {{/with}}

  {{#with additional.data_handling_xfer}}
    {{#if configuration}}
  /* Configure DMA channel data handling */
      {{#if dest_word_exchange}}
  {{helper_common_gen_ll_code_subinst 'LL_DMA_ConfigDataHandling' (concat (concat 'LL_DMA_DEST_DATA_TRUNC_' trunc_padd) " | " (concat 'LL_DMA_DEST_WORD_' dest_word_exchange) " | " (concat 'LL_DMA_DEST_HALFWORD_' dest_halfword_exchange) " | " (concat 'LL_DMA_DEST_BYTE_' dest_byte_exchange) " | " (concat 'LL_DMA_SRC_BYTE_' src_byte_exchange) " | " (concat 'LL_DMA_DEST_DATA_' pack))}}
      {{else}}
   {{helper_common_gen_ll_code_subinst 'LL_DMA_ConfigDataHandling' (concat (concat 'LL_DMA_DEST_DATA_TRUNC_' trunc_padd) " | " (concat 'LL_DMA_DEST_HALFWORD_' dest_halfword_exchange) " | " (concat 'LL_DMA_DEST_BYTE_' dest_byte_exchange) " | " (concat 'LL_DMA_SRC_BYTE_' src_byte_exchange) " | " (concat 'LL_DMA_DEST_DATA_' pack))}}
      {{/if}}
    {{/if}}
  {{/with}}
  {{#with additional.trigger_xfer}}
    {{#if configuration}}
      {{~assign 'trigger' (helper_dma_get_trigger @root.dma_channel_instance @root.current_layer dma_channel_trigger_source.id)}}
  /* Configure DMA channel trigger */
  LL_DMA_ConfigChannelTrigger({{@root.dma_channel_instance}}, {{@root.trigger}}, \
                              LL_DMA_TRIGGER_POLARITY_{{dma_channel_trigger_polarity}} | LL_DMA_TRIGGER_{{dma_channel_trigger_mode}});
    {{/if}}
  {{/with}}
  {{#with additional.repeated_block_xfer}}
    {{#if configuration}}

  /* Configure DMA channel repeated block */
   {{helper_common_gen_ll_code_subinst 'LL_DMA_ConfigBlkRpt' (concat block_count 'U') (concat (concat 'LL_DMA_BLOCK_DEST_ADDR_' block_dest_inc) " | " (concat 'LL_DMA_BLOCK_SRC_ADDR_' block_src_inc) " | " (concat 'LL_DMA_BURST_DEST_ADDR_' burst_dest_inc) " | " (concat 'LL_DMA_BURST_SRC_ADDR_' burst_src_inc))}}

  /* Configure DMA channel source and destination addresses offset */
  {{helper_common_gen_ll_code_subinst 'LL_DMA_ConfigAddrUpdateValue' (concat burst_src_offset_byte 'U') (concat burst_dest_offset_byte 'U')}}

  /* Configure DMA channel repeated block source and destination addresses offset */
  {{helper_common_gen_ll_code_subinst 'LL_DMA_ConfigBlkRptAddrUpdateValue' (concat block_src_offset_byte 'U') (concat block_dest_offset_byte 'U')}}

  /* Configure DMA channel transfer event mode */
  {{helper_common_gen_ll_code_subinst 'LL_DMA_SetTransferEventMode' (concat 'LL_DMA_DIRECT_XFER_EVENT_' event_mode)}}
    {{/if}}
  {{/with}}

{{else if (eq @root.dma_transfer_mode 1)}}{{! Linked-list mode / DMA standalone}}
  {{#with basic}}

  {{> SYSTEM fct='system_check_ll_optim'}}
 {{assign 'lut_table'   (helper_dma_get_lut_table 'DMA3')~}}
  {{helper_common_initialize_ll_code @root.optim_enable @root.lut_table 'undefined'~}}
  {{helper_common_gen_ll_code_add_subinst @root.dma_channel_instance~}}

