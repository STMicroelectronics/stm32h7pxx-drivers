{{else if (eq fct 'config_security_privilege')}}

{{#with security_privilege}}
  {{~assign 'getCurrentEngine' (@root.SwComposerAPI.getCurrentEngine)}}
  {{#if (eq @root.getCurrentEngine.secure 'Non-secure')}}
system_status_t {{@root.fct_name}}_config_privilege(void)
  {{else}}
system_status_t {{@root.fct_name}}_config_security_privilege(void)
  {{/if}}
{
  /*
   * Full access security path:
   * Configure RTC resources security/privilege attributes
   */

  {{#> PWR_LL fct='generate_write_protection_disable'}}
  {{/PWR_LL}}

 {{#> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}
 {{/RCC}}

  /* Disable write protection */
  LL_RTC_DisableWriteProtection();

{{#with security}}
{{assign "access_levels_all_states" (helper_rtc_attribute_all_states access_levels)}}
{{#unless  @root.access_levels_all_states.allNegative}}
{{#if @root.access_levels_all_states.allPositive}}
  /* Configure security attributes for RTC peripheral */
  LL_RTC_SetSecAttr(LL_RTC_SEC_ITEM_ALL, LL_RTC_ATTR_SEC);
{{else}}
{{assign "security_items" (helper_rtc_get_attribute_items @root.current_layer 'SEC' access_levels)}}
{{#unless (eq security_items '')}}
  /* Configure security attributes for RTC peripheral */
  LL_RTC_SetSecAttr({{@root.security_items}}, LL_RTC_ATTR_SEC);
{{else}}
{{log "No specific security attributes require configuration for this RTC instance."}}
{{/unless}}
{{/if}}
{{else}}
{{log "No security attributes (all) require configuration for this RTC instance."}}
{{/unless}}
{{/with}}

{{#with privilege}}
{{assign "access_levels_all_states" (helper_rtc_attribute_all_states access_levels)}}
{{#unless  @root.access_levels_all_states.allNegative}}
{{#if @root.access_levels_all_states.allPositive}}
  /* Configure privilege attributes for RTC peripheral */
  LL_RTC_SetPrivAttr(LL_RTC_PRIV_ITEM_ALL, LL_RTC_ATTR_PRIV);
{{else}}
{{assign "privilege_items" (helper_rtc_get_attribute_items @root.current_layer 'PRIV' access_levels)}}
{{#unless (eq privilege_items '')}}
  /* Configure privilege attributes for RTC peripheral */
  LL_RTC_SetPrivAttr({{@root.privilege_items}}, LL_RTC_ATTR_PRIV);
{{else}}
{{log "No specific privilege attributes require configuration for this RTC instance."}}
{{/unless}}
{{/if}}
{{else}}
{{log "No privilege attributes (all) require configuration for this RTC instance."}}
{{/unless}}
