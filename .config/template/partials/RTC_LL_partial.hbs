{{/CORTEX}}
        {{else if irq_line_priority_s}}
          {{~assign 'nvic_context' 'undefined'}}
          {{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context  @root.nvic_context irq_line_priority_s.needs @root.current_resource irq_handler_generation)}}
{{#> CORTEX fct='init' layer=@root.current_layer needs=irq_line_priority_s.needs}}
