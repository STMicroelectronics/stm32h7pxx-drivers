{{~helper_rcc_init_codegen @root~}}
{{!
  * @file Partial provided by RCC, visible by other PPP
  * @license
  * Copyright (c) 2026 STMicroelectronics.
  * All rights reserved.
  *
  * This software is licensed under terms that can be found in the LICENSE file
  * in the root directory of this software component.
  * If no LICENSE file comes with this software, it is provided AS-IS.
  * @detail
  * The partial provides the following functions, called in ppp:
  * - include_rcc
  * - generate_kernel_clock
  * - kernel_clock_deinit
  * - generate_peripheral_clock_activation
  * - generate_peripheral_clock_deactivation
  * - generate_peripheral_clock_reset
  * - generate_peripheral_kernel_clock_activation
  * - generate_peripheral_kernel_clock_deactivation
  * - generate_backup_domain_reset
~}}

{{~#if (eq fct 'include_rcc')}}
{{!     Generate the mx_rcc.h include inside mx_pppi.h                  ~}}
{{!     Code is only generated in the controlled by peripheral mode AND ~}}
{{!     if the current resource has a clock configuration to do         ~}}
{{!> RCC fct='include_rcc'~}}
  {{~assign 'rcc_ctx' (helper_rcc_get_rcc_context) ~}}
  {{#if (helper_rcc_is_controlled_by_periph @root.rcc_ctx)}}
#include "mx_rcc.h"
  {{/if~}}

{{~else if (eq fct 'generate_kernel_clock')}}
{{!     Partial called from PPP to generate clock configuration in all modes                                        ~}}
{{!     Generate the set kernel clock source function for a given peripheral, in all modes                          ~}}
{{!     - In controlled by peripheral mode, the mx_rcc_ppp_config function is generated if a clock configuration is ~}}
{{!     needed (clock activation, kernel clock source setting and related clock settings)                           ~}}
{{!     - In other modes, the kernel clock source configuration and related clock settings code is generated        ~}}
{{!> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource~}}
  {{~assign 'rcc_ctx' (helper_rcc_get_rcc_context) ~}}
  {{#if (helper_rcc_is_controlled_by_periph @root.rcc_ctx)}}
    {{#if (helper_rcc_is_clock_config_needed hw_resource)}}
  if (mx_rcc_{{lowercase hw_resource}}_clock_config() != SYSTEM_OK)
  {
      {{#if (helper_rcc_is_instantiable_periph hw_resource)}}
    return NULL;
      {{else}}
    return SYSTEM_PERIPHERAL_ERROR;
      {{/if}}
  }
    {{/if}}
  {{else}}
{{>RCC fct='generate_kernel_clock_with_return'}}
  {{/if~}}

{{~else if (eq fct 'generate_kernel_clock_with_return')}}
{{!     Generate the code to set kernel clock source and related clock settings for a given peripheral .      ~}}
{{!     The return value can be specified                                                                     ~}}
{{!> RCC fct='generate_kernel_clock_controlled' hw_resource=@root.current_resource return='SYSTEM_CLOCK_ERROR'~}}
  {{~log "RCC_partial generate_kernel_clock_with_return: hw_resource =" hw_resource ", return =" return~}}
  {{#if (helper_rcc_has_kernel_clock_mux hw_resource)}}
    {{~assign 'clock_source_object' (helper_rcc_get_clock_source_object hw_resource)~}}
    {{#if @root.clock_source_object}}
      {{~assign 'clock_source' (helper_rcc_remap_clock_source @root.clock_source_object.value @root.current_layer)~}}
      {{~assign 'ppp_name' (helper_rcc_remap_kernel_clock_source hw_resource)~}}
      {{#if (eq @root.current_layer 'HAL')}}
  if (HAL_RCC_{{@root.ppp_name}}_SetKernelClkSource(HAL_RCC_{{@root.ppp_name}}_CLK_SRC_{{@root.clock_source}}) != HAL_OK)
  {
        {{#if return}}
    return {{return}};
        {{else}}
          {{#if (helper_rcc_is_instantiable_periph hw_resource)}}
    return NULL;
          {{else}}
    return SYSTEM_PERIPHERAL_ERROR;
          {{/if}}
        {{/if}}
  }

      {{else}}
  {{helper_common_gen_ll_code (concat 'LL_RCC_Set' (helper_rcc_get_ppp_name hw_resource) 'ClockSource') (concat 'LL_RCC_' @root.ppp_name '_CLKSOURCE_' @root.clock_source)}}
      {{/if}}
    {{/if}}
  {{/if~}}

  {{! Extra clock conficuration for some PPP ~}}

  {{! DAC : DACSH generation ~}}
  {{#if (helper_rcc_is_dac_extra_config_needed hw_resource)}}
    {{~assign 'dac_sh_clock' (helper_rcc_get_dac_sh_clock hw_resource)~}}

    {{#unless (eq @root.dac_sh_clock '')}}
      {{#if (eq @root.current_layer 'HAL')}}
  if (HAL_RCC_{{hw_resource}}_SetSampleHoldClkSource(HAL_RCC_{{hw_resource}}SH_CLK_SRC_{{@root.dac_sh_clock}}) != HAL_OK)
  {
        {{#if return}}
    return {{return}};
        {{else}}
    return NULL;
        {{/if}}
  }

      {{else}}
  {{helper_common_gen_ll_code 'LL_RCC_SetDACSHClockSource' (concat 'LL_RCC_' hw_resource 'SH_CLKSOURCE_' @root.dac_sh_clock)}}

      {{/if}}
    {{/unless}}
  {{/if}}

{{~else if (eq fct 'kernel_clock_deinit')}}
{{!     Generate the kernel clock deinit for a resource ~}}
{{!> RCC fct='kernel_clock_deinit' hw_resource=@root.current_resource~}}

  {{~log "RCC_partial kernel_clock_deinit: hw_resource=" hw_resource~}}
    {{~assign 'rcc_ctx' (helper_rcc_get_rcc_context) ~}}
    {{#if (helper_rcc_is_controlled_by_periph @root.rcc_ctx)}}
      {{#if (helper_rcc_is_clock_config_needed @root.current_resource)}}
  (void)mx_rcc_{{lowercase hw_resource}}_clock_deactivate();

      {{/if}}
    {{/if}}

{{~else if (eq fct 'generate_peripheral_clock_activation')}}
{{!     Generate the bus clock activation function for a given peripheral~}}
{{!> RCC fct='generate_peripheral_clock_activation' hw_resource='SPI1' [is_child=true]~}}
  {{~log "RCC_partial generate_peripheral_clock_activation: hw_resource="hw_resource ", is_child=" is_child~}}

{{!> Requested PPP bus enable ~}}
  {{#if (or (eq (helper_rcc_get_clk_enable_mode hw_resource) 0) (eq is_child true))}}
    {{#if (helper_rcc_has_enable hw_resource)}}
      {{#if (eq @root.current_layer 'HAL')}}
  HAL_RCC_{{helper_rcc_remap_hw_resource hw_resource}}_EnableClock();

{{!> Requested PPP side clock enable (belonging to this PPP) ~}}
        {{#if (or (eq hw_resource 'RTC') (eq hw_resource 'TAMP'))}}
  HAL_RCC_RTC_EnableKernelClock();
        {{/if}}
      {{else}}
        {{~assign "periph_bus" (helper_rcc_get_bus_group hw_resource)}}
  LL_{{@root.periph_bus}}_EnableClock(LL_{{@root.periph_bus}}_PERIPH_{{helper_rcc_remap_hw_resource hw_resource}});
        {{#if (or (eq hw_resource 'RTC') (eq hw_resource 'TAMP'))}}
  LL_RCC_EnableRTC();
        {{/if}}
      {{/if}}
    {{/if}}
  {{/if~}}

{{!> Child PPP bus enable AFTER requested PPP. Enabled once at parent call ~}}
  {{#if (not is_child)}}
    {{~#if (helper_rcc_is_sbs_enable_required hw_resource)}}

{{>RCC fct='generate_peripheral_clock_activation' hw_resource='SBS' is_child=true~}}
    {{/if}}
  {{/if~}}

{{else if (eq fct 'generate_peripheral_clock_deactivation')}}
{{!     Generate the bus clock deactivation function for a given peripheral~}}
{{!> RCC fct='generate_peripheral_clock_deactivation' hw_resource='SPI1'~}}
  {{~log "RCC_partial generate_peripheral_clock_deactivation: hw_resource="hw_resource~}}
  {{#and (helper_rcc_has_enable hw_resource) (helper_rcc_is_not_shared_ppp hw_resource)}}
    {{#if (eq @root.current_layer 'HAL')}}
      {{#if (or (eq hw_resource 'RTC') (eq hw_resource 'TAMP'))}}
  HAL_RCC_RTC_DisableKernelClock();
      {{/if}}

  HAL_RCC_{{helper_rcc_remap_hw_resource hw_resource}}_DisableClock();

    {{else}}
      {{~assign "periph_bus" (helper_rcc_get_bus_group hw_resource)}}
      {{#if (or (eq hw_resource 'RTC') (eq hw_resource 'TAMP'))}}
  LL_RCC_DisableRTC();
      {{/if}}
  LL_{{@root.periph_bus}}_DisableClock(LL_{{@root.periph_bus}}_PERIPH_{{helper_rcc_remap_hw_resource hw_resource}});
    {{/if}}
  {{/and}}

{{~else if (eq fct 'generate_peripheral_clock_reset')}}
{{!     Generate the bus clock reset function for a given peripheral~}}
{{!> RCC fct='generate_peripheral_clock_reset' hw_resource='SPI1'~}}
  {{~log "RCC_partial generate_peripheral_clock_reset: hw_resource="hw_resource @root.current_layer~}}
  {{#and (helper_rcc_has_reset hw_resource) (helper_rcc_is_not_shared_ppp hw_resource)}}
    {{#if (eq @root.current_layer 'HAL')}}
  HAL_RCC_{{helper_rcc_remap_hw_resource hw_resource}}_Reset();
    {{else}}
      {{~assign "periph_bus" (helper_rcc_get_bus_group hw_resource)}}
  LL_{{@root.periph_bus}}_ForceReset(LL_{{@root.periph_bus}}_PERIPH_{{helper_rcc_remap_hw_resource hw_resource}});
  LL_{{@root.periph_bus}}_ReleaseReset(LL_{{@root.periph_bus}}_PERIPH_{{helper_rcc_remap_hw_resource hw_resource}});

    {{/if}}
  {{/and}}

{{~else if (eq fct 'generate_enable_lse_with_write_protection')}}
{{!  Generate the enable of the LSE with the write protection enable / disable code ~}}
{{!> RCC fct='generate_enable_lse_with_write_protection' wp_disable=true wp_enable=true css=false~}}
  {{#if (not @root.rcc_ctx.basic.lse) }}
#warning "LSE not available on this package - Change mux clock source selection"

  {{else if  (eq @root.rcc_ctx.basic.lse.state 'OFF')}}
#warning "Configure a LSE source in CubeMx RCC panel"

  {{else}}
    {{~#if (eq @root.current_layer 'HAL')}}
      {{~#if wp_disable}}
{{>PWR_HAL fct='generate_write_protection_disable'}}
      {{/if}}
  if (HAL_RCC_LSE_Enable(HAL_RCC_LSE_{{@root.rcc_ctx.basic.lse.state}}, HAL_RCC_LSE_DRIVE_{{@root.rcc_ctx.basic.lse.drive_capability}}) != HAL_OK)
  {
  {{>PWR_HAL fct='generate_write_protection_enable'}}
    return SYSTEM_CLOCK_ERROR;
  }
      {{#if css}}
  HAL_RCC_LSE_EnableCSS();
      {{/if}}

      {{~#if wp_enable}}
{{>PWR_HAL fct='generate_write_protection_enable'}}
      {{/if}}

    {{~else}}
      {{~#if wp_disable}}
{{>PWR_LL fct='generate_write_protection_disable'}}
      {{/if}}
      {{#if (eq @root.rcc_ctx.basic.lse.state "BYPASS")}}
  LL_RCC_LSE_ConfigBypass(LL_RCC_LSE_ANALOG_MODE);
      {{else if (eq @root.rcc_ctx.basic.lse.state "BYPASS_DIGITAL")}}
  LL_RCC_LSE_ConfigBypass(LL_RCC_LSE_DIGITAL_MODE);
      {{/if}}
  {{helper_common_gen_ll_code "LL_RCC_LSE_SetDriveCapability" (concat 'LL_RCC_LSEDRIVE_' @root.rcc_ctx.basic.lse.drive_capability)}}
  LL_RCC_LSE_Enable();
  {{~> SYSTEM fct='system_timeout_loop' timing='LSE_STARTUP_TIMEOUT' return_if_failed='SYSTEM_CLOCK_ERROR'}}
  while(LL_RCC_LSE_IsReady() != 1U);
      {{#if css}}
  LL_RCC_LSE_EnableCSS();
      {{/if}}
      {{~#if wp_enable}}
{{>PWR_LL fct='generate_write_protection_enable'}}
      {{/if}}
    {{/if}}
  {{/if~}}

{{~else if (eq fct 'generate_backup_domain_reset')}}
{{!  Generate the Backup Domain Reset function(s)~}}
{{!  PWR_HAL fct='generate_write_protection_enable is called in case of LSE re-abling error ~}}
{{!> RCC fct='generate_backupdomain_reset'~}}
{{!> If this partial was already called, it is not called again (avoid to reset TAMP if RTC also bound)'~}}
{{!> If LSE was enabled, it is re-abled'~}}
  {{~log "RCC_partial generate_backup_domain_reset"~}}
  {{#if (not (helper_rcc_is_resource_enabled 'backup_domain_reset'))}}
    {{~helper_rcc_set_resource_enabled 'backup_domain_reset'}}
    {{~assign 'all_resources' (helper_rcc_get_all_resources) ~}}
    {{~assign 'all_ppp_clock_configs' (helper_rcc_get_all_perifs_clock_config @root.all_resources) ~}}
    {{~assign 'rcc_ctx' (helper_rcc_get_rcc_context) ~}}
    {{~assign 'system_config' (helper_rcc_get_system_config @root.rcc_ctx) ~}}
    {{~assign 'used_oscillators' (helper_rcc_get_used_osc @root.system_config @root.all_ppp_clock_configs) ~}}
    {{#if (eq @root.current_layer 'HAL')}}
  /* Reset RTC domain */
  HAL_RCC_ResetRTCDomain();
    {{else}}
  /* Reset backup domain */
  LL_RCC_ForceBackupDomainReset();
  LL_RCC_ReleaseBackupDomainReset();
    {{/if}}

    {{#inArray @root.used_oscillators 'LSE'}}
{{>RCC fct='generate_enable_lse_with_write_protection' wp_disable=false wp_enable=false css=true}}
    {{/inArray~}}
  {{/if}}

{{~else if (eq fct 'generate_systick_frequency_computation')}}
{{!  Generate the SysTick frequency computation function~}}
{{!  external: boolean indicating if systick source is external or not. If not provided, internal code generated ~}}
{{!> RCC fct='generate_systick_frequency_computation' external='false'~}}
  {{helper_rcc_get_systick_input_frequency external~}}U

{{~else}}
#warning "RCC partial called but wrong step {{fct}}"
{{/if~}}
