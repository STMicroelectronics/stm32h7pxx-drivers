{{!
  Partial used for HAL UCPD:
  how to use
  > UCPD_HAL fct='xxxx' with xxxx:
    * exported_variables
    * exported_functions_init
    * exported_functions_gethandle
    * exported_functions_gethandle_prototype
~}}

{{!
############################
##  exported_variables
############################
~}}
{{#if (eq fct 'exported_variables')}}
/* Handle for UCPD */
static hal_ucpd_handle_t h{{@root.current_resource}};

{{> GPIO_HAL fct='gpio_exti_get_variables' resource=@root.current_resource~}}
{{> DMA_HAL fct='get_dma_handles' resource=@root.current_resource}}

{{!
############################
##  exported_functions_init
############################
~}}
{{else if (eq fct 'exported_functions_init')}}
hal_ucpd_handle_t *{{@root.fct_name}}_init(void)
{
  hal_ucpd_config_t ucpd_config;

  /* Basic configuration */
  if (HAL_UCPD_Init(&h{{@root.current_resource}}, HAL_{{uppercase @root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource~}}
{{#with basic}}
  /* Bit rate set to {{timing.bit_rate}} */
  ucpd_config.clk_psc        = HAL_UCPD_PSC_DIV{{timing.clock_prescaler}};
  ucpd_config.hbitclk_div    = HAL_UCPD_HBITCLK_DIV{{timing.half_bit_clock}};
  ucpd_config.transwin_div   = HAL_UCPD_TRANSWIN_DIV{{timing.transition_window}};
  ucpd_config.ifrgap_div     = HAL_UCPD_IFRGAP_DIV{{timing.inter_frame_gap_timer_clock}};
{{/with~}}{{!basic}}
  ucpd_config.rx_ordered_set ={{helper_ucpd_rx_ordered_set_multiline basic.rx_ordered_set "HAL"}};

  if (HAL_UCPD_SetConfig(&h{{@root.current_resource}}, &ucpd_config) != HAL_OK)
  {
    return NULL;
  }
{{#with additional}}
{{#if rx_analog_filter}}
  HAL_UCPD_EnableRxAnalogFilter(&h{{@root.current_resource}});
{{/if~}}{{!rx_analog_filter}}
{{#if wake_up_stop_mode}}
  HAL_UCPD_EnableWakeupMode(&h{{@root.current_resource}});
{{/if~}}{{!wake_up_stop_mode}}

{{#if force_clock}}
  HAL_UCPD_EnableForceClock(&h{{@root.current_resource}});
{{/if~}}{{!force_clock}}

{{#if rx_prefilter}}
  HAL_UCPD_EnableRxPreFilter(&h{{@root.current_resource}});

  HAL_UCPD_SetRxPreFilterSampling(&h{{@root.current_resource}}, HAL_UCPD_RX_PREFILTER_{{rx_prefilter_sampling}});
{{/if~}}{{!rx_prefilter}}
{{/with~}}{{!additional}}

{{> GPIO_HAL fct='init_resource' resource=@root.current_resource return_if_failed='NULL' init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name~}}

{{#with system}}
{{#with nvic}}
{{#if enable_interruption}}
  /* Enable interrupt */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context  @root.nvic_context nvic_config.needs @root.current_resource irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=nvic_config.needs}}
{{/if}}
{{/with}}{{!nvic}}

{{#with dma}}
{{#if enable_dma_tx}}
{{assign 'found_ucpd_dma_tx' true~}}
  /* Configure the DMA TX */
{{#> DMA_HAL fct='init' needs=dma_config_tx.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name}}
{{/DMA_HAL}}

  /* Link the Transmit DMA handle to the UCPD handle */
  if (HAL_UCPD_SetTxDMA(&h{{@root.current_resource}}, &h{{@root.dma_channel_instance}}) != HAL_OK)
  {
    return NULL;
  }

{{/if}}{{! enable_dma_tx~}}
{{#if enable_dma_rx}}
{{assign 'found_ucpd_dma_rx' true~}}
  /* Configure the DMA RX */
{{#> DMA_HAL fct='init' needs=dma_config_rx.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name}}
{{/DMA_HAL}}

  /* Link the Receive DMA handle to the UCPD handle */
  if (HAL_UCPD_SetRxDMA(&h{{@root.current_resource}}, &h{{@root.dma_channel_instance}}) != HAL_OK)
  {
    return NULL;
  }

{{/if}}{{! enable_dma_rx~}}
{{/with}}{{!dma}}
{{/with}}{{!system}}
  return &h{{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{#if system.nvic.enable_interruption}}
  /* Disable interrupt */
{{> CORTEX fct='deinit' layer=@root.current_layer}}
{{/if~}}
  (void)HAL_UCPD_DeInit(&h{{@root.current_resource}});

{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}

{{> GPIO_HAL fct='deinit_resource' resource=@root.current_resource~}}
{{#with system}}
{{#with dma}}
{{#if enable_dma_tx}}
{{> DMA_HAL fct='deinit' needs=dma_config_tx.needs~}}

{{/if~}}
{{#if enable_dma_rx}}
{{> DMA_HAL fct='deinit' needs=dma_config_rx.needs~}}
{{/if~}}
{{/with}}{{! dma~}}
{{/with}}{{! system~}}
}

{{!
################################
##  exported_functions_gethandle
################################
~}}
{{else if (eq fct 'exported_functions_gethandle')}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined @root.current_function)~}}
hal_ucpd_handle_t *{{@root.fct_name}}_gethandle(void)
{
  return &h{{@root.current_resource}};
}
{{> GPIO_HAL fct='gpio_exti_gethandle' resource=@root.current_resource type='implementation'}}

{{!
################################
##  exported_functions_gethandle_prototype
################################
~}}
{{else if (eq fct 'exported_functions_gethandle_prototype')}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined @root.current_function)~}}
/**
  * @brief  Get the {{@root.fct_name}} object.
  * @retval Pointer on the {{@root.fct_name}}Handle
  */
hal_ucpd_handle_t *{{@root.fct_name}}_gethandle(void);

{{> GPIO_HAL fct='gpio_exti_gethandle' resource=@root.current_resource type='prototype'}}
{{else}}
#warning "step {{fct}} in partial UCPD_HAL not managed"
{{/if~}}
