{{#helper_common_beautifier}}
{{~assign 'current_resource' 'RCC'~}}
{{assign "codegen_ctxt" (helper_common_get_codegen_context 'RCC' (get '') @root.EnvVarAPI @root.peripheralsResourceManagerAPI @root.SWConfigurationAPI)~}}
{{log "RCC template codegen_ctxt:" @root.codegen_ctxt~}}
{{assign 'strategy' @root.codegen_ctxt.strategy~}}
{{assign 'current_resource' @root.codegen_ctxt.current_resource~}}
{{assign 'rcc_ctx' @root.codegen_ctxt.instances.[0].config~}}
{{~helper_rcc_init_codegen @root}}
{{~assign 'current_layer' @root.rcc_ctx.info.layer ~}}
{{~assign 'all_resources' (helper_rcc_get_all_resources) ~}}
{{~assign 'all_ppp_clock_configs' (helper_rcc_get_all_perifs_clock_config @root.all_resources) ~}}
{{~assign 'system_config' (helper_rcc_get_system_config @root.rcc_ctx) ~}}
{{~assign 'used_oscillators' (helper_rcc_get_used_osc @root.system_config @root.all_ppp_clock_configs) ~}}
{{~assign 'only_ll' (helper_common_check_if_only_ll @root.EnvVarAPI)~}}
/**
  ******************************************************************************
  * @file           : mx_rcc.h
  * @brief          : Exporting functions for mx_rcc.c
{{> LICENSE}}

/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_RCC_H
#define MX_RCC_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{#if @root.only_ll}}
#include "stm32_ll.h"
{{else}}
#include "stm32_hal.h"
  {{#if (eq @root.current_layer 'LL')}}
#include "stm32_ll.h"
  {{/if}}
{{/if}}
#include "mx_def.h"

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#if (eq @root.current_layer 'LL')}}
#define USE_{{uppercase @root.current_resource}}
{{/if}}
{{helper_gpio_generate_aliases @root.pinoutAPI @root.current_resource @root.current_layer~}}

/* Exported macros -----------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{assign 'current_index' 0~}}
{{#with @root.rcc_ctx}}
/******************************************************************************/
/* Exported functions for RCC in {{@root.current_layer}} layer */
/******************************************************************************/
  {{~assign 'fct_name' (helper_common_get_generated_function_name 'RCC' @root.current_layer @root.config_index)~}}
  {{~assign 'config_index' (add @root.config_index 1)}}
system_status_t {{@root.fct_name}}_init(void);
void {{@root.fct_name}}_deinit(void);

{{> CORTEX fct='generate_irqhandler' type='prototype' component='RCC'}}
{{#if (eq @root.current_layer 'HAL')}}
{{> GPIO_HAL fct='gpio_exti_gethandle' resource=@root.current_resource type='prototype'}}

{{> GPIO_HAL fct='init_resource_independently' resource=@root.current_resource init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}
{{else}}
{{> GPIO_LL fct='init_resource_independently' resource=@root.current_resource init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}
{{/if}}

{{#if @root.rcc_ctx.basic.lse.enable_css}}
  {{#if (and (eq @root.current_layer 'HAL') @root.rcc_ctx.system.nvic.lse_css_irq_handler_generation)}}
void RCC_IRQHandler(void);
  {{/if}}
{{/if~}}

{{/with}}

{{~#if (helper_rcc_is_controlled_by_periph @root.rcc_ctx)}}
  {{#each @root.all_resources}}
    {{#if (helper_rcc_is_clock_config_needed this)}}

system_status_t mx_rcc_{{lowercase this}}_clock_config(void);
system_status_t mx_rcc_{{lowercase this}}_clock_deactivate(void);
    {{/if}}
  {{/each~}}
{{else}}

system_status_t mx_rcc_peripherals_clock_config(void);
{{/if~}}


{{~#unless (helper_rcc_is_central @root.rcc_ctx)}}
  {{#each used_oscillators}}

system_status_t mx_rcc_{{lowercase this}}_clock_config(uint32_t nb_resources);
system_status_t mx_rcc_{{lowercase this}}_clock_deactivate(void);
  {{/each~}}


  {{#eachObject @root.system_config.pll_used}}
    {{#if (or (include @root.all_ppp_clock_configs value.name) (eq @root.system_config.clock_source.pll_name value.name))}}

system_status_t mx_rcc_pll{{value.idx}}_config(void);
system_status_t mx_rcc_pll{{value.idx}}_deactivate(void);

      {{#each value.outputs}}
        {{~assign 'pll_output' (lowercase this)~}}
        {{#if (or
            (and (eq ../value.idx 1) (or (eq @root.pll_output 'p') (eq @root.pll_output 'q') (eq @root.pll_output 's')))
            (and (eq ../value.idx 2) (or (eq @root.pll_output 'p') (eq @root.pll_output 'q') (eq @root.pll_output 'r') (eq @root.pll_output 's') (eq @root.pll_output 't')))
            (and (eq ../value.idx 3) (or (eq @root.pll_output 'p') (eq @root.pll_output 'q') (eq @root.pll_output 'r') (eq @root.pll_output 's')))
        )}}
system_status_t mx_rcc_pll{{../value.idx}}_output_{{this}}_config(uint32_t nb_resources);
system_status_t mx_rcc_pll{{../value.idx}}_output_{{this}}_deactivate(void);
      {{/if}}
      {{/each}}
    {{/if}}

  {{/eachObject~}}

{{/unless}}

{{#if @root.rcc_ctx.runtime.crypto_reset}}

/******************************************************************************/
/* Runtime APIs                                                               */
/******************************************************************************/
{{! Declare crypto reset function when at least one crypto IP (CCB/PKA/RNG/SAES) is active ~}}
  {{~assign 'crypto_reset_info' (helper_rcc_get_active_crypto_ips @root.all_resources)~}}
  {{#if @root.crypto_reset_info.has_crypto~}}
void mx_rcc_crypto_reset(void);

  {{/if}}
{{/if}}

#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_RCC_H */
{{/helper_common_beautifier}}
