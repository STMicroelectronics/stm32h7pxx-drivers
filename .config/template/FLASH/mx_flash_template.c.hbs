hal_{{lowercase @root.current_resource}}_handle_t *{{@root.fct_name}}_init(void)
{
  if (HAL_FLASH_Init(&h{{@root.current_resource}}, HAL_{{uppercase @root.current_resource}}) != HAL_OK)
  {
   return NULL;
  }
      {{#each additional.bank}}
        {{#if use_bank}}
          {{#if use_flash_programming}}

  if (HAL_FLASH_SetBankProgrammingMode(&h{{@root.current_resource}}, HAL_FLASH_BANK_{{_foreignKey}}, HAL_FLASH_PROGRAM_{{programming_mode}}) != HAL_OK)
  {
    return NULL;
  }
          {{/if}}
          {{#if enable_single_ecc_interrupt}}
            {{#if enable_double_ecc_interrupt}}

  HAL_FLASH_ITF_ECC_EnableIT(HAL_{{@root.current_resource}}, HAL_FLASH_BANK_{{_foreignKey}}, HAL_FLASH_ITF_IT_ECC_ALL);
            {{else}}

  HAL_FLASH_ITF_ECC_EnableIT(HAL_{{@root.current_resource}}, HAL_FLASH_BANK_{{_foreignKey}}, HAL_FLASH_ITF_IT_ECC_SINGLE);
            {{/if}}
          {{else}}
            {{#if enable_double_ecc_interrupt}}

  HAL_FLASH_ITF_ECC_EnableIT(HAL_{{@root.current_resource}}, HAL_FLASH_BANK_{{_foreignKey}}, HAL_FLASH_ITF_IT_ECC_DOUBLE);
            {{/if}}
          {{/if}}
        {{/if}}
      {{/each}}
      {{#if additional.use_flash_crc_calculation}}

  if (HAL_FLASH_SetCRCBurstSize(&h{{@root.current_resource}}, HAL_FLASH_CRC_BURST_SIZE_{{additional.crc_burst_size}}) != HAL_OK)
  {
    return NULL;
  }
      {{/if}}
      {{~#with system.nvic}}
        {{#if (and enable_interruption (eq enable_interruption true))}}
  /* Enable the interuption for FLASH */
{{~assign 'complex_nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.complex_nvic_context irq_config1.needs @root.current_resource irq_handler_generation)}}
{{> CORTEX fct='init' layer=@root.current_layer needs=irq_config1.needs}}
        {{~/if}}
        {{#if (and enable_management_flash_ecc_exception (eq enable_management_flash_ecc_exception true))}}
{{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context busfault_config1.needs @root.current_resource irq_handler_generation_flash_ecc_exception)}}
{{~assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context hardfault_config1.needs @root.current_resource irq_handler_generation_flash_ecc_exception)}}
        {{/if}}
      {{~/with}}


  return &h{{@root.current_resource}};
}

