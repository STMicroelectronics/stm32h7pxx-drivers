          {{~#if enable_single_ecc_interrupt}}

  LL_FLASH_EnableIT_SNECCERR({{@root.current_resource}}, LL_FLASH_BANK_{{_foreignKey}});
          {{~/if}}
          {{~#if enable_double_ecc_interrupt}}

  LL_FLASH_EnableIT_DBECCERR({{@root.current_resource}}, LL_FLASH_BANK_{{_foreignKey}});
