/******************************************************************************/
/* Exported functions for {{@root.current_resource}} in {{@root.current_layer}} layer                                    */
/******************************************************************************/
    {{~assign 'pwr_root_fct_name' (helper_common_get_generated_function_name 'PWR' @root.current_layer)~}}
    {{~assign 'current_config' this}}
    {{~assign 'enabled_pins' ''}}
    {{~assign 'enabled_pins_wkup1_4' ''}}
    {{~assign 'enabled_pins_wkup5_8' ''}}
    {{~assign 'pins_configs' (helper_pwr_get_wakeup_settings additional.wakeup_pins_configuration @root.current_layer)}}
    {{#if additional.ram_configuration}}
      {{~assign 'sram_configs' (helper_pwr_sram_retention_config additional.ram_configuration @root.current_layer)~}}
    {{/if}}
    {{~assign 'found_exti' false}}
    {{~assign 'found_wkup1_exti' false}}
    {{~assign 'found_wkup2_exti' false}}
    {{~assign 'found_wkup3_exti' false}}
    {{~assign 'found_wkup4_exti' false}}
    {{~assign 'found_wkup5_exti' false}}
    {{~assign 'found_wkup6_exti' false}}
    {{~assign 'found_wkup7_exti' false}}
    {{~assign 'found_wkup8_exti' false}}
    {{~assign 'found_pvd_exti' false}}
    {{~assign 'found_avd_exti' false}}
    {{~assign 'found_pvd_avd_exti' false}}
    {{#if (eq @root.current_layer 'HAL')}}
{{!
    Generation of initialization function used in HAL
~}}
system_status_t {{@root.pwr_root_fct_name}}_init(void)
{
      {{#if (length @root.pins_configs)}}
  hal_pwr_wakeup_pin_config_t wkup_config;

      {{/if}}
      {{#> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}
      {{/RCC}}
      {{#with additional}}
        {{#if (and (not (eq @root.codegen_ctxt.init_model 1)) (or (eq status_pins_configuration.enable_csleep true)(eq status_pins_configuration.enable_cstop true)(eq status_pins_configuration.enable_srdstop true)(and (eq voltage_detection_configuration.pvd_configuration.enable true)(eq voltage_detection_configuration.pvd_configuration.level_selection '8'))))}}
  /****************************************************************************/
  /* GPIO configuration                                                       */
  /****************************************************************************/
          {{#> GPIO_HAL fct='init_resource' resource=@root.current_resource return_if_failed='SYSTEM_POWER_ERROR' init_model=@root.codegen_ctxt.init_model fct_name=@root.pwr_root_fct_name~}}
          {{/GPIO_HAL}}

        {{/if}}
        {{#with main_supply_configuration}}
          {{#if (or stop_voltage_scaling (not (inArray @root.modules_activated 'RCC')))}}
  /****************************************************************************/
  /* Main supply configuration                                                */
  /****************************************************************************/
            {{#if (not (inArray @root.modules_activated 'RCC'))}}
              {{#> PWR_HAL fct='generate_vos_config'~}}
              {{/PWR_HAL}}

            {{/if}}
            {{#if stop_voltage_scaling}}
  /* Stop Voltage scaling configuration */
  HAL_PWR_LP_SetMainRegulatorStopVoltageScalingRange(HAL_PWR_STOP_{{stop_voltage_scaling}});

            {{/if}}
          {{/if}}
        {{/with}}
        {{#with independent_supply_configuration}}
          {{#if (or enable_vddusb_supply (and (not (inArray @root.modules_activated 'ANALOG')) (or (eq analog_io_switch_supply 'VDDA_SUPPLY') (eq analog_io_switch_supply 'BOOSTER_SUPPLY') (eq analog_io_switch_supply 'VDD_SUPPLY'))))}}
  /****************************************************************************/
  /* Independent supply configuration                                         */
  /****************************************************************************/
            {{#if enable_vddusb_supply}}
              {{#if (not (or (inArray @root.modules_activated 'USB_DRD_FS.HOST') (inArray @root.modules_activated 'USB_DRD_FS.DEVICE')))}}
                {{#> PWR_HAL fct='generate_peripheral_supply_activation' hw_resource='USB'}}
                {{/PWR_HAL}}

              {{/if}}
            {{/if}}
            {{#if (and (not (inArray @root.modules_activated 'ANALOG')) (not (eq analog_io_switch_supply 'NONE')))}}
              {{#> PWR_HAL fct='generate_peripheral_supply_activation' hw_resource='ADC'}}
              {{/PWR_HAL}}

            {{/if}}
          {{/if}}
        {{/with}}
        {{#with voltage_detection_configuration}}
          {{#if pvd_configuration.enable}}
  /****************************************************************************/
  /* Configuration of PVD (Programmable Voltage Detector)                     */
  /****************************************************************************/
            {{#with pvd_configuration}}
              {{#if level_selection}}
                {{~assign 'voltage_reference' (helper_pwr_get_pvdin_or_vdd_level level_selection (@root.peripheralsResourceManagerAPI.getHardwareIpDescription "PWR"))~}}
                {{!~ Line break because of the helper above}}
  /* Configure PVD Level */
  HAL_PWR_SetProgrammableVoltageDetectorLevel(HAL_PWR_PVD_{{@root.voltage_reference}});

              {{/if}}
  /* Enable PVD */
  HAL_PWR_EnableProgrammableVoltageDetector();

              {{#if (eq enable_exti true)}}

  /* Configure PVD EXTI line */
                {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.pvd_exti_needs found_exti=@root.found_exti~}}
                {{/EXTI}}
                {{~assign 'found_exti' true~}}

              {{/if}}
            {{/with}}
          {{/if}}
          {{#if avd_configuration.enable}}
  /****************************************************************************/
  /* Configuration of AVD (Analog Voltage Detector)                           */
  /****************************************************************************/
            {{#with avd_configuration}}
              {{#if level_selection}}
  /* Configure AVD Level */
  HAL_PWR_SetAnalogVoltageDetectorLevel(HAL_PWR_AVD_VDDA_LEVEL_{{level_selection}});

              {{/if}}
  /* Enable AVD */
  HAL_PWR_EnableAnalogVoltageDetector();

              {{#if (eq enable_exti true)}}
  /* Configure AVD EXTI line */
                {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.avd_exti_needs found_exti=@root.found_exti~}}
                {{/EXTI}}
                {{~assign 'found_exti' true~}}

              {{/if}}
            {{/with}}
          {{/if}}
          {{#if (eq enable_exti true)}}
  /* Configure PVD/AVD EXTI line */
            {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.pvd_avd_exti_needs found_exti=@root.found_exti~}}
            {{/EXTI}}
            {{~assign 'found_exti' true~}}

          {{/if}}
          {{#if temperature_vbat_monitoring.enable}}
  /****************************************************************************/
  /* Configuration of VBAT/Temp monitor                                       */
  /****************************************************************************/
  /* Disable RTC Domain Write protection to enable VBAT/Temp monitor */
  HAL_PWR_DisableRTCDomainWriteProtection();

  /* Enable VBAT/Temp monitoring */
  HAL_PWR_EnableTemperatureVbatMonitor();

  /* Enable RTC Domain Write protection to avoid undesired access */
  HAL_PWR_EnableRTCDomainWriteProtection();

          {{/if}}
          {{#if temperature_vdd_monitoring.enable}}
  /****************************************************************************/
  /* Configuration of VDD/Temp monitor                                        */
  /****************************************************************************/
  /* Disable RTC Domain Write protection to enable VDD/Temp monitor */
  HAL_PWR_DisableRTCDomainWriteProtection();

  /* Enable VDD/Temp monitoring */
  HAL_PWR_EnableTemperatureVddMonitor();

  /* Enable RTC Domain Write protection to avoid undesired access */
  HAL_PWR_EnableRTCDomainWriteProtection();

          {{/if}}
        {{/with}}
        {{#with ram_configuration}}
          {{#if (length @root.sram_configs)}}
  /****************************************************************************/
  /* Configuration of RAM retention                                           */
  /****************************************************************************/
            {{#each @root.sram_configs}}
              {{#unless pageStatus}}
                {{#if fullretention}}
                  {{#if (eq mode 'STANDBY_VBAT')}}
                    {{#> PWR_HAL fct='generate_write_protection_disable'}}
                    {{/PWR_HAL}}

  /* For {{sram}} in standby mode, retention is enabled */
  HAL_PWR_LP_EnableMemoryRetention(HAL_PWR_MEMORY_RETENTION_{{sram}}_{{mode}});

                    {{#> PWR_HAL fct='generate_write_protection_enable'}}
                    {{/PWR_HAL}}
                  {{else}}
  /* For {{sram}} in {{lowercase mode}} mode, retention is disabled */
  HAL_PWR_LP_DisableMemoryRetention(HAL_PWR_MEMORY_RETENTION_{{sram}}_{{mode}});
                  {{/if}}

                {{else}}
                  {{#if isFirstOfGroup}}
                    {{#if enabledPagesStr}}
  /* For {{sram}} in {{lowercase mode}} mode, retention is enabled only for pages {{enabledPagesStr}} */
                    {{else}}
  /* For {{sram}} in {{lowercase mode}} mode, memory retention is disabled on all pages */
                    {{/if}}
                  {{/if}}
  HAL_PWR_LP_DisableMemoryPageRetention(HAL_PWR_MEMORY_RETENTION_{{sram}}_{{mode}}, {{page_idx}}, {{page_nbr}});

                {{/if}}
              {{/unless}}
            {{/each}}
          {{/if}}
        {{/with}}
        {{#if flash_low_power_configuration.enable_flash_low_power_mode}}
  /****************************************************************************/
  /* Configuration of FLASH low power mode                                    */
  /****************************************************************************/
  HAL_PWR_LP_EnableFlashLowPWRMode();

        {{/if}}
        {{#if nvm_low_power_configuration.enable_nvm_low_power_mode}}
  /****************************************************************************/
  /* Configuration of NVM low power mode                                      */
  /****************************************************************************/
  HAL_PWR_LP_EnableNVMLowPWRMode();

        {{/if}}
        {{#if battery_configuration.enable_battery_charging}}
  /****************************************************************************/
  /* Configuration of the battery charging management                         */
  /****************************************************************************/
  /* Configure battery charging resistor value */
  HAL_PWR_SetConfigBatteryCharging(HAL_PWR_BATTERY_CHARGING_RES_{{battery_configuration.battery_charging_resistor_selection}});

  /* Enable battery charging */
  HAL_PWR_EnableBatteryCharging();

        {{/if}}
        {{#with ucpd_configuration}}
  /****************************************************************************/
  /* Configuration of the UCPD (USB Type-C and Power Delivery) PWR features   */
  /****************************************************************************/
          {{#if (not (inArray @root.modules_activated 'UCPD1'))}}
            {{#> PWR_HAL fct='manage_dead_battery'}}
            {{/PWR_HAL}}
          {{/if}}
          {{#if enable_ucpd_config_retention}}
  /* Enable UCPD configuration retention in Standby mode */
  HAL_PWR_LP_EnableUCPDRetention();

          {{else}}
            {{#if (eq @root.PWR_ctx.runtime.mode 'STANDBY_MODE')}}
  /* This bit must be written to 1 just before entering Standby mode when using UCPD,
  and it must be written to 0 after exiting the standby mode and before writing any UCPD register */
            {{/if}}
  /* Disable UCPD configuration retention in Standby mode */
  HAL_PWR_LP_DisableUCPDRetention();

          {{/if}}
        {{/with}}
        {{~assign 'enabled_pins' ''~}}
        {{~assign 'enabled_pins_wkup1_4' ''~}}
        {{~assign 'enabled_pins_wkup5_8' ''~}}
        {{#with wakeup_pins_configuration}}
          {{#if wkup_1_configuration.enable}}
            {{~assign 'enabled_pins_wkup1_4' (helper_pwr_concatenate_pins 'HAL_PWR_WAKEUP_PIN_1' @root.enabled_pins_wkup1_4)~}}
          {{/if}}
          {{#if wkup_2_configuration.enable}}
            {{~assign 'enabled_pins_wkup1_4' (helper_pwr_concatenate_pins 'HAL_PWR_WAKEUP_PIN_2' @root.enabled_pins_wkup1_4)~}}
          {{/if}}
          {{#if wkup_3_configuration.enable}}
            {{~assign 'enabled_pins_wkup1_4' (helper_pwr_concatenate_pins 'HAL_PWR_WAKEUP_PIN_3' @root.enabled_pins_wkup1_4)~}}
          {{/if}}
          {{#if wkup_4_configuration.enable}}
            {{~assign 'enabled_pins_wkup1_4' (helper_pwr_concatenate_pins 'HAL_PWR_WAKEUP_PIN_4' @root.enabled_pins_wkup1_4)~}}
          {{/if}}
          {{#if wkup_5_configuration.enable}}
            {{~assign 'enabled_pins_wkup5_8' (helper_pwr_concatenate_pins 'HAL_PWR_WAKEUP_PIN_5' @root.enabled_pins_wkup5_8)~}}
          {{/if}}
          {{#if wkup_6_configuration.enable}}
            {{~assign 'enabled_pins_wkup5_8' (helper_pwr_concatenate_pins 'HAL_PWR_WAKEUP_PIN_6' @root.enabled_pins_wkup5_8)~}}
          {{/if}}
          {{#if wkup_7_configuration.enable}}
            {{~assign 'enabled_pins_wkup5_8' (helper_pwr_concatenate_pins 'HAL_PWR_WAKEUP_PIN_7' @root.enabled_pins_wkup5_8)~}}
          {{/if}}
          {{#if wkup_8_configuration.enable}}
            {{~assign 'enabled_pins_wkup5_8' (helper_pwr_concatenate_pins 'HAL_PWR_WAKEUP_PIN_8' @root.enabled_pins_wkup5_8)~}}
          {{/if}}
          {{#unless (eq @root.enabled_pins_wkup1_4 '')}}
            {{~assign 'enabled_pins_wkup1_4' (helper_pwr_reorder_pins @root.enabled_pins_wkup1_4)~}}
          {{/unless}}
          {{#unless (eq @root.enabled_pins_wkup5_8 '')}}
            {{~assign 'enabled_pins_wkup5_8' (helper_pwr_reorder_pins @root.enabled_pins_wkup5_8)~}}
          {{/unless}}
          {{~assign 'pull_availability' (helper_pwr_pull_or_source @root.pins_configs)~}}
          {{~helper_pwr_breakpoint (length @root.pins_configs) @root~}}
          {{#if (length @root.pins_configs)}}
  /****************************************************************************/
  /* Wake-up pins configuration                                               */
  /****************************************************************************/
            {{~helper_pwr_breakpoint @root.pull_availability @root}}
            {{#each @root.pins_configs}}
              {{#if @root.pull_availability}}
  /* Configuration of selected wake-up pins with pull {{pull}} and {{polarity}} polarity */
  wkup_config.polarity = HAL_PWR_WAKEUP_PIN_POLARITY_{{polarity}};
  wkup_config.pull     = HAL_PWR_WAKEUP_PIN_PULL_{{pull}};

              {{else}}
  /* Configuration of selected wake-up pins with source {{source}} and {{polarity}} polarity    */
  wkup_config.polarity = HAL_PWR_WAKEUP_PIN_POLARITY_{{polarity}};
  wkup_config.source   = HAL_PWR_WAKEUP_PIN_SOURCE_{{source}};

              {{/if}}
  if (HAL_PWR_LP_SetConfigWakeupPin({{pins}}, &wkup_config) != HAL_OK)
  {
    return SYSTEM_POWER_ERROR;
  }
              {{~assign 'enabled_pins' (helper_pwr_concatenate_pins pins @root.enabled_pins)}}

            {{/each}}
            {{~assign 'enabled_pins' (helper_pwr_reorder_pins @root.enabled_pins)~}}
          {{/if}}
          {{#if (and wkup_1_configuration.enable wkup_1_configuration.enable_exti)}}
  /* Configure wake-up pin 1 EXTI line */
          {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.wkup1_exti_needs found_exti=@root.found_exti~}}
          {{/EXTI}}
          {{~assign 'found_exti' true~}}

          {{/if}}
          {{#if (and wkup_2_configuration.enable wkup_2_configuration.enable_exti)}}
  /* Configure wake-up pin 2 EXTI line */
          {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.wkup2_exti_needs found_exti=@root.found_exti~}}
          {{/EXTI}}
          {{~assign 'found_exti' true~}}

          {{/if}}
          {{#if (and wkup_3_configuration.enable wkup_3_configuration.enable_exti)}}
  /* Configure wake-up pin 3 EXTI line */
          {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.wkup3_exti_needs found_exti=@root.found_exti~}}
          {{/EXTI}}
          {{~assign 'found_exti' true~}}

          {{/if}}
          {{#if (and wkup_4_configuration.enable wkup_4_configuration.enable_exti)}}
  /* Configure wake-up pin 4 EXTI line */
          {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.wkup4_exti_needs found_exti=@root.found_exti~}}
          {{/EXTI}}
          {{~assign 'found_exti' true~}}

          {{/if}}
          {{#if (and wkup_5_configuration.enable wkup_5_configuration.enable_exti)}}
  /* Configure wake-up pin 5 EXTI line */
          {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.wkup5_exti_needs found_exti=@root.found_exti~}}
          {{/EXTI}}
          {{~assign 'found_exti' true~}}

          {{/if}}
          {{#if (and wkup_6_configuration.enable wkup_6_configuration.enable_exti)}}
  /* Configure wake-up pin 6 EXTI line */
          {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.wkup6_exti_needs found_exti=@root.found_exti~}}
          {{/EXTI}}
          {{~assign 'found_exti' true~}}

          {{/if}}
          {{#if (and wkup_7_configuration.enable wkup_7_configuration.enable_exti)}}
  /* Configure wake-up pin 7 EXTI line */
          {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.wkup7_exti_needs found_exti=@root.found_exti~}}
          {{/EXTI}}
          {{~assign 'found_exti' true~}}

          {{/if}}
          {{#if (and wkup_8_configuration.enable wkup_8_configuration.enable_exti)}}
  /* Configure wake-up pin 8 EXTI line */
          {{#> EXTI fct='exti_get_init' layer=@root.current_layer needs=@root.wkup8_exti_needs found_exti=@root.found_exti~}}
          {{/EXTI}}
          {{~assign 'found_exti' true~}}

          {{/if}}
          {{#unless (eq @root.enabled_pins '')}}
  /****************************************************************************/
  /* Enable all configured wake-up pins                                       */
  /****************************************************************************/
  HAL_PWR_LP_EnableWakeupPin({{@root.enabled_pins}});

          {{/unless}}
        {{/with}}
        {{#with io_retention}}
          {{#if (or (eq all_io true)(eq jtag_io true))}}
  /****************************************************************************/
