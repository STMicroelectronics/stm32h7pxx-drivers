    {{#if (and additional.wakeup_pins_configuration.wkup_1_configuration.enable additional.wakeup_pins_configuration.wkup_1_configuration.enable_exti)}}
      {{~assign 'wkup1_exti_needs' system.exti.wkup1_exti_config.needs~}}
