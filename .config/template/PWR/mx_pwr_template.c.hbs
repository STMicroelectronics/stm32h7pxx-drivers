      {{/GPIO_HAL}}
    {{/if}}
    {{#if (and additional.voltage_detection_configuration.pvd_configuration.enable_exti additional.voltage_detection_configuration.pvd_configuration.enable)~}}
      {{~assign 'pvd_exti_needs' system.exti.pvd_exti_config.needs~}}
      {{#> EXTI fct='exti_get_variables' layer=@root.current_layer needs=@root.pvd_exti_needs~}}
