    {{#if (and additional.wakeup_pins_configuration.wkup_2_configuration.enable additional.wakeup_pins_configuration.wkup_2_configuration.enable_exti)}}
      {{~assign 'wkup2_exti_needs' system.exti.wkup2_exti_config.needs~}}
      {{#> EXTI fct='exti_get_variables' layer=@root.current_layer needs=@root.wkup2_exti_needs~}}
