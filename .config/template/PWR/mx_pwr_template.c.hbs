    {{#if (and additional.wakeup_pins_configuration.wkup_5_configuration.enable additional.wakeup_pins_configuration.wkup_5_configuration.enable_exti)}}
      {{~assign 'wkup5_exti_needs' system.exti.wkup5_exti_config.needs~}}
      {{#> EXTI fct='exti_get_variables' layer=@root.current_layer needs=@root.wkup5_exti_needs~}}
      {{/EXTI}}
    {{/if}}
    {{#if (and additional.wakeup_pins_configuration.wkup_6_configuration.enable additional.wakeup_pins_configuration.wkup_6_configuration.enable_exti)}}
      {{~assign 'wkup6_exti_needs' system.exti.wkup6_exti_config.needs~}}
      {{#> EXTI fct='exti_get_variables' layer=@root.current_layer needs=@root.wkup6_exti_needs~}}
