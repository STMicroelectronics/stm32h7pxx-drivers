{
      {{#> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}
      {{/RCC}}
      {{#with additional}}
        {{#if (or (eq status_pins_configuration.enable_csleep true)(eq status_pins_configuration.enable_cstop true)(eq status_pins_configuration.enable_srdstop true)(and (eq voltage_detection_configuration.pvd_configuration.enable true)(eq voltage_detection_configuration.pvd_configuration.level_selection '8')))}}
  /****************************************************************************/
  /* Status pin GPIO Deinitialization                                         */
  /****************************************************************************/
          {{#> GPIO_HAL fct='deinit_resource' resource=@root.current_resource}}
          {{/GPIO_HAL}}

        {{/if}}
        {{#unless (eq @root.enabled_pins '')}}
  /****************************************************************************/
  /* Disable all configured wake-up pins                                      */
  /****************************************************************************/
  HAL_PWR_LP_DisableWakeupPin({{@root.enabled_pins}});

        {{/unless}}
        {{#with voltage_detection_configuration}}
          {{#if pvd_configuration.enable}}
            {{#if (eq pvd_configuration.enable_exti true)}}
  /* Deinit PVD EXTI line */
              {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.pvd_exti_needs}}
              {{/EXTI}}

            {{/if}}
          {{/if}}
          {{#if avd_configuration.enable}}
            {{#if (eq avd_configuration.enable_exti true)}}
  /* Deinit AVD EXTI line */
              {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.avd_exti_needs}}
              {{/EXTI}}

            {{/if}}
          {{/if}}
          {{#if (eq enable_exti true)}}
  /* Deinit PVD/AVD EXTI line */
            {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.pvd_avd_exti_needs}}
            {{/EXTI}}

          {{/if}}
        {{/with}}
        {{#with wakeup_pins_configuration}}
          {{#if (and wkup_1_configuration.enable wkup_1_configuration.enable_exti)}}
  /* Deinit wake-up 1 EXTI line */
            {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.wkup1_exti_needs}}
            {{/EXTI}}

          {{/if}}
          {{#if (and wkup_2_configuration.enable wkup_2_configuration.enable_exti)}}
  /* Deinit wake-up 2 EXTI line */
            {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.wkup2_exti_needs}}
            {{/EXTI}}

          {{/if}}
          {{#if (and wkup_3_configuration.enable wkup_3_configuration.enable_exti)}}
  /* Deinit wake-up 3 EXTI line */
            {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.wkup3_exti_needs}}
            {{/EXTI}}

          {{/if}}
          {{#if (and wkup_4_configuration.enable wkup_4_configuration.enable_exti)}}
  /* Deinit wake-up 4 EXTI line */
            {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.wkup4_exti_needs}}
            {{/EXTI}}

          {{/if}}
          {{#if (and wkup_5_configuration.enable wkup_5_configuration.enable_exti)}}
  /* Deinit wake-up 5 EXTI line */
            {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.wkup5_exti_needs}}
            {{/EXTI}}

          {{/if}}
          {{#if (and wkup_6_configuration.enable wkup_6_configuration.enable_exti)}}
  /* Deinit wake-up 6 EXTI line */
            {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.wkup6_exti_needs}}
            {{/EXTI}}

          {{/if}}
          {{#if (and wkup_7_configuration.enable wkup_7_configuration.enable_exti)}}
  /* Deinit wake-up 7 EXTI line */
            {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.wkup7_exti_needs}}
            {{/EXTI}}

          {{/if}}
          {{#if (and wkup_8_configuration.enable wkup_8_configuration.enable_exti)}}
  /* Deinit wake-up 8 EXTI line */
            {{#> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=@root.wkup8_exti_needs}}
            {{/EXTI}}

          {{/if}}
        {{/with}}
        {{#with independent_supply_configuration}}
          {{#if enable_vddusb_supply}}
            {{#if (not (or (inArray @root.modules_activated 'USB_DRD_FS.HOST') (inArray @root.modules_activated 'USB_DRD_FS.DEVICE')))}}
              {{#> PWR_HAL fct='generate_peripheral_supply_deactivation' hw_resource='USB'}}
              {{/PWR_HAL}}

            {{/if}}
          {{/if}}
        {{/with}}
      {{/with}}
  return SYSTEM_OK;
}

