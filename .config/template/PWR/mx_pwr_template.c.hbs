    {{#if (and additional.wakeup_pins_configuration.wkup_4_configuration.enable additional.wakeup_pins_configuration.wkup_4_configuration.enable_exti)}}
      {{~assign 'wkup4_exti_needs' system.exti.wkup4_exti_config.needs~}}
