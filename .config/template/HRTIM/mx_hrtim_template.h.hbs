{{> LICENSE}}

/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{@root.current_resource}}_H
#define MX_{{@root.current_resource}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{assign 'only_ll' true~}}
{{assign 'include_mx_def' false~}}
{{#each @root.instances~}}
{{assign 'hrtim_cxt' config~}}
{{assign 'current_resource' current_resource~}}
{{assign 'current_layer' @root.hrtim_cxt.info.layer~}}
{{#if (eq @root.current_layer 'HAL')}}
{{assign 'only_ll' false~}}
{{/if}}
{{#with @root.hrtim_cxt.security_privilege}}
{{#unless @root.include_mx_def}}
{{~assign 'include_mx_def' true~}}
#include "mx_def.h"
{{/unless}}
{{/with}}
{{/each}}
{{#unless @root.include_mx_def}}
  {{#if (gt @root.codegen_ctxt.init_model 0)}}
#include "mx_def.h"
  {{/if}}
{{/unless}}
{{#if @root.only_ll}}
#include "stm32_ll.h"
{{else}}
#include "stm32_hal.h"
{{/if}}

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#each @root.instances}}
{{assign 'hrtim_cxt' config~}}
{{assign 'current_resource' current_resource~}}
{{assign 'current_layer' @root.hrtim_cxt.info.layer}}
  {{#with @root.hrtim_cxt}}
    {{#if (eq @root.current_layer 'HAL')}}
      {{#each basic.timers}}
        {{#if use}}
          {{#with timer_config}}
            {{#if dma_request_sources}}
              {{#if dma_request_sources.length}}
/* {{@root.current_resource}} {{../_foreignKey}} DMA request mask */
#define DMA_REQUEST_{{@root.current_resource}}_{{helper_hrtim_convert_timer ../_foreignKey}} ({{#each dma_request_sources}}HAL_HRTIM_OPT_DMA_{{source}}{{#unless @last}} \
                                | {{/unless}}{{/each}})
              {{/if}}
            {{/if}}
          {{/with}}
        {{/if}}
      {{/each}}
    {{else}}
#define USE_{{uppercase @root.current_resource}}
    {{/if}}

    {{~assign 'desc_labels' 0~}}
    {{#each basic.timers as |timer|}}
      {{#each labels}}
        {{#if (length this)}}
          {{#if (eq @root.desc_labels 0)}}
            {{~assign 'desc_labels' 1}}
/* Aliases of {{@root.current_resource}} timer labels */
          {{/if}}
          {{#if (eq @root.current_layer 'HAL')}}
#define {{uppercase this}}_TIMER  HAL_HRTIM_{{helper_hrtim_convert_timer timer._foreignKey}}
          {{else}}
#define {{uppercase this}}_TIMER  LL_HRTIM_{{helper_hrtim_convert_timer timer._foreignKey}}
          {{/if}}
        {{/if}}
      {{/each}}
    {{/each}}

    {{~assign 'desc_labels' 0~}}
    {{#each channels.outputs as |output|}}
      {{#each labels}}
        {{#if (length this)}}
          {{#if (eq @root.desc_labels 0)}}
            {{~assign 'desc_labels' 1}}
/* Aliases of {{@root.current_resource}} output labels */
          {{/if}}
          {{#if (eq @root.current_layer 'HAL')}}
#define {{uppercase this}}_OUTPUT  HAL_HRTIM_{{output._foreignKey}}
          {{else}}
#define {{uppercase this}}_OUTPUT  LL_HRTIM_OUTPUT_{{output._foreignKey}}
          {{/if}}
        {{/if}}
      {{/each}}
    {{/each}}

    {{~assign 'desc_labels' 0~}}
    {{#each channels.external_events as |external_event|}}
      {{#each labels}}
        {{#if (length this)}}
          {{#if (eq @root.desc_labels 0)}}
            {{~assign 'desc_labels' 1}}
/* Aliases of {{@root.current_resource}} external event labels */
          {{/if}}
          {{#if (eq @root.current_layer 'HAL')}}
#define {{uppercase this}}_EXTERNAL_EVENT  HAL_HRTIM_{{external_event._foreignKey}}
          {{else}}
#define {{uppercase this}}_EXTERNAL_EVENT  LL_HRTIM_{{external_event._foreignKey}}
          {{/if}}
        {{/if}}
      {{/each}}
    {{/each}}

    {{~assign 'desc_labels' 0~}}
    {{#each channels.fault_inputs as |fault_input|}}
      {{#each labels}}
        {{#if (length this)}}
          {{#if (eq @root.desc_labels 0)}}
            {{~assign 'desc_labels' 1}}
/* Aliases of {{@root.current_resource}} fault input labels */
          {{/if}}
          {{#if (eq @root.current_layer 'HAL')}}
#define {{uppercase this}}_FAULT_INPUT  HAL_HRTIM_{{fault_input._foreignKey}}
          {{else}}
#define {{uppercase this}}_FAULT_INPUT  LL_HRTIM_{{fault_input._foreignKey}}
          {{/if}}
        {{/if}}
      {{/each}}
    {{/each}}

    {{#if (and info.labels (gt (length info.labels) 0))}}
      {{~assign 'labels' info.labels~}}
      {{~assign 'found_irq' false~}}
      {{~assign 'hrtim_needs' 'undefined'~}}
      {{#with System.NVIC_Settings}}
        {{#if EnableInterruptionFLT}}
          {{~assign 'hrtim_needs' (helper_common_concatenate_needs nvicConfigFLT.needs @root.hrtim_needs)~}}
        {{/if}}
        {{#if EnableInterruptionM}}
          {{~assign 'hrtim_needs' (helper_common_concatenate_needs nvicConfigM.needs @root.hrtim_needs)~}}
        {{/if}}
        {{#if EnableInterruptionTIMA}}
          {{~assign 'hrtim_needs' (helper_common_concatenate_needs nvicConfigTIMA.needs @root.hrtim_needs)~}}
        {{/if}}
        {{#if EnableInterruptionTIMB}}
          {{~assign 'hrtim_needs' (helper_common_concatenate_needs nvicConfigTIMB.needs @root.hrtim_needs)~}}
        {{/if}}
        {{#if EnableInterruptionTIMC}}
          {{~assign 'hrtim_needs' (helper_common_concatenate_needs nvicConfigTIMC.needs @root.hrtim_needs)~}}
        {{/if}}
        {{#if EnableInterruptionTIMD}}
          {{~assign 'hrtim_needs' (helper_common_concatenate_needs nvicConfigTIMD.needs @root.hrtim_needs)~}}
        {{/if}}
        {{#if EnableInterruptionTIME}}
          {{~assign 'hrtim_needs' (helper_common_concatenate_needs nvicConfigTIME.needs @root.hrtim_needs)~}}
        {{/if}}
        {{#if EnableInterruptionTIMF}}
          {{~assign 'hrtim_needs' (helper_common_concatenate_needs nvicConfigTIMF.needs @root.hrtim_needs)~}}
        {{/if}}
      {{/with}}
{{> CORTEX fct='cortex_create_aliases' hw_resource=@root.current_resource labels=@root.labels needs=@root.hrtim_needs}}
    {{/if}}
{{helper_gpio_generate_aliases @root.pinoutAPI @root.current_resource @root.current_layer~}}
{{helper_dma_generate_channel_aliases @root.current_resource @root.DmaAPI @root.SWConfigurationAPI~}}
  {{/with}}
{{/each}}
/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */

{{assign 'current_index' 0~}}
{{#each @root.instances}}
{{~assign 'hrtim_cxt' config~}}
{{~assign 'current_resource' current_resource~}}
{{~assign 'current_layer' @root.hrtim_cxt.info.layer~}}
{{~assign 'current_index' (helper_common_get_index @root.current_resource)~}}
/******************************************************************************/
/* Exported functions for HRTIM in {{@root.current_layer}} layer */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index undefined 'hrtim_h_exp_proto')~}}
{{assign 'current_index' (add @root.current_index 1)~}}
{{#with @root.hrtim_cxt}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  * @retval pointer to handle or NULL in case of failure
  */
{{#if (eq @root.current_layer 'HAL')}}
hal_hrtim_handle_t *{{@root.fct_name}}_init(void);
{{else}}
HRTIM_TypeDef *{{@root.fct_name}}_init(void);
{{/if}}

/**
  * @brief  De-initialize {{@root.fct_name}} instance and return it.
  */
void {{@root.fct_name}}_deinit(void);

{{#with security_privilege}}
{{#if (eq @root.getCurrentEngine.secure 'Non-secure')}}
/**
  * @brief Peripheral privilege configuration function
  * @retval system_status_t
  */
system_status_t {{@root.fct_name}}_config_privilege(void);
{{else}}
/**
  * @brief Peripheral security and privilege configuration function
  * @retval system_status_t
  */
system_status_t {{@root.fct_name}}_config_security_privilege(void);
{{/if}}

{{/with}}

{{#if (eq @root.current_layer 'HAL')}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined undefined 'hrtim_h_exp_handle')~}}
/**
  * @brief  Get the {{@root.fct_name}} object.
  * @retval Pointer on the {{@root.fct_name}} Handle
  */
hal_hrtim_handle_t *{{@root.fct_name}}_gethandle(void);

{{> GPIO_HAL fct='init_resource_independently' resource=@root.current_resource init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}

{{> GPIO_HAL fct='gpio_exti_gethandle' resource=@root.current_resource type='prototype'}}
{{/if}}
{{#if (eq @root.current_layer 'LL')}}
{{> GPIO_LL fct='init_resource_independently' resource=@root.current_resource init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}

{{> DMA_LL fct='get_dma_lli_reg' resource=@root.dma_resource strategy=@root.strategy type='prototype'}}
{{/if}}
{{#with system}}
{{#with dma}}
{{#if (eq @root.current_layer 'HAL')}}
{{#if enable_dma_master}}
{{> DMA_HAL fct='init_independently' needs=dma_config_master.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}

{{/if}}
{{#if enable_dma_tima}}
{{> DMA_HAL fct='init_independently' needs=dma_config_tima.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}

{{/if}}
{{#if enable_dma_timb}}
{{> DMA_HAL fct='init_independently' needs=dma_config_timb.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}

{{/if}}
{{#if enable_dma_timc}}
{{> DMA_HAL fct='init_independently' needs=dma_config_timc.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}

{{/if}}
{{#if enable_dma_timd}}
{{> DMA_HAL fct='init_independently' needs=dma_config_timd.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}

{{/if}}
{{#if enable_dma_time}}
{{> DMA_HAL fct='init_independently' needs=dma_config_time.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}

{{/if}}
{{#if enable_dma_timf}}
{{> DMA_HAL fct='init_independently' needs=dma_config_timf.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}

{{/if}}
{{else}}
{{#if enable_dma_master}}
{{> DMA_LL fct='init_independently' needs=dma_config_master.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}

{{/if}}
{{#if enable_dma_tima}}
{{> DMA_LL fct='init_independently' needs=dma_config_tima.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}

{{/if}}
{{#if enable_dma_timb}}
{{> DMA_LL fct='init_independently' needs=dma_config_timb.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}

{{/if}}
{{#if enable_dma_timc}}
{{> DMA_LL fct='init_independently' needs=dma_config_timc.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}

{{/if}}
{{#if enable_dma_timd}}
{{> DMA_LL fct='init_independently' needs=dma_config_timd.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}

{{/if}}
{{#if enable_dma_time}}
{{> DMA_LL fct='init_independently' needs=dma_config_time.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}

{{/if}}
{{#if enable_dma_timf}}
{{> DMA_LL fct='init_independently' needs=dma_config_timf.needs init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name type='prototype'}}

{{/if}}
{{/if}}
{{/with}}{{!dma ~}}
{{/with}}{{!system}}
{{/with}}{{!hrtim_cxt~}}
{{/each}}{{!instances~}}
{{assign 'nvic_context' (helper_cortex_nvic_get_irqline_info_list @root.NvicAPI @root.nvic_needs @root.current_resource 'HRTIM' @root.function)~}}
{{#each @root.irq_info_list}}
{{#if generate_handler}}
/******************************************************************************/
/*                     {{description}}                    */
