{{#helper_common_beautifier}}
{{assign "codegen_ctxt" (helper_common_get_codegen_context 'CORTEX_NVIC' (get '') @root.EnvVarAPI @root.peripheralsResourceManagerAPI @root.SWConfigurationAPI)~}}
{{log "CORTEX_NVIC template codegen_ctxt:" @root.codegen_ctxt~}}
{{assign 'strategy' @root.codegen_ctxt.strategy~}}
{{assign 'current_resource' @root.codegen_ctxt.current_resource~}}
{{assign 'instances' @root.codegen_ctxt.instances~}}
