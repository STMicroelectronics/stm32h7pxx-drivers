system_status_t mx_cortex_mpu_init(void)
{
  /* Disables the MPU */
  ARM_MPU_Disable();
      {{~#if basic.mpu_enabled}}
        {{~#with additional}}
          {{~assign 'found_region' false}}
          {{~#each regions}}
            {{~#if use_region}}
              {{~#unless @root.found_region}}
                {{~assign 'found_region' true}}

  /*
     Initializes and configures the MPU Region
  */
              {{~/unless}}
              {{~#if instruction_access}}
                {{~assign 'instr_access_value' 'HAL_CORTEX_MPU_EXECUTION_ATTR_ENABLE'}}
              {{~else}}
                {{~assign 'instr_access_value' 'HAL_CORTEX_MPU_EXECUTION_ATTR_DISABLE'}}
              {{~/if}}
              {{~assign 'disable_subregion' (helper_cortex_mpu_get_disable_subregion subregions 'LL')}}


  ARM_MPU_SetRegionEx({{helper_cortex_mpu_get_arm_cmsis_value _foreignKey}}, 0x{{#if (eq base_address 0)}}00000000{{else}}{{uppercase (dec2hex base_address)}}{{/if}},
                      ({{helper_cortex_mpu_get_arm_cmsis_value (concat 'HAL_CORTEX_MPU_REGION_SIZE_' size)}} << MPU_RASR_SIZE_Pos)
                      | ({{helper_cortex_mpu_get_arm_cmsis_value (concat 'HAL_CORTEX_MPU_' (concat attributes.memory_type (concat '_MEM_' (concat attributes.shareability (concat attributes.write_policy attributes.allocation_policy)))))}} &  (MPU_RASR_TEX_Msk | MPU_RASR_B_Msk | MPU_RASR_S_Msk | MPU_RASR_C_Msk))
                      | ({{helper_cortex_mpu_get_arm_cmsis_value (concat 'HAL_CORTEX_MPU_REGION_' access_permission)}} << MPU_RASR_AP_Pos)
                      | ({{helper_cortex_mpu_get_arm_cmsis_value @root.instr_access_value}} << MPU_RASR_XN_Pos)
                      | (0x{{#if @root.disable_subregion}}{{uppercase (dec2hex @root.disable_subregion)}}{{else}}00{{/if}} << MPU_RASR_SRD_Pos));


  STM32_WRITE_REG(MPU->RNR, {{helper_cortex_mpu_get_arm_cmsis_value _foreignKey}});
  STM32_SET_BIT(MPU->RASR, MPU_RASR_ENABLE_Msk);
            {{~/if}}
          {{~/each}}
        {{~/with}}{{! additional}}


  /* Enables the MPU */
        {{~#if basic.during_hardfault}}
          {{~assign 'mpu_hardfault' "HAL_CORTEX_MPU_HARDFAULT_NMI_ENABLE"}}
        {{~else}}
          {{~assign 'mpu_hardfault' "HAL_CORTEX_MPU_HARDFAULT_NMI_DISABLE"}}
        {{~/if}}
        {{~#if basic.default_map_enabled}}
          {{~assign 'default_map' "HAL_CORTEX_MPU_ACCESS_FAULT_ONLY_PRIV"}}
        {{~else}}
          {{~assign 'default_map' "HAL_CORTEX_MPU_ACCESS_FAULT_ALL"}}
        {{~/if}}

  ARM_MPU_Enable({{helper_cortex_mpu_get_arm_cmsis_value @root.mpu_hardfault}} | {{helper_cortex_mpu_get_arm_cmsis_value @root.default_map}});
      {{~/if}}


  return SYSTEM_OK;
}

void mx_cortex_mpu_deinit(void)
{
  /* Disables the MPU */
  ARM_MPU_Disable();
{{~assign 'attrs' (JSONparse '[{"idx": 0}, {"idx": 1}, {"idx": 2}, {"idx": 3},
                               {"idx": 4}, {"idx": 5}, {"idx": 6}, {"idx": 7}]')}}
{{~assign 'regs' (helper_cortex_mpu_get_region_indexes @root.cortex_mpu_cxt.additional.regions)}}
{{#each @root.regs}}

  STM32_WRITE_REG(MPU->RNR, {{idx}});
  STM32_CLEAR_BIT(MPU->RASR, MPU_RASR_ENABLE_Msk);
{{~/each}}


  /*
     Deinitializes and configures the MPU Region to default
  */
{{~#each @root.regs}}

  ARM_MPU_SetRegionEx({{idx}}, 0x00000000,
                      (0x1B << MPU_RASR_SIZE_Pos)
                      | (0x00000000 &  (MPU_RASR_TEX_Msk | MPU_RASR_B_Msk | MPU_RASR_S_Msk | MPU_RASR_C_Msk))
                      | (0x01 << MPU_RASR_AP_Pos)
                      | (0x00 << MPU_RASR_XN_Pos)
                      | (0x00 << MPU_RASR_SRD_Pos));
{{~/each}}

}
    {{~/if}}
  {{~/with}}
{{/each}}
