{{#helper_common_beautifier}}
{{assign "codegen_ctxt" (helper_common_get_codegen_context 'RAMECC' (get '') @root.EnvVarAPI @root.peripheralsResourceManagerAPI @root.SWConfigurationAPI)~}}
