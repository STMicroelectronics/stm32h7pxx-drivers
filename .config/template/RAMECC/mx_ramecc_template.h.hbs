{{#helper_common_beautifier}}
{{assign "codegen_ctxt" (helper_common_get_codegen_context 'RAMECC' (get '') @root.EnvVarAPI @root.peripheralsResourceManagerAPI @root.SWConfigurationAPI)~}}
{{log "RAMECC template codegen_ctxt:" @root.codegen_ctxt~}}
{{assign 'strategy' @root.codegen_ctxt.strategy~}}
{{assign 'current_resource' @root.codegen_ctxt.current_resource~}}
{{assign 'file_name' @root.codegen_ctxt.current_resource~}}
{{assign 'instances' @root.codegen_ctxt.instances~}}
{{assign "_define_" "#define"~}}
/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.file_name}}.h
  * @brief          : Header for mx_{{lowercase @root.file_name}}.c file.
{{> LICENSE}}


/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{@root.file_name}}_H
#define MX_{{@root.file_name}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{~assign 'only_ll' true}}
{{~assign 'generate_global_handler' false~}}
{{#each @root.instances}}
  {{~assign 'ramecc_ctx' config~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' config.info.layer}}
  {{#if (eq @root.current_layer 'HAL')}}
    {{~assign 'only_ll' false~}}
  {{/if}}
{{/each}}
{{#if @root.only_ll}}
#include "stm32_ll.h"
{{else}}
#include "stm32_hal.h"
{{/if}}
#include "mx_def.h"

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{#each @root.instances}}
  {{~assign 'ramecc_ctx' config~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' config.info.layer~}}
  {{#if (eq @root.current_layer 'LL')}}
#define USE_{{uppercase @root.current_resource}}

  {{/if}}
{{/each}}
/* Exported macros -----------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{helper_common_initialize_index~}}
{{#each @root.instances}}
  {{~assign 'ramecc_ctx' config~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' config.info.layer~}}
  {{#with @root.ramecc_ctx}}
/******************************************************************************/
/* Exported functions for {{@root.current_resource}} in {{@root.current_layer}} layer */
/******************************************************************************/
    {{~assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)}}
    {{#if system.nvic.irq_handler_generation}}
      {{~assign 'generate_global_handler' true}}
    {{/if}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  * @retval pointer to handle or NULL in case of failure
  */
    {{#if (eq @root.current_layer 'HAL')}}
hal_ramecc_controller_t {{@root.fct_name}}_init(void);
    {{else}}
RAMECC_TypeDef *{{@root.fct_name}}_init(void);
    {{/if}}

/**
  * @brief  De-initialize {{lowercase @root.current_resource}} instance and return it.
  */
void {{@root.fct_name}}_deinit(void);

    {{#if @root.only_ll}}
      {{~assign 'generate_global_handler' false~}}
    {{/if}}
  {{/with}}
{{/each}}

{{#if (eq @root.generate_global_handler true)}}
/******************************************************************************/
/* RAMECC global interrupt (Grouping interrupts of all active RAMECC instances)*/
/******************************************************************************/
void RAMECC_IRQHandler(void);
{{else}}
/******************************************************************************/
/* RAMECC global interrupt (Grouping interrupts of all active RAMECC instances)*/
/******************************************************************************/
/* void RAMECC_IRQHandler(void); */
{{/if}}

#ifdef __cplusplus
}
#endif /* __cplusplus */

#endif /* MX_{{@root.file_name}}_H */
{{/helper_common_beautifier}}

