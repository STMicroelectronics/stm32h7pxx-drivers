/**
  ******************************************************************************
  * @file           : mx_{{lowercase @root.current_resource}}.c
  * @brief          : {{@root.current_resource}} Peripheral initialization
{{> LICENSE}}

/* Includes ------------------------------------------------------------------*/
#include "mx_{{lowercase @root.current_resource}}.h"
{{> RCC fct='include_rcc'}}

/* Private typedef -----------------------------------------------------------*/
/* Private defines -----------------------------------------------------------*/
/* Private macros ------------------------------------------------------------*/
/* Private variables ---------------------------------------------------------*/
/* Private functions prototype------------------------------------------------*/
/* Exported variables by reference--------------------------------------------*/
{{!
    Generation of handle for each function defined in HAL layer
    - save a variable to indicate if handle has been already created (only 1 handle by function)
~}}
{{assign 'hal_handle_dts_exist' 0~}}
{{#each @root.instances~}}
  {{~assign 'dts_ctxt' config~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' @root.dts_ctxt.info.layer~}}
{{#if (eq @root.current_layer 'HAL')}}
{{#if (eq @root.hal_handle_dts_exist 0)}}
static hal_dts_handle_t h{{@root.current_resource}};
{{assign 'hal_handle_dts_exist' 1~}}
{{/if}}
{{#with @root.dts_ctxt.system.exti}}
{{> EXTI fct='exti_get_variables' layer=@root.current_layer needs=needs}}
{{/with}}
{{/if}}{{! if (eq @root.current_layer 'HAL')~}}
{{/each}}

/* Exported function definition ----------------------------------------------*/
{{assign 'hal_handle_dts_exist' 0~}}
{{assign 'hal_handle_tim_exist' 0~}}
{{assign 'nvic_context' 'undefined'~}}
{{assign 'found_exti' false~}}
{{#each @root.instances}}
  {{~assign 'dts_ctxt' config~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' @root.dts_ctxt.info.layer~}}
/******************************************************************************/
/* Exported functions for {{@root.current_resource}} in {{@root.current_layer}} layer */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer 0 @root.current_function @root.from_where)~}}
  {{#with @root.dts_ctxt}}
{{!
    Generation of initialization function used in HAL
~}}
{{#if (eq @root.current_layer 'HAL')}}
hal_dts_handle_t *{{@root.fct_name}}_init(void)
{
  hal_dts_config_t        p_config;

{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='DTS'}}

  if (HAL_DTS_Init(&h{{@root.current_resource}}, HAL_{{uppercase @root.current_resource}}) != HAL_OK)
  {
    return NULL;
  }

{{#with basic}}
  p_config.reference_clock           = HAL_DTS_REFERENCE_CLOCK_{{reference_clock}};
{{#if (helper_common_object_has_property  this "quick_measurement")}}
  p_config.quick_measurement         = HAL_DTS_QUICK_MEASUREMENT_{{#if quick_measurement}}ENABLE{{else}}DISABLE{{/if}};
{{/if}}
{{#if (helper_common_object_has_property  this "high_speed_clock_division")}}
  p_config.high_speed_clock_division = 0x{{uppercase (dec2hex high_speed_clock_division)}};
{{/if}}

  if (HAL_DTS_SetConfig(&h{{@root.current_resource}}, &p_config) != HAL_OK)
  {
    return NULL;
  }

{{#each sensors}}
{{#if configure}}
{{#unless @root.found_sensor}}
  {{assign 'found_sensor' true~}}

  hal_dts_sensor_config_t p_sensor_config;
{{/unless}}

  p_sensor_config.trigger       = HAL_DTS_TRIGGER_{{helper_dts_rename_trigger trigger_source.source}};
  p_sensor_config.sampling_time = HAL_DTS_SAMPLING_TIME_{{sampling_time}}_CYCLE{{#if (not (eq sampling_time 1))}}S{{/if}};

  if (HAL_DTS_SetConfigSensor(&h{{@root.current_resource}}, HAL_DTS_SENSOR_{{add @index 1}}, &p_sensor_config) != HAL_OK)
  {
    return NULL;
  }

{{#if configure_sensor_thresholds}}
  if (HAL_DTS_SetSensorThresholds(&h{{@root.current_resource}}, HAL_DTS_SENSOR_{{add @index 1}}, {{sensor_high_threshold}}, {{sensor_low_threshold}}) != HAL_OK)
  {
    return NULL;
  }
{{/if}}
{{/if}}
{{/each}}
{{/with}}
{{#with system.exti}}
  /* DTS EXTI Configuration (wake up system from low power mode) ***************************************************/
{{> EXTI fct='exti_get_init' layer=@root.current_layer needs=needs found_exti=@root.found_exti}}
{{assign 'found_exti' true~}}
{{/with}}
{{#if system.nvic.enable_interruption}}
  /* DTS NVIC Configuration ****************************************************************************************/
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context system.nvic.nvic_config.needs @root.current_resource system.nvic.irq_handler_generation)~}}
{{#> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.nvic_config.needs}}
#warning "Partial CORTEX is not present"
{{/CORTEX}}
{{/if}}

  return &h{{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
  /* De-initialize the DTS */
  HAL_DTS_DeInit(&h{{@root.current_resource}});

{{#if system.nvic.enable_interruption}}
  /* Disable the DTS interrupt request */
{{#> CORTEX fct='deinit' layer=@root.current_layer needs=system.nvic_config.needs~}}
#warning "Partial CORTEX is not present"
{{/CORTEX}}

{{/if}}
{{#with system.exti}}
  /* Disable the DTS wake-up EXTI line */
{{> EXTI fct='exti_get_deinit' layer=@root.current_layer needs=needs}}

{{/with}}
{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='kernel_clock_deinit' hw_resource=@root.current_resource}}
}

{{/if}}{{! eq @root.current_layer 'HAL'}}
{{#if (eq @root.current_layer 'HAL')}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined)~}}
{{!
    Generation of getHandle functions used in HAL
~}}
hal_dts_handle_t *{{@root.fct_name}}_gethandle(void)
{
  return &h{{@root.current_resource}};
}
