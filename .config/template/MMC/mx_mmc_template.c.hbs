~}}
{{#if (eq @root.current_layer 'HAL')}}
hal_mmc_handle_t *{{@root.fct_name}}_init(void)
{
  hal_mmc_config_t mmc_config;
 {{#with additional}}
 {{#if (eq use_delay_block true)}}
 {{#if (eq delay_block.calculate_max_output_clock_phase true)}}
  uint32_t max_clock_phase;
 {{/if~}}{{~!delay_block.calculate_max_output_clock_phase~}}
 {{/if~}}{{~!use_delay_block~}}
 {{/with~}}{{~!additional}}
{{#if (eq @root.current_resource 'SDMMC1')}}
  if (HAL_MMC_Init(&h{{@root.current_resource}}, HAL_MMC_CARD_1) != HAL_OK)
  {
    return NULL;
  }
{{else}}
  if (HAL_MMC_Init(&h{{@root.current_resource}}, HAL_MMC_CARD_2) != HAL_OK)
  {
    return NULL;
  }
{{/if}}{{~!root.current_resource}}
  /* MMC GPIO Configuration **************************************************/
{{> GPIO_HAL fct='init_resource' resource=@root.current_resource return_if_failed='NULL' init_model=@root.codegen_ctxt.init_model fct_name=@root.fct_name}}
{{> RCC fct='generate_kernel_clock' hw_resource=@root.current_resource sw_resource='MMC'}}
{{> RCC fct='generate_peripheral_clock_activation' hw_resource=@root.current_resource}}
{{#with basic}}
  mmc_config.clk_cfg.clk_edge       = {{#if (eq clock_config.clk_edge true)}}HAL_MMC_CLOCK_EDGE_RISING{{else}}HAL_MMC_CLOCK_EDGE_FALLING{{/if}};
  mmc_config.clk_cfg.clk_power_save = {{#if (eq clock_config.clk_power_save true)}}HAL_MMC_CLOCK_POWER_SAVE_ENABLE{{else}}HAL_MMC_CLOCK_POWER_SAVE_DISABLE{{/if}};
  mmc_config.bus_wide               = {{#if (eq bus_wide 0)}}HAL_MMC_BUS_WIDE_1BIT{{else if (eq bus_wide 1)}}HAL_MMC_BUS_WIDE_4BIT{{else}}HAL_MMC_BUS_WIDE_8BIT{{/if}};
  mmc_config.hw_flow_ctrl           = {{#if (eq hw_flow_ctrl true)}}HAL_MMC_HARDWARE_FLOW_CONTROL_ENABLE{{else}}HAL_MMC_HARDWARE_FLOW_CONTROL_DISABLE{{/if}};
  {{#if (eq clock_config.auto_detection_frequency.detection_frequency false)}}
  mmc_config.clk_cfg.clk_hz         = {{clock_config.auto_detection_frequency.clock_frequency}};
  {{/if~}}{{~!auto_detection_frequency}}
  mmc_config.data_timeout_cycle     = {{#if (eq default_timeout true)}}HAL_MMC_DATA_MAX_TIMEOUT{{else}}{{timeout_config.data_timeout_cycle}}{{/if}};
  mmc_config.stop_xfer_timeout_ms   = {{#if (eq default_timeout true)}}HAL_MMC_STOP_XFER_MAX_TIMEOUT{{else}}{{timeout_config.stop_xfer_timeout_ms}}{{/if}};
  mmc_config.erase_timeout_ms       = {{#if (eq default_timeout true)}}HAL_MMC_ERASE_MAX_TIMEOUT{{else}}{{timeout_config.erase_timeout_ms}}{{/if}};
  {{assign 'found_SetConfig' true~}}
  if (HAL_MMC_SetConfig(&h{{@root.current_resource}}, &mmc_config) != HAL_OK)
  {
    return NULL;
  }
  {{/with~}}{{~!basic~}}
  {{#with additional~}}
  {{#if (eq use_delay_block true)~}}
  {{#if (eq delay_block.calculate_max_output_clock_phase true)~}}

  if (HAL_MMC_CalculateDlybMaxClockPhase(&h{{@root.current_resource}}, &max_clock_phase) != HAL_OK)
  {
    return NULL;
  }

  if (HAL_MMC_SetConfigDlybDelay(&h{{@root.current_resource}}, max_clock_phase) != HAL_OK)
  {
    return NULL;
  }
  {{else~}}

  if (HAL_MMC_SetConfigDlybDelay(&h{{@root.current_resource}}, {{delay_block.clock_phase}}) != HAL_OK)
  {
    return NULL;
  }
{{/if~}}{{~!delay_block.calculate_max_output_clock_phase~}}
{{/if~}}{{~!use_delay_block~}}
{{#if (eq threshold 0)~}}
  if (HAL_MMC_SetFifoThreshold(&h{{@root.current_resource}},  HAL_MMC_FIFO_THRESHOLD_NOT_USED) != HAL_OK)
  {
    return NULL;
  }
  {{else}}
 {{#if  threshold~}}
  if (HAL_MMC_SetFifoThreshold(&h{{@root.current_resource}},  HAL_MMC_FIFO_THRESHOLD_SIZE_{{threshold}}Byte) != HAL_OK)
  {
    return NULL;
  }
{{/if}}{{!threshold exist~}}
{{/if}}{{!threshold~}}
{{/with~}}{{~!additional~}}
{{#if (eq system.nvic_settings.irq_handler_generation false)~}}
{{~assign 'nvic_generate_handler' false~}}
{{/if~}}
{{#if (and system.nvic.enable_interruption (eq system.nvic.enable_interruption true))}}
  /* Enable the interruption for MMC */
{{assign 'nvic_context' (helper_cortex_nvic_concatenate_irq_context @root.nvic_context system.nvic.irq_config.needs @root.current_resource system.nvic.irq_handler_generation)~}}
{{> CORTEX fct='init' layer=@root.current_layer needs=system.nvic.irq_config.needs}}
{{/if}}
  return &h{{@root.current_resource}};
}

void {{@root.fct_name}}_deinit(void)
{
{{#if (and system.nvic.enable_interruption (eq system.nvic.enable_interruption true))}}
  /* Disable the interuption for MMC */
{{> CORTEX fct='deinit' layer=@root.current_layer needs=system.nvic.irq_config.needs}}
{{/if}}

  (void)HAL_MMC_DeInit(&h{{@root.current_resource}});

{{> RCC fct='generate_peripheral_clock_reset' hw_resource=@root.current_resource}}
{{> RCC fct='generate_peripheral_clock_deactivation' hw_resource=@root.current_resource}}

{{> GPIO_HAL fct='deinit_resource' resource=@root.current_resource}}
}

