/* Define to prevent recursive inclusion -------------------------------------*/
#ifndef MX_{{resource}}_H
#define MX_{{resource}}_H

#ifdef __cplusplus
extern "C" {
#endif /* __cplusplus */

/* Includes ------------------------------------------------------------------*/
{{assign 'include_mx_def' false~}}
{{#each @root.instances~}}
  {{~assign 'sdio_cxt' config~}}
  {{~assign 'current_resource' current_resource~}}
  {{~assign 'current_layer' @root.sdio_cxt.info.layer~}}
  {{#with @root.sdio_cxt.security_privilege}}
    {{#unless @root.include_mx_def}}
      {{~assign 'include_mx_def' true~}}
#include "mx_def.h"
    {{/unless}}
  {{/with}}
{{#unless @root.include_mx_def}}
{{#if (gt @root.codegen_ctxt.init_model 0)}}
#include "mx_def.h"
{{/if}}
{{/unless}}
{{/each}}
#include "stm32_hal.h"

/* Exported types ------------------------------------------------------------*/
/* Exported constants --------------------------------------------------------*/
{{helper_gpio_generate_aliases @root.pinoutAPI @root.current_resource @root.current_layer}}

/* Exported macro ------------------------------------------------------------*/
/* Exported variables --------------------------------------------------------*/
/* Exported functions ------------------------------------------------------- */
{{assign 'current_index' 0~}}
{{#each instances}}
{{assign 'sdio_cxt' config~}}
{{assign 'current_resource' current_resource~}}
{{assign 'current_layer' @root.sdio_cxt.info.layer~}}
/******************************************************************************/
/* Exported functions for SDIO in {{@root.current_layer}} layer */
/******************************************************************************/
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer @root.current_index 'SDIO')~}}
{{assign 'current_index' (add @root.current_index 1)~}}
/**
  * @brief {{@root.fct_name}} init function
  * This function configures the hardware resources used in this example
  * @retval pointer to handle or NULL in case of failure
  */
{{#if (eq @root.current_layer 'HAL')}}
hal_sdio_handle_t *{{@root.fct_name}}_init(void);
{{/if}}

/**
  * @brief  De-initialize {{lowercase @root.current_resource}} instance and return it.
  */
void {{@root.fct_name}}_deinit(void);
{{#if (eq @root.sdio_cxt.basic.sdio_identify_card false)}}

/**
  * @brief  Set Configuration of the SDIO card module.
  * @retval HAL_OK or HAL_ERROR in case of failure
  */
hal_status_t mx_sdio_set_config(hal_sdio_identify_card_t sdio_identify_card);
{{/if}}

{{/each}}
{{#with @root.sdio_cxt.security_privilege}}
{{#if (eq @root.getCurrentEngine.secure 'Non-secure')}}
/******************************************************************************/
/*                       Privilege attribute management                       */
/******************************************************************************/
/**
  * @brief Peripheral privilege configuration function
  * @retval system_status_t
  */
system_status_t {{@root.fct_name}}_config_privilege(void);
{{else}}
/******************************************************************************/
/*               Security and privilege attributes management                 */
/******************************************************************************/
/**
  * @brief Peripheral security and privilege configuration function
  * @retval system_status_t
  */
system_status_t {{@root.fct_name}}_config_security_privilege(void);
{{/if}}
{{/with}}
{{#if (eq @root.current_layer 'HAL')}}
{{assign 'fct_name' (helper_common_get_generated_function_name @root.current_resource @root.current_layer undefined 'SDIO')~}}
/**
