{{#if (eq basic.sdio_identify_card false)~}}
hal_status_t mx_sdio_set_config(hal_sdio_identify_card_t sdio_identify_card)
{
  hal_sdio_config_t sdio_config;
{{#if (eq additional.use_delay_block true)}}
  {{#if (eq additional.delay_block.calculate_max_output_clock_phase true)}}
  uint32_t max_clock_phase;
  {{/if}}{{!delay_block.calculate_max_output_clock_phase~}}
{{/if}}{{!use_delay_block}}
  sdio_config.clk_cfg.clk_edge       = {{#if (eq basic.clock_config.clk_edge true)}}HAL_SDIO_CLOCK_EDGE_RISING{{else}}HAL_SDIO_CLOCK_EDGE_FALLING{{/if}};
  sdio_config.clk_cfg.clk_power_save = {{#if (eq basic.clock_config.clk_power_save true)}}HAL_SDIO_CLOCK_POWER_SAVE_ENABLE{{else}}HAL_SDIO_CLOCK_POWER_SAVE_DISABLE{{/if}};
  sdio_config.bus_wide               = {{#if (eq basic.bus_wide 0)}}HAL_SDIO_BUS_WIDE_1BIT{{else if (eq basic.bus_wide 1)}}HAL_SDIO_BUS_WIDE_4BIT{{else}}HAL_SDIO_BUS_WIDE_8BIT{{/if}};
  sdio_config.hw_flow_ctrl           = {{#if (eq basic.hw_flow_ctrl true)}}HAL_SDIO_HARDWARE_FLOW_CONTROL_ENABLE{{else}}HAL_SDIO_HARDWARE_FLOW_CONTROL_DISABLE{{/if}};
  sdio_config.clk_cfg.clk_hz         = {{basic.clock_config.clock_frequency}};
  sdio_config.transceiver            = {{#if (eq basic.transceiver true)}}HAL_SDIO_TRANSCEIVER_PRESENT{{else}}HAL_SDIO_TRANSCEIVER_NOT_PRESENT{{/if}};
  sdio_config.data_timeout_cycle     = {{#if (eq basic.default_timeout true)}}HAL_SDIO_DATA_MAX_TIMEOUT{{else}}{{basic.timeout_config.data_timeout_cycle}}{{/if}};

  if (HAL_SDIO_SetConfig(&h{{@root.current_resource}}, &sdio_config, sdio_identify_card) != HAL_OK)
  {
    return HAL_ERROR;
  }
  {{#if (eq additional.use_delay_block true)~}}
    {{#if (eq additional.delay_block.calculate_max_output_clock_phase true)}}

  if (HAL_SDIO_CalculateDlybMaxClockPhase(&h{{@root.current_resource}}, &max_clock_phase) != HAL_OK)
  {
    return HAL_ERROR;
  }

  if (HAL_SDIO_SetConfigDlybDelay(&h{{@root.current_resource}}, max_clock_phase) != HAL_OK)
  {
    return HAL_ERROR;
  }
      {{else}}

  if (HAL_SDIO_SetConfigDlybDelay(&h{{@root.current_resource}}, {{additional.delay_block.clock_phase}}) != HAL_OK)
  {
    return HAL_ERROR;
  }
    {{/if}}{{!additional.delay_block.calculate_max_output_clock_phase~}}
    {{/if}}{{!additional.use_delay_block}}
    {{#if (eq additional.threshold "No")~}}
  if (HAL_SDIO_SetFifoThreshold(&h{{@root.current_resource}},  HAL_SDIO_FIFO_THRESHOLD_NOT_USED) != HAL_OK)
  {
    return HAL_ERROR;
  }
  {{else}}
{{#if  threshold~}}
  if (HAL_SDIO_SetFifoThreshold(&h{{@root.current_resource}},  HAL_SDIO_FIFO_THRESHOLD_SIZE_{{additional.threshold}}Byte) != HAL_OK)
  {
    return HAL_ERROR;
  }
  {{/if}}{{!~threshold is exist~}}
  {{/if}}{{!additional.threshold~~}}

  return HAL_OK;
}
    {{/if}}{{!basic.sdio_identify_card false~}}
  {{/if}}

